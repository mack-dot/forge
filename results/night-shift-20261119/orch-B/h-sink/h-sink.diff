+    assert ds[..1] == [ds[0]];
+    assert ds[..2] == [ds[0], ds[1]];
+    assert ds[..1][..0] == [];
+    assert ds[..2][..1] == [ds[0]];
+    assert ds[..3] == ds;
+    assert "ch_9"[3] != "ch_1"[3];
+    assert "rq_2"[3] != "rq_1"[3];
