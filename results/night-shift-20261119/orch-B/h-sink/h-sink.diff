+    {
+      if i < |c.outbox| {
+        assert c'.outbox[i] == c'.outbox[..|c.outbox|][i] == c.outbox[i];
+      }
+    }
+    forall i, j | 0 <= i < j < |c'.outbox|
+      ensures c'.outbox[i].requestId != c'.outbox[j].requestId
+    {
+      if j < |c.outbox| {
+        assert c'.outbox[i] == c'.outbox[..|c.outbox|][i] == c.outbox[i];
+        assert c'.outbox[j] == c'.outbox[..|c.outbox|][j] == c.outbox[j];
+      } else if i < |c.outbox| {
+        assert c'.outbox[i] == c'.outbox[..|c.outbox|][i] == c.outbox[i];
