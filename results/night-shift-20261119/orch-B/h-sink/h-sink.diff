+      ensures QOf(Run(Ch(1000), ds[..k]), ds[k]).Commit? ==> F.Authorizes(Run(Ch(1000), ds[..k]).charge, TransOf(ds[k].tok))
+    {
+      AuthorizesXIs(Run(Ch(1000), ds[..k]).charge, ds[k].tok);
