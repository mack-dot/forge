    assert MEval(MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MLit(IntL(0))), MBinOp(Eq, MVar("outputReason"), MLit(StrL([])))), MBinOp(Eq, MVar("outputCharge"), MLit(StrL([])))), MBinOp(Eq, MVar("outputRequest"), MLit(StrL([])))), MBinOp(Eq, MVar("intentCount"), MLit(IntL(0)))), env) == Rval(BoolV((((((outputAmount == 0) && (outputReason == "")) && (outputCharge == "")) && (outputRequest == "")) && (intentCount == 0))));
    LogicStep(Imp, MUnOp(Not, MVar("authorized")), MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MLit(IntL(0))), MBinOp(Eq, MVar("outputReason"), MLit(StrL([])))), MBinOp(Eq, MVar("outputCharge"), MLit(StrL([])))), MBinOp(Eq, MVar("outputRequest"), MLit(StrL([])))), MBinOp(Eq, MVar("intentCount"), MLit(IntL(0)))), env, (!authorized), (((((outputAmount == 0) && (outputReason == "")) && (outputCharge == "")) && (outputRequest == "")) && (intentCount == 0)));
    assert MEval(MBinOp(Imp, MUnOp(Not, MVar("authorized")), MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MLit(IntL(0))), MBinOp(Eq, MVar("outputReason"), MLit(StrL([])))), MBinOp(Eq, MVar("outputCharge"), MLit(StrL([])))), MBinOp(Eq, MVar("outputRequest"), MLit(StrL([])))), MBinOp(Eq, MVar("intentCount"), MLit(IntL(0))))), env) == Rval(BoolV(((!authorized) ==> (((((outputAmount == 0) && (outputReason == "")) && (outputCharge == "")) && (outputRequest == "")) && (intentCount == 0)))));
  }

