  // Clause 2, copied from the source text:
  //   authorized ==> outputAmount == amount && outputReason == reason && outputCharge == chargeId && outputRequest == requestId && intentCount == 1
  const Tree2: MExp := MBinOp(Imp, MVar("authorized"), MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MVar("amount")), MBinOp(Eq, MVar("outputReason"), MVar("reason"))), MBinOp(Eq, MVar("outputCharge"), MVar("chargeId"))), MBinOp(Eq, MVar("outputRequest"), MVar("requestId"))), MBinOp(Eq, MVar("intentCount"), MLit(IntL(1)))))

  predicate Source2(chargeId: string, requestId: string, original: int, remaining: int, enabled: bool, requestOpen: bool, candidate: bool, amount: int, reason: string, authorized: bool, outputAmount: int, outputReason: string, outputCharge: string, outputRequest: string, intentCount: int)
  {
    authorized ==>
      outputAmount == amount && outputReason == reason &&
      outputCharge == chargeId && outputRequest == requestId && intentCount == 1
  }

  lemma {:isolate_assertions} Agree2(chargeId: string, requestId: string, original: int, remaining: int, enabled: bool, requestOpen: bool, candidate: bool, amount: int, reason: string, authorized: bool, outputAmount: int, outputReason: string, outputCharge: string, outputRequest: string, intentCount: int)
    requires Bytes(chargeId) && Bytes(requestId) && Bytes(reason) && Bytes(outputReason) && Bytes(outputCharge) && Bytes(outputRequest)
    ensures MEval(Tree2, Env(chargeId, requestId, original, remaining, enabled, requestOpen, candidate, amount, reason, authorized, outputAmount, outputReason, outputCharge, outputRequest, intentCount)) == Rval(BoolV(Source2(chargeId, requestId, original, remaining, enabled, requestOpen, candidate, amount, reason, authorized, outputAmount, outputReason, outputCharge, outputRequest, intentCount)))
  {
    var env := Env(chargeId, requestId, original, remaining, enabled, requestOpen, candidate, amount, reason, authorized, outputAmount, outputReason, outputCharge, outputRequest, intentCount);
    Literals();
    assert MEval(MVar("authorized"), env) == Rval(BoolV(authorized));
    assert MEval(MVar("outputAmount"), env) == Rval(IntV(outputAmount));
    assert MEval(MVar("amount"), env) == Rval(IntV(amount));
    EqStep(Eq, MVar("outputAmount"), MVar("amount"), env, IntV(outputAmount), IntV(amount));
    assert MEval(MBinOp(Eq, MVar("outputAmount"), MVar("amount")), env) == Rval(BoolV((outputAmount == amount)));
    assert MEval(MVar("outputReason"), env) == Rval(StrV(B(outputReason)));
    assert MEval(MVar("reason"), env) == Rval(StrV(B(reason)));
    EqStep(Eq, MVar("outputReason"), MVar("reason"), env, StrV(B(outputReason)), StrV(B(reason)));
    BInj(outputReason, reason);
    assert MEval(MBinOp(Eq, MVar("outputReason"), MVar("reason")), env) == Rval(BoolV((outputReason == reason)));
    LogicStep(And, MBinOp(Eq, MVar("outputAmount"), MVar("amount")), MBinOp(Eq, MVar("outputReason"), MVar("reason")), env, (outputAmount == amount), (outputReason == reason));
    assert MEval(MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MVar("amount")), MBinOp(Eq, MVar("outputReason"), MVar("reason"))), env) == Rval(BoolV(((outputAmount == amount) && (outputReason == reason))));
    assert MEval(MVar("outputCharge"), env) == Rval(StrV(B(outputCharge)));
    assert MEval(MVar("chargeId"), env) == Rval(StrV(B(chargeId)));
    EqStep(Eq, MVar("outputCharge"), MVar("chargeId"), env, StrV(B(outputCharge)), StrV(B(chargeId)));
    BInj(outputCharge, chargeId);
    assert MEval(MBinOp(Eq, MVar("outputCharge"), MVar("chargeId")), env) == Rval(BoolV((outputCharge == chargeId)));
    LogicStep(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MVar("amount")), MBinOp(Eq, MVar("outputReason"), MVar("reason"))), MBinOp(Eq, MVar("outputCharge"), MVar("chargeId")), env, ((outputAmount == amount) && (outputReason == reason)), (outputCharge == chargeId));
    assert MEval(MBinOp(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MVar("amount")), MBinOp(Eq, MVar("outputReason"), MVar("reason"))), MBinOp(Eq, MVar("outputCharge"), MVar("chargeId"))), env) == Rval(BoolV((((outputAmount == amount) && (outputReason == reason)) && (outputCharge == chargeId))));
    assert MEval(MVar("outputRequest"), env) == Rval(StrV(B(outputRequest)));
    assert MEval(MVar("requestId"), env) == Rval(StrV(B(requestId)));
    EqStep(Eq, MVar("outputRequest"), MVar("requestId"), env, StrV(B(outputRequest)), StrV(B(requestId)));
    BInj(outputRequest, requestId);
    assert MEval(MBinOp(Eq, MVar("outputRequest"), MVar("requestId")), env) == Rval(BoolV((outputRequest == requestId)));
    LogicStep(And, MBinOp(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MVar("amount")), MBinOp(Eq, MVar("outputReason"), MVar("reason"))), MBinOp(Eq, MVar("outputCharge"), MVar("chargeId"))), MBinOp(Eq, MVar("outputRequest"), MVar("requestId")), env, (((outputAmount == amount) && (outputReason == reason)) && (outputCharge == chargeId)), (outputRequest == requestId));
    assert MEval(MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MVar("amount")), MBinOp(Eq, MVar("outputReason"), MVar("reason"))), MBinOp(Eq, MVar("outputCharge"), MVar("chargeId"))), MBinOp(Eq, MVar("outputRequest"), MVar("requestId"))), env) == Rval(BoolV(((((outputAmount == amount) && (outputReason == reason)) && (outputCharge == chargeId)) && (outputRequest == requestId))));
    assert MEval(MVar("intentCount"), env) == Rval(IntV(intentCount));
    assert MEval(MLit(IntL(1)), env) == Rval(IntV(1));
    EqStep(Eq, MVar("intentCount"), MLit(IntL(1)), env, IntV(intentCount), IntV(1));
    assert MEval(MBinOp(Eq, MVar("intentCount"), MLit(IntL(1))), env) == Rval(BoolV((intentCount == 1)));
    LogicStep(And, MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MVar("amount")), MBinOp(Eq, MVar("outputReason"), MVar("reason"))), MBinOp(Eq, MVar("outputCharge"), MVar("chargeId"))), MBinOp(Eq, MVar("outputRequest"), MVar("requestId"))), MBinOp(Eq, MVar("intentCount"), MLit(IntL(1))), env, ((((outputAmount == amount) && (outputReason == reason)) && (outputCharge == chargeId)) && (outputRequest == requestId)), (intentCount == 1));
    assert MEval(MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(And, MBinOp(Eq, MVar("outputAmount"), MVar("amount")), MBinOp(Eq, MVar("outputReason"), MVar("reason"))), MBinOp(Eq, MVar("outputCharge"), MVar("chargeId"))), MBinOp(Eq, MVar("outputRequest"), MVar("requestId"))), MBinOp(Eq, MVar("intentCount"), MLit(IntL(1)))), env) == Rval(BoolV((((((outputAmount == amount) && (outputReason == reason)) && (outputCharge == chargeId)) && (outputRequest == requestId)) && (intentCount == 1))));
