// Night shift 2026-11-19, Orchestrator B, task b-export-bridge. A DRAFT. NOT gate evidence. Dafny model only.
// G2: the independent reading of the export (gen/ExportedContract.dfy, generated by gen_exported.py from the
// export bytes, SHA-256 58154ddf...dd0d) is EQUAL to FlatContract, for ALL inputs and outputs (no byte-string or
// integer-range side condition). It also agrees with the stored mirror of the HOL evaluator (mirror/Mirror.dfy,
// byte-equal copy of drafts/export-semantics/Mirror.dfy) on byte strings, and the two readers' trees are equal.
// No assume, no axiom, no bodiless lemma in this file.
include "gen/ExportedContract.dfy"
include "gen/ReaderTrees.dfy"

module ExportBridge {
  import opened SliceTheorem
  import L = LinkedRefund
  import opened ExportedGen
  import HM = HolMirror
  import RT = ReaderTreesGen

  // G2 main statement. Holds for every x and o: Dafny string, Dafny int (unbounded), Dafny bool.
  lemma ExportedIffFlat(x: FlatIn, o: L.FlatTuple)
    ensures ExportedContract(x, o) <==> FlatContract(x, o)
  {
  }

  // Second reader: my parser's trees are the SAME terms as the trees gen_mirror.py stored in Mirror.dfy.
  lemma ReaderTreesAreMirrorTrees()
    ensures RT.Tree1 == HM.Tree1 && RT.Tree2 == HM.Tree2 && RT.Tree3 == HM.Tree3
  {
  }

  // Clause by clause, my Dafny reading equals the mirror's copy of the source text.
  lemma ClausesAreMirrorSources(x: FlatIn, o: L.FlatTuple)
    ensures ExportedClause1(x, o) == HM.Source1(x.chargeB, x.requestB, x.original, x.remaining, x.enabled,
      x.requestOpen, x.candidate, x.amount, x.reasonB, o.0, o.1, o.2, o.3, o.4, o.5)
    ensures ExportedClause2(x, o) == HM.Source2(x.chargeB, x.requestB, x.original, x.remaining, x.enabled,
      x.requestOpen, x.candidate, x.amount, x.reasonB, o.0, o.1, o.2, o.3, o.4, o.5)
    ensures ExportedClause3(x, o) == HM.Source3(x.chargeB, x.requestB, x.original, x.remaining, x.enabled,
      x.requestOpen, x.candidate, x.amount, x.reasonB, o.0, o.1, o.2, o.3, o.4, o.5)
  {
  }

  predicate OutBytes(o: L.FlatTuple)
  {
    HM.Bytes(o.2) && HM.Bytes(o.3) && HM.Bytes(o.4)
  }

  function MEnv(x: FlatIn, o: L.FlatTuple): map<string, HM.MValue>
  {
    HM.Env(x.chargeB, x.requestB, x.original, x.remaining, x.enabled, x.requestOpen, x.candidate, x.amount,
           x.reasonB, o.0, o.1, o.2, o.3, o.4, o.5)
  }

  // Agreement with the MIRROR of the HOL evaluator (evaluate_exp, a Dafny copy; NOT HOL) on byte strings:
  // the three exported trees evaluate to BoolV(true) exactly when ExportedContract holds.
  lemma ExportedIffMirror(x: FlatIn, o: L.FlatTuple)
    requires HM.Bytes(x.chargeB) && HM.Bytes(x.requestB) && HM.Bytes(x.reasonB) && OutBytes(o)
    ensures ExportedContract(x, o) <==>
      (HM.MEval(RT.Tree1, MEnv(x, o)) == HM.Rval(HM.BoolV(true)) &&
       HM.MEval(RT.Tree2, MEnv(x, o)) == HM.Rval(HM.BoolV(true)) &&
       HM.MEval(RT.Tree3, MEnv(x, o)) == HM.Rval(HM.BoolV(true)))
  {
    ReaderTreesAreMirrorTrees();
    ClausesAreMirrorSources(x, o);
    HM.Agree1(x.chargeB, x.requestB, x.original, x.remaining, x.enabled, x.requestOpen, x.candidate, x.amount,
              x.reasonB, o.0, o.1, o.2, o.3, o.4, o.5);
    HM.Agree2(x.chargeB, x.requestB, x.original, x.remaining, x.enabled, x.requestOpen, x.candidate, x.amount,
              x.reasonB, o.0, o.1, o.2, o.3, o.4, o.5);
    HM.Agree3(x.chargeB, x.requestB, x.original, x.remaining, x.enabled, x.requestOpen, x.candidate, x.amount,
              x.reasonB, o.0, o.1, o.2, o.3, o.4, o.5);
  }

  // ---- controls inside the proof file (each is a fact, not an assumption) ----
  // Zero amount is authorized (spec/refund/protocol.md): a tuple with ok = true and amount 0 meets the contract.
  lemma ZeroAmountAllowed()
    ensures ExportedContract(FlatIn("ch_1", "rq_0", 100, 60, true, true, true, 0, "duplicate_charge"),
                             (true, 0, "duplicate_charge", "ch_1", "rq_0", 1))
  {
  }

  // The HOL witness C9 (exported_contract_witnesses), read on the Dafny side: the same named inputs give the same
  // tuple, and the tuple with charge and request SWAPPED in the outputs does NOT meet the contract.
  lemma HolWitnessC9()
    ensures ExportedContract(FlatIn("ch_1", "rq_1", 100, 60, true, true, true, 40, "duplicate_charge"),
                             (true, 40, "duplicate_charge", "ch_1", "rq_1", 1))
    ensures !ExportedContract(FlatIn("ch_1", "rq_1", 100, 60, true, true, true, 40, "duplicate_charge"),
                              (true, 40, "duplicate_charge", "rq_1", "ch_1", 1))
    ensures ExportedContract(FlatIn("ch_1", "rq_1", 100, 60, true, true, true, 61, "duplicate_charge"),
                             (false, 0, "", "", "", 0))
  {
  }

  // Reject-all is not a model of the contract: on an eligible input the all-false tuple fails clause 1.
  lemma RejectAllFails()
    ensures !ExportedContract(FlatIn("ch_1", "rq_1", 100, 60, true, true, true, 40, "duplicate_charge"),
                              (false, 0, "", "", "", 0))
  {
  }
}
