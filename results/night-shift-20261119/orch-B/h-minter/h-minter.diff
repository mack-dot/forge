index 00000000..fa3bebbe
--- /dev/null
+++ b/tests/refund-finality/regress/m_retry_returns_same_token.ts
@@ -0,0 +1,25 @@
+// Regression (retry safety). Part A (CONTROL; it also passes on the earlier issuer): the same request twice gives a
+// byte-identical token; it commits once; the second commit is "replayed". Part B (the regression): a crashed client
+// retries request rq_a AFTER another client minted rq_b on the same pre-state; both mints answer, the retry is
+// byte-identical, and rq_b commits. FAILS on the earlier issuer rule (rq_b was refused: key = pre-state hash).
+// Usage and exit codes: m_lib.ts.
+import { argv, guard, verdict, world } from "./m_lib";
+guard((async () => {
+  const { root, core } = argv();
+  const S0 = { chargeId: "ch_mr", original: "1000", remaining: "1000", refundEnabled: true };
+  const w = await world(root, core, S0);
+  // Part A
+  const a1 = await w.mint(S0, "rq_r1", "100"), a2 = await w.mint(S0, "rq_r1", "100");
+  const sameA = a1.ok && a2.ok && a1.text === a2.text;
+  const ca1 = w.commit(a1), ca2 = w.commit(a2);
+  // Part B, on the new stored state
+  const S1 = a1.post;
+  const x1 = await w.mint(S1, "rq_a", "50");                     // client A crashes before it commits
+  const y = await w.mint(S1, "rq_b", "70");                      // client B
+  const x2 = await w.mint(S1, "rq_a", "50");                     // client A retries
+  const sameB = x1.ok && x2.ok && x1.text === x2.text;
+  const cy = w.commit(y);
+  w.stop();
+  verdict(sameA && ca1 === "committed" && ca2 === "replayed" && y.ok && sameB && cy === "committed",
+    { partA: { identical: sameA, first: ca1, second: ca2 }, partB: { retryIdentical: sameB, other: y.ok ? cy : "mint refused: " + y.reason } });
+})());
diff --git a/tests/refund-finality/regress/m_same_request_different_candidate_refused.ts b/tests/refund-finality/regress/m_same_request_different_candidate_refused.ts
new file mode 100644
index 00000000..5a0fb0a0
--- /dev/null
+++ b/tests/refund-finality/regress/m_same_request_different_candidate_refused.ts
@@ -0,0 +1,19 @@
+// Regression (issuer-side idempotency per request). The issuer never signs two DIFFERENT transitions for one
+// (charge id, request id). rq_x is minted for 100 on S0 (not committed); rq_y commits; then rq_x is asked for 30 on
+// the NEW pre-state S1: refused. Control: a fresh id on S1 issues and commits. FAILS on the earlier issuer rule
+// (its key is the pre-state hash, so another pre-state was signed again) and with no rule ("off").
+// Usage and exit codes: m_lib.ts.
+import { argv, guard, verdict, world } from "./m_lib";
+guard((async () => {
+  const { root, core } = argv();
+  const S0 = { chargeId: "ch_md", original: "1000", remaining: "1000", refundEnabled: true };
+  const w = await world(root, core, S0);
+  const first = await w.mint(S0, "rq_x", "100");
+  const y = await w.mint(S0, "rq_y", "200"); const cy = w.commit(y);
+  const second = await w.mint(y.post, "rq_x", "30");
+  const fresh = await w.mint(y.post, "rq_z", "30"); const cf = w.commit(fresh);
+  w.stop();
+  // On the earlier rule rq_y is refused (frozen pre-state); then y.post is not the stored state; we report it as is.
+  verdict(first.ok && cy === "committed" && !second.ok && cf === "committed",
+    { first: first.ok, otherRequest: cy, sameIdOtherCandidate: second.ok ? "SIGNED" : "refused: " + second.reason, freshId: cf });
+})());
diff --git a/tests/refund-finality/regress/m_zero_amount_does_not_freeze.ts b/tests/refund-finality/regress/m_zero_amount_does_not_freeze.ts
