+    durable(outside, JSON.stringify({ committed: h }));   // the host promotes the served head (committed or pending)
+    if (!r.ok) failures++;
+    if (!r.ok || rounds.length < 8 || jc !== "none") rounds.push(r);
+    if (!r.ok) break;
+  }
