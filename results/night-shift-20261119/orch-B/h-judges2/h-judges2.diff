+  const all = [...f1.effects, ...f2.effects];
+  return { rq1: effectsOf(all, "rq_1"), rq2: effectsOf(all, "rq_2"), text: `c1=${c1},${w},rq2=${effectsOf(all, "rq_2")}${f2.error ? ",err=" + f2.error.slice(0, 40) : ""}` };
+}
