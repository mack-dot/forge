+      const got = readSync(fd, buf, n, buf.length - n, null);
+      if (got === 0) break;
+      n += got;
+      if (n > MAX_KEY_FILE_BYTES) throw new Error("key file: larger than " + MAX_KEY_FILE_BYTES + " bytes");
+    }
