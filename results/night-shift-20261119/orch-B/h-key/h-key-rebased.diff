+    return { privateKey, publicKeyPem: publicKey.export({ type: "spki", format: "pem" }) as string, keyId: keyIdOf(publicKey) };
+  } finally {
+    if (buf !== null) buf.fill(0);
+    closeSync(fd);
+  }
+}
