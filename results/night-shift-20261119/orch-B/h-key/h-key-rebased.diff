+  verdict(r.rq1 === "committed" && r.minter2.ready && r.minter2.samePublicKey && r.minter2.sameKeyId && r.rq2 === "committed" &&
+    r.rq3AfterSinkReopen === "committed" && r.rows.join() === "rq_1,rq_2,rq_3" && r.pinUnchanged, r);
+})());
