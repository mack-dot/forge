diff --git a/tests/refund-finality/regress/kf_allowlist_config.ts b/tests/refund-finality/regress/kf_allowlist_config.ts
new file mode 100644
index 00000000..ac689f83
--- /dev/null
+++ b/tests/refund-finality/regress/kf_allowlist_config.ts
@@ -0,0 +1,51 @@
+// Regression for OWNER DECISION D-1 (c), task h-key: the allowlist configuration rules (core/store.ts keyRingOf).
+// (1) the OLD single pin {publicKeyPem} = an allowlist of ONE active key: a store made with it opens with
+//     {issuerKeys: [A active]} and with {publicKeyPem: A, issuerKeys: [A active]} (the same h_0: entry 0 = genesis key),
+//     and a new token of A commits under the list form (CONTROL).
+// (2) refused configurations (sink AND dispatcher refuse to start): a wrong keyId for a key; the same key twice; a retired
+//     entry without verifyUpToSeq; an active entry WITH verifyUpToSeq; an unknown status; an empty list; publicKeyPem
+//     that is not entry 0; a non-Ed25519 key; neither field.
+// (3) the genesis is bound to entry 0: a list with ANOTHER key first does not open the store (h_0 differs).
+// SAFE = exit 0. On f67c5c16: no allowlist -> FAIL.
+import { generateKeyPairSync } from "node:crypto";
+import { join } from "node:path";
+import { active, argv, guard, memKey, retired, sinkKit, verdict } from "./kf_lib";
+
+guard((() => {
+  const { root } = argv();
+  const K = sinkKit(root), A = memKey(), B = memKey();
+  const db = join(K.dir(), "s.sqlite"), r: any = {};
+  const s = K.open(db, { publicKeyPem: A.publicKeyPem });
+  if (typeof s === "string") verdict(false, { setup: s });
+  s.init(K.S0); r.legacyCommit = s.commit(K.tok(K.S0, "rq_1", "100", A)).status; s.close();
+  const s2 = K.open(db, { issuerKeys: [active(A)] });
+  r.listForm = typeof s2 === "string" ? s2 : s2.commit(K.tok({ ...K.S0, remaining: "900" }, "rq_2", "0", A)).status;
+  if (typeof s2 !== "string") s2.close();
+  const s3 = K.open(db, { publicKeyPem: A.publicKeyPem, issuerKeys: [active(A), retired(B, 0)] });
+  r.bothFieldsConsistent = typeof s3 === "string" ? s3 : "STARTED"; if (typeof s3 !== "string") s3.close();
+  const s4 = K.open(db, { issuerKeys: [active(B), active(A)] });
+  r.otherGenesisKeyFirst = typeof s4 === "string" ? "refused" : "STARTED"; if (typeof s4 !== "string") s4.close();
+  const rsa = generateKeyPairSync("rsa", { modulusLength: 1024 }).publicKey.export({ type: "spki", format: "pem" }) as string;
+  const bad: Record<string, any> = {
+    wrongKeyId: { issuerKeys: [{ ...active(A), keyId: B.keyId }] },
+    duplicate: { issuerKeys: [active(A), active(A)] },
+    retiredWithoutBound: { issuerKeys: [active(A), { keyId: B.keyId, publicKeyPem: B.publicKeyPem, status: "retired" }] },
+    activeWithBound: { issuerKeys: [{ ...active(A), verifyUpToSeq: 3 }] },
+    unknownStatus: { issuerKeys: [{ ...active(A), status: "revoked" }] },
+    emptyList: { issuerKeys: [] },
+    pemNotEntry0: { publicKeyPem: B.publicKeyPem, issuerKeys: [active(A), active(B)] },
+    notEd25519: { publicKeyPem: rsa },
+    neither: {},
+  };
+  r.refused = {};
+  let allRefused = true;
+  for (const [name, pin] of Object.entries(bad)) {
+    const fresh = join(K.dir(), name + ".sqlite"), x = K.open(fresh, pin);
+    if (typeof x !== "string") x.close();
+    const d = K.flush(fresh, join(K.dir(), name + ".jsonl"), pin, A.publicKeyPem);
+    const ok = typeof x === "string" && d.alarm !== undefined;
+    r.refused[name] = ok ? "sink and dispatcher refused" : "NOT REFUSED (sink " + (typeof x === "string" ? "refused" : "started") + ", dispatcher " + (d.alarm ? "refused" : "ran") + ")";
+    allRefused &&= ok;
+  }
+  verdict(r.legacyCommit === "committed" && r.listForm === "committed" && r.bothFieldsConsistent === "STARTED" && r.otherGenesisKeyFirst === "refused" && allRefused, r);
+})());
diff --git a/tests/refund-finality/regress/kf_fifo_dir_refused.ts b/tests/refund-finality/regress/kf_fifo_dir_refused.ts
new file mode 100644
index 00000000..63ab464c
--- /dev/null
+++ b/tests/refund-finality/regress/kf_fifo_dir_refused.ts
@@ -0,0 +1,33 @@
+// Regression for OWNER DECISION D-1 (b), task h-key: a FIFO or a DIRECTORY at the key path is refused, and the open does
+// not block on the FIFO (no writer ever opens it). keyfile.ts opens with O_RDONLY | O_NOFOLLOW | O_NONBLOCK: open(2) of
+// a FIFO for reading with O_NONBLOCK returns at once; fstat says "not a regular file". O_NONBLOCK is not cleared (Node
+// has no fcntl); it has no effect on read(2) of a regular file, the only kind that passes.
+// Each minter start has a 15 s limit: a start that blocks is a FAIL. CONTROL: a 0600 regular key file starts.
+// SAFE = exit 0. On f67c5c16: the minter starts (the path is not read as a key) -> FAIL.
+import { spawnSync } from "node:child_process";
+import { mkdirSync } from "node:fs";
+import { join } from "node:path";
+import { argv, guard, keyTempDir, load, makeKeyFile, startMinter, verdict } from "./kf_lib";
+
+guard((async () => {
+  const { root, core } = argv();
+  const { KF } = load(root);
+  const dir = keyTempDir(), fifo = join(dir, "fifo.pem"), sub = join(dir, "dir.pem");
+  const mk = spawnSync("/usr/bin/mkfifo", ["-m", "600", fifo]);
+  if (mk.status !== 0) verdict(false, { setup: "mkfifo failed" });
+  mkdirSync(sub, { mode: 0o700 });
+  const r: any = {};
+  for (const [name, path] of [["fifo", fifo], ["directory", sub]] as const) {
+    const t0 = Date.now(), m = await startMinter(root, core, [path], "on", 15000); m.stop();
+    r[name] = { ready: m.ready !== null, code: m.code, timedOut: m.timedOut, notRegular: /not a regular file/.test(m.stderr), ms: Date.now() - t0 > 14000 ? "LIMIT" : "under 14 s" };
+    if (KF !== null && typeof KF.loadSigningKey === "function") {
+      const t1 = Date.now(); let why = "";
+      try { KF.loadSigningKey(path); why = "ACCEPTED"; } catch (e) { why = String((e as Error).message); }
+      r[name].direct = { refused: /not a regular file/.test(why), quick: Date.now() - t1 < 2000 };
+    } else r[name].direct = "NOT AVAILABLE (no keyfile.ts)";
+  }
+  const k = makeKeyFile(), c = await startMinter(root, core, [k.path]); c.stop();
+  r.control = { ready: c.ready !== null && c.ready.keyId === k.keyId };
+  const ok = (x: any) => !x.ready && x.code === 2 && !x.timedOut && x.notRegular && typeof x.direct === "object" && x.direct.refused && x.direct.quick;
+  verdict(ok(r.fifo) && ok(r.directory) && r.control.ready, r);
+})());
diff --git a/tests/refund-finality/regress/kf_keyid_mismatch_refused.ts b/tests/refund-finality/regress/kf_keyid_mismatch_refused.ts
new file mode 100644
index 00000000..9a0baf23
--- /dev/null
+++ b/tests/refund-finality/regress/kf_keyid_mismatch_refused.ts
@@ -0,0 +1,33 @@
+// Regression for OWNER DECISION D-1 (c), task h-key: a token whose key_id names key A but whose signature is made by
+// key B is refused, also when BOTH keys are pinned and active, and a key id changed after signing is refused (the key
+// id is inside the signed bytes). Pin [A active, B active].
+// (1) keyId A, signed by B over the bytes with keyId A -> rejected.
+// (2) a valid token of B (keyId B), keyId field changed to A, signature kept -> rejected.
+// (3) a valid token of A (keyId A), keyId field changed to B, signature kept -> rejected.
+// (4) keyId A, signed by an UNPINNED key D -> rejected.
+// CONTROL: a valid token of A and one of B (amount 0) commit. SAFE = exit 0. On f67c5c16 -> FAIL.
+import { join } from "node:path";
+import { active, argv, guard, memKey, sinkKit, verdict } from "./kf_lib";
+
+guard((() => {
+  const { root } = argv();
+  const K = sinkKit(root), A = memKey(), B = memKey(), D = memKey();
+  const db = join(K.dir(), "s.sqlite");
+  const s = K.open(db, { issuerKeys: [active(A), active(B)] });
+  if (typeof s === "string") verdict(false, { setup: s });
+  s.init(K.S0);
+  const swapId = (text: string, keyId: string) => { const o = JSON.parse(text); o.keyId = keyId; return K.E.canon(o); };
+  const st = (x: any) => x.status + (x.reason ? ": " + x.reason : "");
+  const r: any = {
+    namesA_signedByB: st(s.commit(K.tok(K.S0, "rq_1", "100", B, A.keyId))),
+    tokenOfB_idChangedToA: st(s.commit(swapId(K.tok(K.S0, "rq_2", "100", B), A.keyId))),
+    tokenOfA_idChangedToB: st(s.commit(swapId(K.tok(K.S0, "rq_3", "100", A), B.keyId))),
+    namesA_signedByUnpinnedD: st(s.commit(K.tok(K.S0, "rq_4", "100", D, A.keyId))),
+  };
+  r.controlA = st(s.commit(K.tok(K.S0, "rq_a", "100", A)));
+  r.controlBzero = st(s.commit(K.tok({ ...K.S0, remaining: "900" }, "rq_b", "0", B)));
+  s.close();
+  r.rows = K.rows(db);
+  const neg = ["namesA_signedByB", "tokenOfB_idChangedToA", "tokenOfA_idChangedToB", "namesA_signedByUnpinnedD"].every(k => r[k].startsWith("rejected"));
+  verdict(neg && r.controlA === "committed" && r.controlBzero === "committed" && r.rows.join() === "rq_a,rq_b", r);
+})());
