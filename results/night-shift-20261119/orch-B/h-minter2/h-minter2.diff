+cd "$DIR"
+got=$(/usr/bin/shasum -a 256 MANIFEST.sha256 | cut -d' ' -f1)
+[ "$got" = "$PIN" ] || { echo "minter-launch.sh: refused: MANIFEST.sha256 does not have the pinned digest" >&2; exit 2; }
