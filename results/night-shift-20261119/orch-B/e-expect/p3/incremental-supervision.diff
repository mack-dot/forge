+STEP_SECONDS = 3600
+
+
+def bounded(command, **options):
+    """subprocess.run with a wall-clock bound. On expiry, kill the whole process group and return None."""
+    child = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             start_new_session=True, **options)
+    try:
+        stdout, stderr = child.communicate(timeout=STEP_SECONDS)
+    except subprocess.TimeoutExpired:
+        stdout = stderr = None
+    finally:
+        try:
+            os.killpg(child.pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+        child.wait()
+    if stdout is None:
+        return None
+    return subprocess.CompletedProcess(command, child.returncode, stdout, stderr)
+
+
+def limit_reached(command):
+    return Rejected('RESOURCE_LIMIT: ' + Path(str(command[0])).name + ' ' + ' '.join(str(c) for c in command[1:2])
+                    + ' reached the wall-clock bound of ' + str(STEP_SECONDS) + ' s; process group killed; no verdict')
+
