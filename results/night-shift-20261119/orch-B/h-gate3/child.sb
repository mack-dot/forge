(version 1)
(deny default)
(import "system.sb")
(allow process-exec (literal "/opt/homebrew/Cellar/node/24.3.0/bin/node"))
(allow file-read* (subpath "/opt/homebrew/Cellar/node/24.3.0") (subpath "/opt/homebrew/Cellar") (subpath "/opt/homebrew/opt") (subpath (param "D")))
(allow signal (target self))
(allow file-read-metadata)
(allow sysctl-read)
(allow file-read* (literal "/dev/urandom") (literal "/dev/random") (subpath "/opt/homebrew/etc/openssl@3"))
