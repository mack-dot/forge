{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "build_cmd": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "module",
            "binary",
            "container"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "kind",
        "sha256",
        "build_cmd"
      ],
      "type": "object"
    },
    "claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "spec_ref": {
          "minLength": 1,
          "type": "string"
        },
        "spec_sha": {
          "$ref": "#/$defs/sha256"
        },
        "statement_plain_english": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement_plain_english",
        "spec_ref",
        "spec_sha"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha": {
          "$ref": "#/$defs/sha256"
        },
        "assumptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "producer": {
          "minLength": 1,
          "type": "string"
        },
        "reproduce_cmd": {
          "minLength": 1,
          "type": "string"
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "tool": {
          "minLength": 1,
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "type": "string"
        },
        "trusted_base": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "artifact_sha",
        "method",
        "tool",
        "tool_version",
        "result",
        "assumptions",
        "trusted_base",
        "reproduce_cmd",
        "producer"
      ],
      "type": "object"
    },
    "manifest": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "method": {
      "enum": [
        "unit_tested",
        "property_tested",
        "tested_against_proved_model",
        "bounded_model_checked",
        "eval_measured",
        "runtime_monitored",
        "source_proof",
        "binary_proof",
        "kernel_checked_proof"
      ]
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tier": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "tier",
        "sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "trusted_inputs": {
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "minProperties": 1,
      "type": "object"
    }
  },
  "$id": "urn:forge:evidence:2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "end_to_end": {
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "format_version": {
          "const": 1
        },
        "source_manifest": {
          "$ref": "#/$defs/manifest"
        },
        "trusted_input_sha256": {
          "$ref": "#/$defs/trusted_inputs"
        },
        "verification_options": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "verified_obligations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "format_version",
        "end_to_end",
        "artifact",
        "source_manifest",
        "claims",
        "evidence",
        "trusted_input_sha256",
        "verification_options",
        "verified_obligations"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact": {
                "properties": {
                  "kind": {
                    "const": "source"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "source_manifest"
            ]
          }
        }
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "backend": {
          "minLength": 1,
          "type": "string"
        },
        "backend_details": {
          "type": "object"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "end_to_end": {
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "format_version": {
          "const": 2
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "source_manifest": {
          "$ref": "#/$defs/manifest"
        },
        "trusted_input_sha256": {
          "$ref": "#/$defs/trusted_inputs"
        }
      },
      "required": [
        "format_version",
        "end_to_end",
        "artifact",
        "claims",
        "evidence",
        "trusted_input_sha256",
        "schema_version",
        "backend",
        "policy",
        "backend_details"
      ],
      "type": "object"
    }
  ],
  "title": "Forge evidence bundle; structural validation only"
}
