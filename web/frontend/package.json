{
  "name": "discovery-one-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Discovery One web showcase: frontend (static export). It talks only to the API base URL.",
  "engines": {
    "node": "24.3.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "serve:out": "node test/serve-out.mjs",
    "test:double": "node test/test-double-api.mjs",
    "test:browser": "node test/browser-check.mjs"
  },
  "dependencies": {
    "framer-motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.65.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
