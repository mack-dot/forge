name: Forge independent binary proof replay
'on':
  workflow_dispatch: {}
permissions:
  contents: read
concurrency:
  group: forge-binary-proof-replay
  cancel-in-progress: false
jobs:
  proof:
    if: github.repository == 'mack-dot/forge' && github.ref == 'refs/heads/main' && github.run_attempt == 1
    runs-on: ubuntu-24.04
    timeout-minutes: 300
    env:
      FORGE_STAGE9_IMPLEMENTATION: 76b983ac279a80ab42bf15c7446ee997a2bcd9b25a003db829f7e8fb2d4b8cd9
    steps:
    - name: Checkout exact dispatched main commit
      uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
      with:
        ref: ${{ github.sha }}
        persist-credentials: false
    - name: Python 3.10.11 from a hash-checked archive
      run: |
        P="$RUNNER_TEMP/forge-python"
        A="$RUNNER_TEMP/python-3.10.11.tar.gz"
        curl -fsSL -o "$A" https://github.com/actions/python-versions/releases/download/3.10.11-11114431484/python-3.10.11-linux-24.04-x64.tar.gz
        echo "3d10b78a944ee1cf236bf09f3913d0db359d3e80954dbda6d55f447b34099bae  $A" | sha256sum -c
        mkdir -p "$P" && tar -xzf "$A" -C "$P"
        LD_LIBRARY_PATH="$P/lib" "$P/bin/python3" -I -m ensurepip --default-pip
        echo "$P/bin" >> "$GITHUB_PATH"
        echo "LD_LIBRARY_PATH=$P/lib" >> "$GITHUB_ENV"
    - name: Authenticate the checkout before any repository code
      run: |
        python3 -I -S -B -c 'import hashlib, json, sys
        lock = open("gate/provenance/implementation.lock", "rb").read()
        if hashlib.sha256(lock).hexdigest() != sys.argv[1]: sys.exit("IMPLEMENTATION_LOCK")
        boot = open("gate/provenance/bootstrap.py", "rb").read()
        if hashlib.sha256(boot).hexdigest() != json.loads(lock)["files"]["gate/provenance/bootstrap.py"]: sys.exit("BOOTSTRAP_BYTES")' "$FORGE_STAGE9_IMPLEMENTATION"
        python3 -I -S -B gate/provenance/bootstrap.py --implementation-sha256 "$FORGE_STAGE9_IMPLEMENTATION" --check
    - name: Record and reclaim disk on the disposable runner
      run: |
        df -B1 / && nproc && free -b
        sudo rm -rf /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup \
          /opt/hostedtoolcache/CodeQL /usr/share/swift /usr/local/share/powershell /usr/local/share/chromium
        docker image prune --all --force
        df -B1 /
    - name: Install pinned Docker and build Stage 7 prerequisites
      env:
        FORGE_STAGE7_ROOT: ${{ runner.temp }}/seed
      run: python3 -I -S -B gate/provenance/bootstrap.py --implementation-sha256 "$FORGE_STAGE9_IMPLEMENTATION"
        -- gate/provenance/hosted_setup.py
    - name: Record actual runner and Docker versions
      run: |
        docker version
        docker info
        uname -a
    - name: Run the existing independent binary proof without signing
      env:
        FORGE_STAGE7_ROOT: ${{ runner.temp }}/seed
      run: |
        python3 -I -S -B gate/provenance/bootstrap.py --implementation-sha256 "$FORGE_STAGE9_IMPLEMENTATION" --check
        python3 -I -S -B - <<'PYTHON'
        import json, os, pathlib, secrets, subprocess, sys
        sys.path.insert(0, str(pathlib.Path('gate/provenance').resolve()))
        from common import Records, clean_environment, context, digest, require, write
        import producer
        clean_environment()
        require(os.environ['GITHUB_REPOSITORY'] == 'mack-dot/forge', 'REPOSITORY')
        require(os.environ['GITHUB_EVENT_NAME'] == 'workflow_dispatch', 'MANUAL_EXECUTION')
        require(os.environ['GITHUB_REF'] == 'refs/heads/main', 'MAIN_ONLY')
        require(os.environ['GITHUB_RUN_ATTEMPT'] == '1', 'FRESH_RUN_ONLY')
        require(subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
                == os.environ['GITHUB_SHA'], 'EXACT_SOURCE')
        policy, lock, implementation = context(os.environ['FORGE_STAGE9_IMPLEMENTATION'])
        out = pathlib.Path('results/binary-proof-replay').resolve()
        out.mkdir(parents=True, exist_ok=False)
        records = Records(out / 'commands')
        # A proof receipt nonce. This is NOT a release request or controller approval.
        request = {'challenge': secrets.token_hex(32), 'expected_source_commit': os.environ['GITHUB_SHA']}
        write(out / 'execution-inputs.json', {'proof_nonce': request['challenge'],
              'source_commit': request['expected_source_commit'],
              'implementation_lock_sha256': os.environ['FORGE_STAGE9_IMPLEMENTATION'],
              'run_id': os.environ['GITHUB_RUN_ID'], 'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],
              'release_request': False, 'end_to_end': False})
        result = {'result': 'not_established', 'end_to_end': False,
                  'scope': 'Unchanged producer.replay and validate_receipt only; no release admission'}
        try:
            producer.replay(policy, lock, implementation, request, out, records)
            result.update(result='passed', proof_receipt_sha256=digest(out / 'proof/receipt.json'))
        except BaseException as error:
            result['failure'] = type(error).__name__ + ': ' + str(error)
            raise
        finally:
            write(out / 'result.json', result)
        PYTHON
    - name: Preserve proof output and all failures
      if: always()
      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
      with:
        name: forge-binary-proof-${{ github.run_id }}-${{ github.run_attempt }}
        path: |
          results/binary-proof-replay/
          results/stage9/producer-output/hosted-setup/
        include-hidden-files: true
        if-no-files-found: error
