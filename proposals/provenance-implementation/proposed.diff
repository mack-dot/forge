+name: Forge Stage 9 wrong signer control
+
+"on":
+  workflow_dispatch:
+    inputs:
+      request:
+        description: Exact original controller request JSON
+        required: true
+        type: string
+      implementation_sha256:
+        description: Separately approved implementation.lock SHA-256
+        required: true
+        type: string
+      producer_run_id:
+        description: Successful provenance run at the same exact source commit
+        required: true
+        type: string
+
+permissions:
+  contents: read
+  actions: read
+  id-token: write
+
+concurrency:
+  group: forge-stage9-wrong-signer
+  cancel-in-progress: false
+
+jobs:
+  negative:
+    if: github.repository == 'mack-dot/forge' && github.ref == 'refs/heads/main'
+    runs-on: [self-hosted, macOS, ARM64, forge-stage9]
+    env:
+      FORGE_STAGE9_REQUEST: ${{ inputs.request }}
+      FORGE_STAGE9_IMPLEMENTATION: ${{ inputs.implementation_sha256 }}
+      FORGE_STAGE9_PRODUCER_RUN: ${{ inputs.producer_run_id }}
+    steps:
+      - name: Checkout the exact dispatched main commit
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+      - name: Check pins and authenticate producer run metadata
+        run: python3 gate/provenance/preflight.py --implementation-sha256 "$FORGE_STAGE9_IMPLEMENTATION" --producer-run "$FORGE_STAGE9_PRODUCER_RUN"
+      - name: Retrieve the authenticated run's signed candidate
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
+        with:
+          name: forge-stage9-signed-${{ inputs.producer_run_id }}
+          path: results/stage9/producer-output/
+          run-id: ${{ inputs.producer_run_id }}
+          github-token: ${{ github.token }}
+      - name: Sign under this unauthorized workload identity only
+        run: python3 gate/provenance/producer.py --action negative-sign --implementation-sha256 "$FORGE_STAGE9_IMPLEMENTATION" --output results/stage9/producer-output
+      - name: Preserve authentic wrong-signer bundle and failures
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: forge-stage9-negative-${{ github.run_id }}
+          path: results/stage9/producer-output/
+          include-hidden-files: true
+          if-no-files-found: error
