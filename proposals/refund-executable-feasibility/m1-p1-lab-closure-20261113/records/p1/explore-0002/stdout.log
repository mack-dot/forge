ARM8_LINK compile_cake_arm8_thm :: ⊢ compile_cake_arm8 c p =
  SOME (bytes,bytes_len,bm,bm_len,ffi_names,shmem_len,syms,conf_str) ⇒
  ∃c1.
    compile arm8_config c p = SOME (bytes,bm,c1) ∧
    ffi_names = ffinames_to_string_list (the [] c1.lab_conf.ffi_names) ∧
    syms = c1.symbols ∧ LENGTH bytes = bytes_len ∧ LENGTH 
PUBLISHED labProps.get_code_labels_def
⊢ ∀code.
    get_code_labels code = BIGUNION (IMAGE sec_get_code_labels (set code))
END
PUBLISHED labProps.sec_get_code_labels_def
⊢ ∀n1 lines v0.
    sec_get_code_labels (Section n1 lines v0) =
    (n1,0) INSERT
    IMAGE (λn2. (n1,n2)) (BIGUNION (IMAGE line_get_code_labels (set lines)))
END
PUBLISHED labProps.get_labels_def
⊢ ∀code. get_labels code = BIGUNION (IMAGE sec_get_labels (set code))
END
PUBLISHED stack_to_lab.compile_def
⊢ ∀aw stack_conf data_conf max_heap sp offset prog.
    compile aw stack_conf data_conf max_heap sp offset prog =
    (let
       prog = compile prog;
       prog = compile aw data_conf prog;
       prog =
         compile aw stack_conf.jump offset (is_gen_gc data_conf.gc_kind)
           max_heap sp InitGlobals_location prog;
       prog = compile stack_conf.reg_names prog
     in
       MAP prog_to_section prog)
END
PUBLISHED stack_to_lab.prog_to_section_def
⊢ ∀n p md.
    prog_to_section (n,p,md) =
    (let
       (lines,_0,m) = flatten T p n (next_lab p 2) [] []
     in
       Section n
         (append
            (Append lines (List [Label n (if is_Seq p then m else 1) 0]))) md)
END
PUBLISHED word_to_stack.compile_def
⊢ ∀asm_conf perf progs.
    compile asm_conf perf progs =
    (let
       k = asm_conf.reg_count − (5 + LENGTH asm_conf.avoid_regs);
       init_bitmaps = if perf then (List [16],1) else (List [4],1);
       (progs,fs,bitmaps) =
         compile_word_to_stack asm_conf perf k progs init_bitmaps;
       sfs = fromAList (MAP (λ((i,_0,_1),n). (i,n)) (ZIP (progs,fs)))
     in
       (append (FST bitmaps),
        <|bitmaps_length := SND bitmaps; stack_frame_size := sfs|>,0::fs,
        (raise_stub_location,raise_stub perf k,Metadata «_Raise» [Stub])::
          (store_consts_stub_location,store_consts_stub k,
           Metadata «_StoreConsts» [Stub])::progs))
END
PUBLISHED backend.compile_eq_from_source
⊢ compile = from_source
END
PUBLISHED labSem.evaluate_def
⊢ ∀s. evaluate s =
      if s.clock = 0 then (TimeOut,s)
      else
        case asm_fetch s of
          NONE => (Error,s)
        | SOME (Label v39 v40 v42) => (Error,s)
        | SOME (Asm (Asmi (Inst i)) v44 v45) =>
          (let
             s1 = asm_inst i s
           in
             if s1.failed then (Error,s)
             else evaluate (inc_pc (dec_clock s1)))
        | SOME (Asm (Asmi (Jump v12)) v44 v45) => (Error,s)
        | SOME (Asm (Asmi (JumpCmp v13 v14 v15 v16)) v44 v45) => (Error,s)
        | SOME (Asm (Asmi (Call v17)) v44 v45) => (Error,s)
        | SOME (Asm (Asmi (JumpReg r)) v44 v45) =>
          (case read_reg r s of
             Word v3 => (Error,s)
           | Loc n1 n2 =>
             case loc_to_pc n1 n2 s.code of
               NONE => (Error,s)
             | SOME p => evaluate (upd_pc p (dec_clock s)))
        | SOME (Asm (Asmi (Loc v19 v20)) v44 v45) => (Error,s)
        | SOME (Asm (ShareMem m r ad) v44 v45) =>
          (case share_mem_op m r ad s of
             NONE => (Error,s)
           | SOME (FFI_return v3 v4,s') =>
             evaluate
               (s' with
                <|io_regs := shift_seq 1 s'.io_regs;
                  io_fp_regs := shift_seq 1 s'.io_fp_regs|>)
           | SOME (FFI_final outcome,s') => (Halt (FFI_outcome outcome),s'))
        | SOME (LabAsm (Jump l) v47 v50 v51) =>
          (case get_pc_value l s of
             NONE => (Error,s)
           | SOME p => evaluate (upd_pc p (dec_clock s)))
        | SOME (LabAsm (JumpCmp c r'' ri l') v47 v50 v51) =>
          (case word_cmp c (read_reg r'' s) (reg_imm ri s) of
             NONE => (Error,s)
           | SOME T =>
             (case get_pc_value l' s of
                NONE => (Error,s)
              | SOME p => evaluate (upd_pc p (dec_clock s)))
           | SOME F => evaluate (inc_pc (dec_clock s)))
        | SOME (LabAsm (Call l'') v47 v50 v51) =>
          (case get_pc_value l'' s of
             NONE => (Error,s)
           | SOME p =>
             case get_ret_Loc s of
               NONE => (Error,s)
             | SOME k =>
               (let
                  s1 = upd_reg s.link_reg k s
                in
                  evaluate (upd_pc p (dec_clock s1))))
        | SOME (LabAsm (LocValue r' lab) v47 v50 v51) =>
          if get_pc_value lab s = NONE then (Error,s)
          else
            (let
               s1 = upd_reg r' (lab_to_loc lab) s
             in
               evaluate (inc_pc (dec_clock s1)))
        | SOME (LabAsm (CallFFI ffi_index) v47 v50 v51) =>
          (case
             (read_reg s.len_reg s,read_reg s.ptr_reg s,
              read_reg s.len2_reg s,read_reg s.ptr2_reg s,
              read_reg s.link_reg s)
           of
             (Word w,Word w2,Word w3,v36,Word v41) => (Error,s)
           | (Word w,Word w2,Word w3,Word w4,Loc n1 n2) =>
             (case
                (read_bytearray w2 (w2n w)
                   (mem_load_byte_aux s.mem s.mem_domain s.be),
                 read_bytearray w4 (w2n w3)
                   (mem_load_byte_aux s.mem s.mem_domain s.be),
                 loc_to_pc n1 n2 s.code)
              of
                (NONE,v3) => (Error,s)
              | (SOME bytes,NONE,v9) => (Error,s)
              | (SOME bytes,SOME bytes2,NONE) => (Error,s)
              | (SOME bytes,SOME bytes2,SOME new_pc) =>
                case call_FFI s.ffi (ExtCall ffi_index) bytes bytes2 of
                  FFI_return new_ffi new_bytes =>
                    (let
                       new_io_regs = shift_seq 1 s.io_regs;
                       new_io_fp_regs = shift_seq 1 s.io_fp_regs;
                       new_m =
                         write_bytearray w4 new_bytes s.mem s.mem_domain s.be
                     in
                       evaluate
                         (s with
                          <|mem := new_m; ffi := new_ffi;
                            io_regs := new_io_regs;
                            io_fp_regs := new_io_fp_regs;
                            regs :=
                              (λa.
                                 get_reg_value
                                   (s.io_regs 0 (ExtCall ffi_index) a)
                                   (read_reg a s) Word);
                            fp_regs := (λn. s.io_fp_regs 0 n); pc := new_pc;
                            clock := s.clock − 1|>))
                | FFI_final outcome => (Halt (FFI_outcome outcome),s))
           | (Word w,Word w2,Word w3,Loc v48 v49,Loc n1 n2) => (Error,s)
           | (Word w,Word w2,Loc v32 v33,v27) => (Error,s)
           | (Word w,Loc v22 v23,v17) => (Error,s)
           | (Loc v12 v13,v5) => (Error,s))
        | SOME (LabAsm Install v47 v50 v51) =>
          (case
             (code_buffer_install (SOME (read_reg s.ptr_reg s))
                (SOME (read_reg s.len_reg s)) (SOME (read_reg s.ptr2_reg s))
                (mem_load_byte_aux s.mem s.mem_domain s.be) s.code_buffer,
              read_reg s.link_reg s)
           of
             (v4,Word v12) => (Error,s)
           | (NONE,Loc n1 n2) => (Error,s)
           | (SOME (bytes,cb),Loc n1 n2) =>
             case loc_to_pc n1 n2 s.code of
               NONE => (Error,s)
             | SOME new_pc =>
               (let
                  (cfg,prog) = s.compile_oracle 0;
                  new_oracle = shift_seq 1 s.compile_oracle
                in
                  case (s.compile cfg prog,prog) of
                    (v2,[]) => (Error,s)
                  | (NONE,v6::v7) => (Error,s)
                  | (SOME (bytes',cfg'),Section k v14 v15::v7) =>
                    if bytes = bytes' ∧ FST (new_oracle 0) = cfg' then
                      evaluate
                        (s with
                         <|pc := new_pc; code_buffer := cb;
                           code := s.code ++ prog;
                           cc_regs := shift_seq 1 s.cc_regs;
                           cc_fp_regs := shift_seq 1 s.cc_fp_regs;
                           regs :=
                             (λa.
                                get_reg_value (s.cc_regs 0 a) (read_reg a s)
                                  Word)⦇
                               s.ptr_reg ↦ Loc k 0
                             ⦈; fp_regs := (λn. s.cc_fp_regs 0 n);
                           compile_oracle := new_oracle;
                           clock := s.clock − 1|>)
                    else (Error,s)))
        | SOME (LabAsm Halt v47 v50 v51) =>
          case read_reg s.ptr_reg s of
            Word 0w => (Halt Success,s)
          | Word v6 => (Halt Resource_limit_hit,s)
          | Loc v4 v5 => (Error,s)
END
