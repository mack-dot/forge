W2W_F8 ⊢ word_to_word_inlogic_forge8 word_conf progs =
  (let
     (n_oracles,col) = next_n_oracle (LENGTH progs) word_conf.col_oracle;
     progs = ZIP (progs,n_oracles)
   in
     case each_inlogic_forge8 progs of
       NONE => NONE
     | SOME res => SOME (col,res))
CWTS_F8 ⊢ compile_word_to_stack_forge8 perf k v bitmaps =
  case v of
    [] => ([],[],bitmaps)
  | (i,n,p,md)::progs =>
    (let
       (prog,f,bitmaps') = compile_prog_forge8 perf p n k bitmaps;
       (progs',fs,bitmaps'') =
         compile_word_to_stack_forge8 perf k progs bitmaps'
     in
       ((i,prog,md)::progs',f::fs,bitmaps''))
