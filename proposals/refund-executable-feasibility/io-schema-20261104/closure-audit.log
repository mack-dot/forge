FORGE_TAG refund_wrong_type_rejected oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_wrong_type_rejected ⊢ refund_decode
    (Expr
       [Expr []; Atom «r»; Atom «100»; Atom «60»; Atom «True»; Atom «True»;
        Atom «True»; Atom «40»; Atom «duplicate_charge»]) =
  INL «to_mlstring: Was not Atom»
FORGE_TAG refund_wire_roundtrip oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_wire_roundtrip ⊢ refund_decode_wire
    (sexp_to_string
       (refund_request charge request original remaining enabled opened
          candidate amount reason)) =
  INR
    (charge,request,original,remaining,enabled,opened,candidate,amount,reason)
FORGE_TAG refund_wire_model_result oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_wire_model_result ⊢ case
    refund_wire_model ffi
      (sexp_to_string
         (refund_request charge request original remaining enabled opened
            candidate amount reason))
  of
    NONE => F
  | SOME result =>
    case SND result of
      Rval env =>
        nsLookup env.v (Short «answer») =
        SOME
          (refund_expected_tuple charge request original remaining enabled
             opened candidate amount reason) ∧ (FST result).ffi = ffi
    | Rerr err => F
FORGE_TAG refund_trailing_input_rejected oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_trailing_input_rejected ⊢ rest ≠ "" ∧ parse (explode wire) = INR (se,rest) ⇒
  refund_decode_wire wire = INL «refund: trailing input»
FORGE_TAG refund_stream_parse oracles=DISK_THM axioms= hypotheses=0
