CHECKED region_inv_facts
⊢ region_inv G OK code s ⇒
  s.code = code ∧ (∀w. G (Word w)) ∧ val_inv G s ∧ OK s.pc ∧
  (∀n1 n2 p. G (Loc n1 n2) ∧ loc_to_pc n1 n2 s.code = SOME p ⇒ OK p) ∧
  ∀line. asm_fetch s = SOME line ⇒ step_ok G OK s.code s.pc line
