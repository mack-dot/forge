INSTALL_CODE ⊢ Install_code c =
  Seq (Assign 1 (Lookup BitmapBuffer))
    (Seq (Assign 5 (Lookup CodeBuffer))
       (Seq
          (Assign 3
             (if
                arch_shift c.arch_width =
                1 + c.pad_bits + c.len_bits + c.tag_bits + 1 ∧
                c.len_bits = 0 ∧ c.tag_bits = 0
              then
                Op Add [Lookup CurrHeap; Op Sub [Var 4; Const 1]]
              else if arch_shift c.arch_width ≤ c.pad_bits + 1 then
                Op Add
                  [Lookup CurrHeap;
                   ShiftN Lsr (Var 4)
                     (1 + c.pad_bits + c.len_bits + c.tag_bits + 1 −
                      arch_shift c.arch_width)]
              else
                Op Add
                  [Lookup CurrHeap;
                   ShiftN Lsl
                     (ShiftN Lsr (Var 4)
                        (1 + c.pad_bits + c.len_bits + c.tag_bits + 1))
                     (arch_shift c.arch_width)]))
          (Seq
             (Assign 7
                (ShiftN Lsr (Load (Var 3))
                   (arch_width_bits c.arch_width − arch_shift c.arch_width −
                    c.len_size)))
             (Seq
                (Assign 7 (Op Sub [Var 7; Const (&arch_bytes c.arch_width)]))
                (Seq
                   (Assign 3
                      (Op Add [Var 3; Const (&arch_bytes c.arch_width)]))
                   (Seq (Set BitmapBuffer (Var 2))
                      (Seq (Set CodeBuffer (Op Add [Var 5; Var 7]))
                         (Seq (Install 3 7 5 1 2 (⦕ 0 ⦖,LN)) (Return 0 [3])))))))))
