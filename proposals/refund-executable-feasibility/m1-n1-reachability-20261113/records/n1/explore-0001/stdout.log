FIND_WORD_REF ⊢ (∀p. find_word_ref (MustTerminate p) = find_word_ref p) ∧
  (∀v0 target ret handler.
     find_word_ref (Call ret target v0 handler) =
     union (case target of NONE => LN | SOME n => insert n () LN)
       (union
          (case ret of
             NONE => LN
           | SOME (v1,v3,ret_handler,l1,v8) =>
             insert l1 () (find_word_ref ret_handler))
          (case handler of NONE => LN | SOME (v1,v3,v4) => find_word_ref v3))) ∧
  (∀p2 p1.
     find_word_ref (Seq p1 p2) = union (find_word_ref p1) (find_word_ref p2)) ∧
  (∀v3 v2 v1 p2 p1.
     find_word_ref (If v1 v2 v3 p1 p2) =
     union (find_word_ref p1) (find_word_ref p2)) ∧
  (∀v4 n. find_word_ref (LocValue v4 n) = insert n () LN) ∧
  (∀names exit_names body.
     find_word_ref (Loop names body exit_names) = find_word_ref body) ∧
  isEmpty (find_word_ref Skip) ∧
  (∀v9 v7. isEmpty (find_word_ref (Move v7 v9))) ∧
  (∀v10. isEmpty (find_word_ref (Inst v10))) ∧
  (∀v12 v11. isEmpty (find_word_ref (Assign v11 v12))) ∧
  (∀v14 v13. isEmpty (find_word_ref (Get v13 v14))) ∧
  (∀v16 v15. isEmpty (find_word_ref (Set v15 v16))) ∧
  (∀v18 v17. isEmpty (find_word_ref (Store v17 v18))) ∧
  (∀v35 v34. isEmpty (find_word_ref (Alloc v34 v35))) ∧
  (∀v40 v39 v38 v37 v36.
