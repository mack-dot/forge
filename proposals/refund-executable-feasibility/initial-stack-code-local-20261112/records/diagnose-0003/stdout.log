    (post_alloc_conventions (dimindex (:64))
       (arm8_config.reg_count − (LENGTH arm8_config.avoid_regs + (5 :num))))
    (MAP
       ((FST :wordLang$prog # metadata -> wordLang$prog) ∘
        (SND :num # wordLang$prog # metadata -> wordLang$prog # metadata) ∘
        (SND :num # num # wordLang$prog # metadata ->
