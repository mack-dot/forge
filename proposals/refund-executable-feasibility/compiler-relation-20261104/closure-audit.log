FORGE_TAG related_local oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT related_local ⊢ read_local s.locals name = SOME dfy_v ∧ state_rel m l s t env ∧
  is_fresh name ⇒
  ∃cml_v. val_rel m dfy_v cml_v ∧ cml_has_local l t env name cml_v
FORGE_TAG refund_static oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_static ⊢ is_fresh_stmt refund_body ∧ (∀names. no_shadow names refund_body) ∧
  no_assert_stmt refund_body
FORGE_TAG refund_statement_evaluation oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_statement_evaluation ⊢ evaluate_stmt
    (refund_initial h charge request original remaining enabled opened
       candidate amount reason) env refund_body =
  (FST
     (evaluate_stmt
        (refund_initial h charge request original remaining enabled opened
           candidate amount reason) env refund_body),Rstop Sret)
FORGE_TAG refund_output_names_fresh oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_output_names_fresh ⊢ is_fresh «v9» ∧ is_fresh «v10» ∧ is_fresh «v11» ∧ is_fresh «v12» ∧
  is_fresh «v13» ∧ is_fresh «v14»
FORGE_TAG refund_model_return oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_model_return ⊢ SND
    (evaluate_stmt
       (refund_initial h charge request original remaining enabled opened
          candidate amount reason) env refund_body) = Rstop Sret
FORGE_TAG refund_fields_transfer oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_fields_transfer ⊢ state_rel m l
    (FST
       (evaluate_stmt
          (refund_initial h charge request original remaining enabled opened
             candidate amount reason) env refund_body)) t env_cml ⇒
  refund_cml_outputs l t env_cml charge request original remaining enabled
    opened candidate amount reason
FORGE_TAG refund_compiler_relation oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_compiler_relation ⊢ state_rel m l
    (refund_initial h charge request original remaining enabled opened
       candidate amount reason) t env_cml ∧ env_rel env_dfy env_cml ⇒
  ∃ck t' m' r_cml.
    evaluate (t with clock := t.clock + ck) env_cml [refund_cml] = (t',r_cml) ∧
    store_preserve (FRANGE m) 0 t.refs t'.refs ∧
    state_rel m' l
      (FST
         (evaluate_stmt
            (refund_initial h charge request original remaining enabled
               opened candidate amount reason) env_dfy refund_body)) t'
      env_cml ∧ cml_state_preserved t t' ∧ m ⊑ m' ∧
    is_extension t.refs m m' ∧ stmt_res_rel (Rstop Sret) r_cml
FORGE_TAG refund_compiled_behavior oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_compiled_behavior ⊢ state_rel m l
    (refund_initial h charge request original remaining enabled opened
       candidate amount reason) t env_cml ∧ env_rel env_dfy env_cml ⇒
  ∃ck t' r_cml.
    evaluate (t with clock := t.clock + ck) env_cml [refund_cml] = (t',r_cml) ∧
    stmt_res_rel (Rstop Sret) r_cml ∧ cml_state_preserved t t' ∧
    refund_cml_outputs l t' env_cml charge request original remaining enabled
      opened candidate amount reason
FORGE_TAG refund_compilation oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_compilation ⊢ from_stmt refund_body 0 = INR refund_cml
