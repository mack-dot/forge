DEFINITION mval_inv_def
⊢ ∀G D s. mval_inv G D s ⇔ (∀r. G (read_reg r s)) ∧ ∀a. D a ⇒ G (s.mem a)
DEFINITION load_covered_def
⊢ ∀D. load_covered D ⇔ ∀w. w2n w MOD (dimindex (:α) DIV 8) = 0 ⇒ D w
DEFINITION region_inv2_def
⊢ ∀G D OK code s.
    region_inv2 G D OK code s ⇔
    s.code = code ∧ region_hyp G OK code ∧ load_covered D ∧ mval_inv G D s ∧
    OK s.pc
