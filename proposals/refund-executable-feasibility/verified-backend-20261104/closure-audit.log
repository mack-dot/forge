FORGE_TAG refund_guard_value oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_guard_value ⊢ evaluate_exp
    (refund_initial h charge request original remaining enabled opened
       candidate amount reason) env refund_guard =
  (refund_initial h charge request original remaining enabled opened
     candidate amount reason,
   Rval
     (BoolV
        (eligible charge request original remaining enabled opened candidate
           amount reason)))
FORGE_TAG refund_full_result oracles=DISK_THM axioms= hypotheses=0
FORGE_STATEMENT refund_full_result ⊢ let
    initial =
      refund_initial h charge request original remaining enabled opened
        candidate amount reason;
    result = evaluate_stmt initial env refund_body;
    final = FST result;
    ok =
      eligible charge request original remaining enabled opened candidate
        amount reason
  in
    SND result = Rstop Sret ∧ final.heap = h ∧
    read_local final.locals «v9» = SOME (BoolV ok) ∧
    read_local final.locals «v10» = SOME (IntV (if ok then amount else 0)) ∧
    read_local final.locals «v11» = SOME (StrV (if ok then reason else «»)) ∧
    read_local final.locals «v12» = SOME (StrV (if ok then charge else «»)) ∧
    read_local final.locals «v13» = SOME (StrV (if ok then request else «»)) ∧
    read_local final.locals «v14» = SOME (IntV (if ok then 1 else 0))
