TYPED asm_step_IMP_evaluate_step_find_next_prefix
⊢ ∀(c :(α, 'state, β) machine_config) (s1 :α asm_state) (ms1 :'state)
      (io :γ ffi_state) (i :asm).
    encoder_correct c.target ∧ c.prog_addresses = s1.mem_domain ∧
    ffi_entry_pcs_disjoint c s1 (LENGTH (c.target.config.encode i)) ∧
