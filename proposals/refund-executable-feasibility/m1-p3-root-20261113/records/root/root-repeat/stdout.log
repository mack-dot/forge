    asm_step c.target.config s1 i
      (asm i (s1.pc + (n2w (LENGTH (c.target.config.encode i)) :α word)) s1) ∧
    target_state_rel c.target s1 ms1 ⇒
    ∃(l :num) (ms2 :'state).
      (∀(k :num).
         (evaluate c io (k + l) ms1 :machine_result # 'state # γ ffi_state) =
         (evaluate (shift_interfer l c) io k ms2 :
          machine_result # 'state # γ ffi_state) ∧
         find_next_interference c io (k + l) ms1 =
         find_next_interference (shift_interfer l c) io k ms2 ∧
         target_state_rel c.target
           (asm i (s1.pc + (n2w (LENGTH (c.target.config.encode i)) :α word))
              s1) ms2 ∧ l ≠ (0 :num)) ∧
      (∀(j :num) (ms' :'state) (io' :γ ffi_state).
         j < l ∧
         (evaluate c io j ms1 :machine_result # 'state # γ ffi_state) =
         (TimeOut,ms',io') ⇒
         c.target.get_pc ms' ∈
         c.prog_addresses DIFF (set c.ffi_entry_pcs :α word -> bool)) ∧
      (c.install_pc ∉ c.prog_addresses ⇒
       no_install_prefix c io (l − (1 :num)) ms1 ∧
       ((asm i (s1.pc + (n2w (LENGTH (c.target.config.encode i)) :α word)) s1).
        pc ≠ c.install_pc ⇒
        no_install_prefix c io l ms1))
