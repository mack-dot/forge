CHECKED error_implies_failure
⊢ FST (evaluate (Call NONE (SOME start) [0] NONE,s with clock := k)) =
  SOME Error ⇒
  semantics s start = Fail
CHECKED semantics_nonerror
⊢ semantics s start ≠ Fail ⇒
  ∀k. FST (evaluate (Call NONE (SOME start) [0] NONE,s with clock := k)) ≠
      SOME Error
CHECKED extended_nonfailure
⊢ x ∈ extend_with_resource_limit' precise {y} ∧ y ≠ Fail ⇒ x ≠ Fail
CHECKED compiled_word_nonerror
