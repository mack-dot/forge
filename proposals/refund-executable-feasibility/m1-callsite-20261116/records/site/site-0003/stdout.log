    mc.ffi_entry_pcs =
    [0x1000040A0w; 0x100004090w; 0x100004080w; 0x100004070w] ∧
    mc.halt_pc = 0x1000040C0w ∧ mc.install_pc = 0x1000040B0w ∧
    mc.mmio_info = [] ∧ mc.prog_addresses = dm ∧ 0x100004080w ∉ dm ∧
    mc.target = arm8_target ∧ mc.ptr_reg = 0 ∧ mc.len_reg = 1 ∧
    mc.ptr2_reg = 2 ∧ mc.len2_reg = 3
DEFINITION ⊢ ∀mc mc'.
    mc_static_eq mc mc' ⇔
    mc'.ffi_names = mc.ffi_names ∧ mc'.ffi_entry_pcs = mc.ffi_entry_pcs ∧
    mc'.halt_pc = mc.halt_pc ∧ mc'.install_pc = mc.install_pc ∧
    mc'.mmio_info = mc.mmio_info ∧ mc'.prog_addresses = mc.prog_addresses ∧
    mc'.target = mc.target ∧ mc'.ptr_reg = mc.ptr_reg ∧
    mc'.len_reg = mc.len_reg ∧ mc'.ptr2_reg = mc.ptr2_reg ∧
    mc'.len2_reg = mc.len2_reg
DEFINITION ⊢ ∀mc ffi ms mc' ffi' ms'.
    machine_step mc ffi ms mc' ffi' ms' ⇔
    (∀k. evaluate mc ffi (k + 1) ms = evaluate mc' ffi' k ms') ∧
    ffi'.oracle = ffi.oracle ∧ mc_static_eq mc mc'
DEFINITION ⊢ (∀mc ffi ms mc1 ffi1 ms1.
     machine_reach_n 0 mc ffi ms mc1 ffi1 ms1 ⇔
     mc1 = mc ∧ ffi1 = ffi ∧ ms1 = ms) ∧
  ∀n mc ffi ms mc1 ffi1 ms1.
    machine_reach_n (SUC n) mc ffi ms mc1 ffi1 ms1 ⇔
    ∃mc' ffi' ms'.
      machine_step mc ffi ms mc' ffi' ms' ∧
      machine_reach_n n mc' ffi' ms' mc1 ffi1 ms1
DEFINITION ⊢ ∀mc ffi ms mc1 ffi1 ms1.
    machine_reach mc ffi ms mc1 ffi1 ms1 ⇔
    ∃n. machine_reach_n n mc ffi ms mc1 ffi1 ms1
