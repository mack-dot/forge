Saved theorem _______ "extcall_step_is_machine_step"
CHECKED extcall_step_is_machine_step
⊢ mc.target.get_pc ms ∉ mc.prog_addresses DIFF set mc.ffi_entry_pcs ∧
  mc.target.get_pc ms ≠ mc.halt_pc ∧ mc.target.get_pc ms ≠ mc.install_pc ∧
  find_index (mc.target.get_pc ms) mc.ffi_entry_pcs 0 = SOME i ∧
  mc.ffi_names❲i❳ = ExtCall nm ∧ ALOOKUP mc.mmio_info i = NONE ∧
  read_ffi_bytearrays mc ms = (SOME cbytes,SOME abytes) ∧
  call_FFI ffi (ExtCall nm) cbytes abytes = FFI_return new_ffi nb ⇒
  machine_step mc ffi ms
    (mc with ffi_interfer := shift_seq 1 mc.ffi_interfer) new_ffi
    (mc.ffi_interfer 0 (i,nb,ms))
