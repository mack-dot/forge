       ALOOKUP mc_conf.mmio_info index = SOME (nb,Addr ad offs,re,pc') ∧
       mc_conf.prog_addresses = t1.mem_domain ∧
       ad' = mc_conf.target.get_reg ms2 ad + i2w offs ∧
       target_state_rel mc_conf.target
         (t1 with pc := mc_conf.ffi_entry_pcs❲index❳) ms2 ⇒
       ∃op.
         mc_conf.ffi_names❲index❳ = SharedMem op ∧
         case op of
           MappedRead =>
             (if nb = 0w then w2n ad' MOD (dimindex (:α) DIV 8) = 0 else T) ∧
             ad' ∈ mc_conf.shared_addresses ∧
             is_valid_mapped_read (mc_conf.target.get_pc ms2) nb
