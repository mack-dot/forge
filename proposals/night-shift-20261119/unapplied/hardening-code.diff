+// Regression C-HOST-01, 03, 04, 07: the command-line doors tell the truth by exit code and report. Uses the tree's
+// tests/refund-finality/{commit,dispatch}_cli.ts. Each case is SAFE as stated; the file FAILS if any case fails.
+//  a (H-04) commit_cli: a malformed token exits non-zero; a mistyped database path exits non-zero and creates no file.
+//  b (H-01) dispatch_cli: the effect cannot be written (emit fails): exit non-zero; the retry also exits non-zero
+//           (the refund is in doubt, not "nothing to do").
+//  c (H-01) dispatch_cli: a lock held by a live process: exit non-zero.
+//  d (H-01) dispatch_cli: every row refused (wrong pinned initial state): exit non-zero.
+//  e (H-03) dispatch_cli: the lock is removed while the run is in a slow effect: the report counts every effect it sent.
+//  f (H-07) dispatch_cli: stdout is closed before the report (EPIPE): the exit code is 0 for a clean run whose effect left.
+// Usage and exit codes: d_lib.ts.
+import { spawn } from "node:child_process";
+import { randomBytes } from "node:crypto";
+import { existsSync, readFileSync, realpathSync, rmSync, writeFileSync } from "node:fs";
+import { hostname } from "node:os";
+import { join } from "node:path";
+import { argv, guard, runNode, verdict, world } from "./d_lib";
+guard((async () => {
+  const { root, core } = argv();
+  const CLI = (n: string) => join(root, "tests/refund-finality", n);
+  const S0 = { chargeId: "ch_dcli", original: "1000", remaining: "1000", refundEnabled: true };
+  const out: Record<string, unknown> = {}; const ok: Record<string, boolean> = {};
+  const fresh = async (amounts: string[]) => {
+    const w = await world(root, core, S0);
+    let pre: any = S0; const toks: string[] = [];
+    for (let i = 0; i < amounts.length; i++) { const t = await w.mint(pre, "rq_" + i, amounts[i]); toks.push(t.text); pre = t.post; }
+    const scfg = join(w.dir, "sink-config.json"), dcfg = join(w.dir, "disp-config.json"), eff = join(w.dir, "effects.jsonl");
+    writeFileSync(scfg, JSON.stringify(w.sinkCfg)); writeFileSync(dcfg, JSON.stringify(w.dcfg)); writeFileSync(eff, "");
+    toks.forEach((t, i) => writeFileSync(join(w.dir, `t${i}.token`), t));
+    w.closeSink();
+    return { w, scfg, dcfg, eff };
+  };
+  const D = (x: { w: any; dcfg: string; eff: string }, eff = x.eff, dcfg = x.dcfg) => runNode(root, [CLI("dispatch_cli.ts"), x.w.db, x.w.ledger, dcfg, eff, "0"]);
+  { // a
+    const x = await fresh(["400"]); writeFileSync(join(x.w.dir, "bad.token"), "{}");
+    const r1 = await runNode(root, [CLI("commit_cli.ts"), x.w.db, x.scfg, join(x.w.dir, "bad.token"), "0"]);
+    const typo = join(x.w.dir, "typo.sqlite");
+    const r2 = await runNode(root, [CLI("commit_cli.ts"), typo, x.scfg, join(x.w.dir, "t0.token"), "0"]);
+    ok.a = r1.code !== 0 && r2.code !== 0 && !existsSync(typo); out.a = { bad: r1.code, typo: r2.code, created: existsSync(typo) }; x.w.stop();
+  }
+  { // b
+    const x = await fresh(["400"]); await runNode(root, [CLI("commit_cli.ts"), x.w.db, x.scfg, join(x.w.dir, "t0.token"), "0"]);
+    const r1 = await D(x, join(x.w.dir, "no-such-dir", "effects.jsonl")), r2 = await D(x);
+    ok.b = r1.code !== 0 && r2.code !== 0 && readFileSync(x.eff, "utf8") === ""; out.b = { run1: r1.code, retry: r2.code, retryOut: r2.stdout.slice(0, 120) }; x.w.stop();
+  }
+  { // c
+    const x = await fresh(["400"]); await runNode(root, [CLI("commit_cli.ts"), x.w.db, x.scfg, join(x.w.dir, "t0.token"), "0"]);
+    writeFileSync(x.w.ledger, ""); writeFileSync(realpathSync(x.w.ledger) + ".lock", JSON.stringify({ pid: process.pid, run: randomBytes(16).toString("hex"), host: hostname() }));
+    const r = await D(x); ok.c = r.code !== 0 && readFileSync(x.eff, "utf8") === ""; out.c = { code: r.code }; x.w.stop();
+  }
+  { // d
+    const x = await fresh(["400"]); await runNode(root, [CLI("commit_cli.ts"), x.w.db, x.scfg, join(x.w.dir, "t0.token"), "0"]);
+    const bad = join(x.w.dir, "disp-bad.json"); writeFileSync(bad, JSON.stringify({ ...x.w.dcfg, initialStateSha256: "0".repeat(64) }));
+    const r = await D(x, x.eff, bad); ok.d = r.code !== 0; out.d = { code: r.code, out: r.stdout.slice(0, 120) }; x.w.stop();
+  }
+  { // e
+    const x = await fresh(["400", "600"]);
+    for (const i of [0, 1]) await runNode(root, [CLI("commit_cli.ts"), x.w.db, x.scfg, join(x.w.dir, `t${i}.token`), "0"]);
+    const run = D(x);
+    const t0 = Date.now(); while (readFileSync(x.eff, "utf8") === "" && Date.now() - t0 < 30000) await new Promise(r => setTimeout(r, 5));
+    rmSync(realpathSync(x.w.ledger) + ".lock", { force: true });
+    const r = await run; const sent = readFileSync(x.eff, "utf8").split("\n").filter(Boolean).length;
+    let reported = -1; try { reported = JSON.parse(r.stdout).emitted; } catch { /* no report */ }
+    ok.e = sent > 0 && reported === sent; out.e = { code: r.code, sent, reported }; x.w.stop();
+  }
+  { // f
+    const x = await fresh(["400"]); await runNode(root, [CLI("commit_cli.ts"), x.w.db, x.scfg, join(x.w.dir, "t0.token"), "0"]);
+    const code = await new Promise<number | null>(res => {
+      const p = spawn(process.execPath, ["--no-warnings", "--import", "tsx", CLI("dispatch_cli.ts"), x.w.db, x.w.ledger, x.dcfg, x.eff, "0"],
+        { cwd: root, env: { PATH: process.env.PATH ?? "/usr/bin:/bin" }, stdio: ["ignore", "pipe", "ignore"] });
+      p.stdout.destroy();
+      p.on("exit", c => res(c));
+    });
+    const sent = readFileSync(x.eff, "utf8").split("\n").filter(Boolean).length;
+    ok.f = sent === 1 && code === 0; out.f = { code, sent }; x.w.stop();
+  }
+  verdict(Object.values(ok).every(Boolean) && Object.keys(ok).length === 6, { ok, out });
+})());
diff --git a/tests/refund-finality/regress/d_lib.ts b/tests/refund-finality/regress/d_lib.ts
new file mode 100644
index 00000000..376400c5
--- /dev/null
+++ b/tests/refund-finality/regress/d_lib.ts
@@ -0,0 +1,81 @@
+// Shared helper of the dispatcher regressions d_*.ts (night shift 2026-11-19, task h-dispatch). A TEST, not a proof.
+// Usage of every d_*.ts file (from any directory, pinned Node 24.3.0):
+//   node --import tsx tests/refund-finality/regress/d_<name>.ts <treeRoot> <compiledIssuerModule>
+// <treeRoot>: the checkout whose ts/refund-finality/{dispatcher,sink,proposer,encoding}.ts (and, for d_host_*, the
+// tests/refund-finality/{dispatch,commit}_cli.ts) are under test. <compiledIssuerModule>: the module that this tree's
+// minter.ts expects (this branch: the IssueOnce build).
+// Exit 0: PASS (the safe outcome). Exit 1: FAIL (the defect). Exit 2: usage. Exit 3: the harness broke.
+// Test keys only (D-1): each issuer process gets a NEW throwaway key FILE (kf_lib.ts). Files go to a fresh temp directory (removed at exit).
+// The dispatcher config always carries newLedgerH0 (as suite.ts does), so a NEW ledger is allowed by configuration.
+import { spawn } from "node:child_process";
+import { makeKeyFile } from "./kf_lib";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+
+export type State = { chargeId: string; original: string; remaining: string; refundEnabled: boolean };
+export type Effect = { requestId: string; intent: string };
+export function argv(): { root: string; core: string } {
+  const [root, core] = process.argv.slice(2);
+  if (!root || !core) { console.error("usage: d_<name>.ts <treeRoot> <compiledIssuerModule>"); process.exit(2); }
+  return { root: resolve(root), core: resolve(core) };
+}
+const temps: string[] = [];
+process.on("exit", () => { for (const d of temps) { try { rmSync(d, { recursive: true, force: true }); } catch { /* best effort */ } } });
+export function tempDir(): string { const d = mkdtempSync(join(tmpdir(), "forge-d-")); temps.push(d); return d; }
+
+/* eslint-disable @typescript-eslint/no-require-imports */
+export function load(root: string): any {
+  return {
+    E: require(join(root, "ts/refund-finality/encoding.ts")),
+    Sink: require(join(root, "ts/refund-finality/sink.ts")).Sink,
+    Dispatcher: require(join(root, "ts/refund-finality/dispatcher.ts")).Dispatcher,
+    genesisOf: require(join(root, "ts/refund-finality/core/store.ts")).genesisOf,
+    ...require(join(root, "ts/refund-finality/proposer.ts")),
+  };
+}
+/* eslint-enable @typescript-eslint/no-require-imports */
+
+// One issuer (memory rule "on"), one sink store, one ledger path, one list of effects.
+export async function world(root: string, core: string, S0: State) {
+  const L = load(root);
+  const m = await L.MinterClient.start(root, core, join(root, "spec/refund/spec.lock"), "on", makeKeyFile().path);
+  const ids = { publicKeyPem: m.ready.publicKeyPem, specLockSha256: m.ready.specLockSha256, checkerSha256: m.ready.checkerSha256 };
+  const dir = tempDir(), db = join(dir, "sink.sqlite"), ledger = join(dir, "ledger.jsonl");
+  const sinkCfg = { ...ids, initialState: S0 };
+  const dcfg: any = { ...ids, initialStateSha256: L.E.stateSha256(S0), newLedgerH0: L.genesisOf(L.E.canon(S0), ids.specLockSha256, ids.checkerSha256, ids.publicKeyPem) };
+  let sink = new L.Sink(db, sinkCfg); sink.init(S0);
+  const effects: Effect[] = [];
+  // Mint a token for a pre-state; returns the token text and the post-state (no commit).
+  const mint = async (pre: State, requestId: string, amount: string): Promise<{ text: string; post: State }> => {
+    const t = L.propose(pre, { requestId, amount, reason: "duplicate_charge" });
+    const a = await m.mint(pre, t);
+    if (!a.ok) throw new Error("mint refused: " + a.reason);
+    return { text: L.E.tokenText(a.token), post: t.post };
+  };
+  const commit = (text: string): string => sink.commit(text).status;
+  const dispatcher = (emit?: (e: Effect) => void, ledgerPath = ledger, cfg: any = dcfg) =>
+    new L.Dispatcher(db, ledgerPath, cfg, emit ?? ((e: Effect) => { effects.push(e); }));
+  const flush = (emit?: (e: Effect) => void, ledgerPath = ledger, cfg: any = dcfg) => dispatcher(emit, ledgerPath, cfg).flush();
+  const reopen = () => { try { sink.close(); } catch { /* closed */ } sink = new L.Sink(db, sinkCfg); };
+  const stop = () => { try { sink.close(); } catch { /* closed */ } m.stop(); };
+  return { L, ids, dir, db, ledger, sinkCfg, dcfg, effects, mint, commit, dispatcher, flush, reopen, stop, closeSink: () => sink.close() };
+}
+
+// Runs `node --import tsx <file> args...` and returns its exit code and stdout.
+export function runNode(cwd: string, args: string[], env: NodeJS.ProcessEnv = { PATH: process.env.PATH ?? "/usr/bin:/bin" }): Promise<{ code: number | null; stdout: string }> {
+  return new Promise(done => {
+    const child = spawn(process.execPath, ["--no-warnings", "--import", "tsx", ...args], { cwd, env, stdio: ["ignore", "pipe", "ignore"] });
+    let stdout = "";
+    child.stdout.on("data", c => { stdout += String(c); });
+    child.on("close", code => done({ code, stdout }));
+  });
+}
+export const total = (effects: Effect[]): number => effects.reduce((s, e) => s + Number(JSON.parse(e.intent).amount), 0);
+export const dups = (ids: string[]): string[] => ids.filter((x, i) => ids.indexOf(x) !== i);
+export function verdict(pass: boolean, detail: unknown): never {
+  console.log(JSON.stringify(detail));
+  console.log(pass ? "PASS" : "FAIL");
+  process.exit(pass ? 0 : 1);
+}
+export function guard(p: Promise<void>): void { p.catch(e => { console.error(e); process.exit(3); }); }
diff --git a/tests/refund-finality/regress/d_positive_controls.ts b/tests/refund-finality/regress/d_positive_controls.ts
new file mode 100644
index 00000000..685e6bd4
--- /dev/null
+++ b/tests/refund-finality/regress/d_positive_controls.ts
@@ -0,0 +1,33 @@
+// Positive controls of the dispatcher (honest behaviour; attacker: none). Must PASS on the fixed and on the unfixed tree.
+//  P1: two zero-amount refunds and one positive refund: each is emitted exactly once (zero is a legitimate refund:
+//      spec/refund/protocol.md); a second run emits nothing and refuses nothing.
+//  P2: a lock held by a LIVE process (this one) stops a run; nothing is emitted; after the lock is gone, a later
+//      zero-amount refund is emitted exactly once.
+// Usage and exit codes: d_lib.ts.
+import { randomBytes } from "node:crypto";
+import { realpathSync, unlinkSync, writeFileSync } from "node:fs";
+import { hostname } from "node:os";
+import { argv, dups, guard, verdict, world } from "./d_lib";
+guard((async () => {
+  const { root, core } = argv();
+  const S0 = { chargeId: "ch_dpos", original: "1000", remaining: "1000", refundEnabled: true };
+  const w = await world(root, core, S0);
+  const z1 = await w.mint(S0, "rq_z1", "0"); const c1 = w.commit(z1.text);
+  const z2 = await w.mint(z1.post, "rq_z2", "0"); const c2 = w.commit(z2.text);
+  const p1 = await w.mint(z2.post, "rq_p1", "100"); const c3 = w.commit(p1.text);
+  const f1 = w.flush(), f2 = w.flush();
+  const P1 = c1 === "committed" && c2 === "committed" && c3 === "committed" && f1.emitted.length === 3 && f1.refused.length === 0 &&
+    f2.emitted.length === 0 && f2.refused.length === 0 && f2.alreadyDispatched === 3;
+  const z3 = await w.mint(p1.post, "rq_z3", "0"); const c4 = w.commit(z3.text);
+  const lock = realpathSync(w.ledger) + ".lock";
+  writeFileSync(lock, JSON.stringify({ pid: process.pid, run: randomBytes(16).toString("hex"), host: hostname(), startedAt: new Date().toISOString() }));
+  const before = w.effects.length; let held = "";
+  try { w.flush(); } catch (e) { held = (e as Error).message; }
+  const stoppedClean = held.startsWith("dispatcher lock is held") && w.effects.length === before;
+  unlinkSync(lock);
+  const f3 = w.flush();
+  w.stop();
+  const ids = w.effects.map(e => e.requestId);
+  const P2 = c4 === "committed" && stoppedClean && f3.emitted.length === 1 && f3.emitted[0].requestId === "rq_z3" && f3.refused.length === 0;
+  verdict(P1 && P2 && dups(ids).length === 0 && ids.length === 4, { P1, P2, effects: ids, held: held.slice(0, 80) });
+})());
diff --git a/tests/refund-finality/regress/harness.ts b/tests/refund-finality/regress/harness.ts
new file mode 100644
index 00000000..afc8e80e
--- /dev/null
+++ b/tests/refund-finality/regress/harness.ts
@@ -0,0 +1,254 @@
+// Shared harness of the refund-finality regressions (task h-regress; process model and trusted encoding: task
+// h-judges, night shift 2026-11-19). A TEST, not a proof.
+// PROCESS MODEL. This harness runs in the PARENT (the judge). It never loads the sink or the dispatcher under test.
+// Each regression gets its own CHILD process (worker.ts, through remote.ts) that loads the two modules BY PATH and
+// runs only the operations asked for: new Sink(path, cfg), sink.init(state), sink.commit(tokenText), sink.close(),
+// new Dispatcher(db, ledger, dcfg, emit).flush(). The parent holds the keys, builds and signs every token, reads the
+// DATABASE FILES ITSELF (node:sqlite, read-only), reads the dispatcher ledger file itself, and decides PASS/FAIL.
+// A restart of the sink can be a new Sink instance in the same child (reopen) or a NEW CHILD PROCESS (restart()).
+// TRUSTED ENCODING. Canonical bytes, signed bytes and hashes come from the encoding.ts of the tree that this judge
+// lives in (../../../ts/refund-finality/encoding), never from the encoding.ts next to the sink under test.
+// Keys: one TEST Ed25519 key pair and one FOREIGN test key pair, generated in the parent. A FAULTY SIGNER is
+// modelled by signing an arbitrary token body with the trusted test key.
+// The sink config always carries `initialState`. The dispatcher config carries `newLedgerH0` when the sink module
+// exports genesisOf (capability check in the child; the hardened sink needs it to start a new ledger).
+// HOSTILE WRITER (two strengths). write(db, f, "keep"): a second connection that keeps the schema; if the database
+// aborts the write (triggers, CHECK), WriteRefused is thrown. write(db, f, "drop"): the stronger writer drops every
+// trigger, sets PRAGMA ignore_check_constraints, writes, and restores the trigger text (same schema text after).
+// Durable state is read from the tables `state` (blob), `settled` (request_id) and `outbox` (request_id, intent).
+// EFFECTS (h-judges2): the effects of a flush are the records that the PARENT's receiver got (remote.ts); the child
+// never reports them. The ledger is read by the parent with a tolerant parser (ledgerLineIds in remote.ts).
+// CHAIN-VALID WRITER (h-judges2, red-team blind spot md_ignore_sig): appendRow() appends a settled row (and its outbox
+// row and state change) with the row-log chain RECOMPUTED by the trusted chain function of this tree (genesisOf and
+// linkOf, ../../../ts/refund-finality/core/store; the chain is unkeyed and public). A row written so differs from a
+// row that the sink wrote only in what the writer chose to put in the token.
+import { generateKeyPairSync, sign } from "node:crypto";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import * as TE from "../../../ts/refund-finality/encoding";
+import * as TSTORE from "../../../ts/refund-finality/core/store";
+import { Received, Remote, ledgerLineIds } from "./remote";
+
+export type State = { chargeId: string; original: string; remaining: string; refundEnabled: boolean };
+export type Intent = { chargeId: string; requestId: string; amount: string; reason: string };
+export type Outcome = { ok: boolean; reason: string; limit?: boolean };
+// kind "limit": three outcomes. ok && !limit = SAFE (PASS); ok && limit = the stated unsafe limit holds (KNOWN-LIMIT);
+// !ok = FAIL. Kinds "attack", "control", "integrity": ok = PASS, !ok = FAIL.
+export type Regression = { id: string; kind: "attack" | "control" | "limit" | "integrity"; title: string; run: (h: Harness) => Promise<Outcome> };
+export type Effect = Received & { intent: Intent };
+export type AnchorAdapter = { capture: (h: Harness, dbPath: string) => unknown; apply: (cfg: any, head: unknown) => any };
+export type WriterMode = "keep" | "drop";
+export class WriteRefused extends Error {}
+
+export const MERGED_DDL = `CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS state(id INTEGER PRIMARY KEY CHECK (id = 1), blob TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS settled(seq INTEGER PRIMARY KEY AUTOINCREMENT, request_id TEXT NOT NULL UNIQUE,
+        token TEXT NOT NULL, token_sha256 TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS outbox(seq INTEGER PRIMARY KEY AUTOINCREMENT, request_id TEXT NOT NULL UNIQUE, intent TEXT NOT NULL);`;
+export const TRUSTED_ENCODING_PATH = resolve(__dirname, "../../../ts/refund-finality/encoding.ts");
+// The trusted row-log chain of this tree (the formula is in core/store.ts; the same bytes as the anchor design).
+export const trustedLinkOf = (prev: string, token: string, intent: string): string => TSTORE.linkOf(prev, token, intent);
+
+type SinkRef = { handle: number };
+export class Harness {
+  readonly E = TE;
+  readonly anchor: AnchorAdapter | null;
+  private readonly keys = generateKeyPairSync("ed25519");
+  readonly foreignKeys = generateKeyPairSync("ed25519");
+  readonly publicKeyPem: string;
+  readonly keyId: string;   // D-1 (h-key): the trusted test key's key id (encoding.ts keyIdOf); every token names it
+  readonly specLockSha256 = TE.sha256hex("h-regress test spec lock");
+  readonly checkerSha256 = TE.sha256hex("h-regress test checker");
+  remote!: Remote;
+  caps: { loadError: string; hasSink: boolean; hasDispatcher: boolean; hasGenesisOf: boolean; graph: string[]; encodingModules: string[] } =
+    { loadError: "", hasSink: false, hasDispatcher: false, hasGenesisOf: false, graph: [], encodingModules: [] };
+  // Effect-channel faults of every child of this regression (remote.ts); a non-empty list makes the regression FAIL.
+  readonly channelProblems: string[] = [];
+  dir = "";
+  private open = new Set<number>();
+  constructor(readonly sinkPath: string, readonly dispatcherPath: string, anchorPath: string | null) {
+    // eslint-disable-next-line @typescript-eslint/no-require-imports
+    this.anchor = anchorPath ? require(resolve(anchorPath)) as AnchorAdapter : null;
+    this.publicKeyPem = this.keys.publicKey.export({ type: "spki", format: "pem" }) as string;
+    this.keyId = TE.keyIdOf(this.keys.publicKey);
+  }
+  // ---- per-regression lifecycle: a fresh directory and a fresh child process
+  async begin(id: string): Promise<void> {
+    this.dir = mkdtempSync(join(tmpdir(), "forge-regress-" + id.replace(/[^A-Za-z0-9]/g, "_") + "-"));
+    await this.startChild();
+  }
+  private async startChild(): Promise<void> {
+    this.remote = new Remote(this.sinkPath, this.dispatcherPath);
+    await this.remote.ready;
+    this.caps = await this.remote.call("hello");
+    if (!this.caps.hasSink) throw new Error("module under test does not export Sink: " + this.caps.loadError);
+  }
+  private async stopChild(): Promise<void> {
+    const r = this.remote; if (!r) return;
+    try { await r.stop(); } catch { /* gone */ }
+    for (const p of r.problems.splice(0)) this.channelProblems.push(p);
+  }
+  // A PROCESS restart: the child is killed (no close) and a new child loads the modules again.
+  async restart(): Promise<void> { await this.stopChild(); this.open.clear(); await this.startChild(); }
+  async end(): Promise<void> {
+    await this.stopChild();
+    try { rmSync(this.dir, { recursive: true, force: true }); } catch { /* best effort */ }
+  }
+  path(name: string): string { return join(this.dir, name); }
+  // ---- values
+  st(chargeId: string, original: string, remaining: string, refundEnabled = true): State { return { chargeId, original, remaining, refundEnabled }; }
+  dec(s: State, amount: string): State { return { ...s, remaining: (BigInt(s.remaining) - BigInt(amount)).toString() }; }
+  intent(chargeId: string, requestId: string, amount: string, reason = "returned_item"): Intent { return { chargeId, requestId, amount, reason }; }
+  cfg(initial: State): any { return { publicKeyPem: this.publicKeyPem, specLockSha256: this.specLockSha256, checkerSha256: this.checkerSha256, initialState: initial }; }
+  async dcfg(initial: State): Promise<any> {
+    const base: any = { publicKeyPem: this.publicKeyPem, specLockSha256: this.specLockSha256, checkerSha256: this.checkerSha256, initialStateSha256: TE.stateSha256(initial) };
+    if (this.caps.hasGenesisOf) base.newLedgerH0 = await this.remote.call("genesis", { initText: TE.canon(initial), lock: this.specLockSha256, checker: this.checkerSha256, pem: this.publicKeyPem });
+    return base;
+  }
+  // ---- tokens (trusted encoding). body(): the body; signBody(): sign a body (key: trusted by default).
+  body(pre: State, requestId: string, post: State, intent: Intent): TE.TokenBody {
+    return { domain: TE.DOMAIN, specLockSha256: this.specLockSha256, checkerSha256: this.checkerSha256, preStateSha256: TE.stateSha256(pre), requestId, post, intent };
+  }
+  // D-1: a foreign-key token claims the TRUSTED key id (the strongest form of the attack).
+  signBody(body: TE.TokenBody, foreign = false, bytes?: Buffer): string {
+    const key = foreign ? this.foreignKeys.privateKey : this.keys.privateKey;
+    return TE.canon({ body, keyId: this.keyId, signature: sign(null, bytes ?? TE.signedBytes(body, this.keyId), key).toString("base64") });
+  }
+  sign(pre: State, requestId: string, post: State, intent: Intent): string { return this.signBody(this.body(pre, requestId, post, intent)); }
+  honest(pre: State, requestId: string, amount: string, reason = "returned_item"): string {
+    return this.sign(pre, requestId, this.dec(pre, amount), this.intent(pre.chargeId, requestId, amount, reason));
+  }
+  // ---- the sink under test (in the child). openSink returns null when the sink refuses to start.
+  async openSink(dbPath: string, cfg: any): Promise<{ sink: SinkRef | null; error: string }> {
+    const r = await this.remote.call<{ handle: number; error: string }>("open", { db: dbPath, cfg });
+    if (!r.handle) return { sink: null, error: r.error };
+    this.open.add(r.handle); return { sink: { handle: r.handle }, error: "" };
+  }
+  async newStore(name: string, initial: State, cfg?: any): Promise<{ db: string; sink: SinkRef }> {
+    const db = this.path(name + ".sqlite");
+    const { sink, error } = await this.openSink(db, cfg ?? this.cfg(initial));
+    if (sink === null) throw new Error("fresh store refused: " + error);
+    const i = await this.remote.call<{ error: string }>("init", { handle: sink.handle, state: initial });
+    if (i.error) throw new Error("init refused: " + i.error);
+    return { db, sink };
+  }
+  // The status word that the CHILD reports. Only the status-word cases (K4) use it for a verdict; every other
+  // verdict reads durable state.
+  async commit(sink: SinkRef | null, text: string): Promise<string> {
+    if (sink === null) return "no sink";
+    const r = await this.remote.call<{ status: string; reason?: string }>("commit", { handle: sink.handle, text });
+    return r.status === "threw" ? "threw: " + String(r.reason).slice(0, 80) : r.status;
+  }
+  async close(sink: SinkRef | null): Promise<void> { if (sink) { this.open.delete(sink.handle); await this.remote.call("close", { handle: sink.handle }); } }
+  // ---- the dispatcher under test (in the child). failAt: the emit with that index gets a failing ACK from the parent.
+  // The effects are the records that the parent's receiver got during this flush (remote.ts); failAt: the record
+  // with that index gets a failing ACK (the parent decides), so that emit call throws.
+  async flush(dbPath: string, initial: State, ledgerName = "ledger.jsonl", failAt?: number): Promise<{ effects: Effect[]; error: string }> {
+    if (!this.caps.hasDispatcher) return { effects: [], error: "no dispatcher module loaded" };
+    const r = await this.remote.flush({ db: dbPath, ledger: this.path(ledgerName), dcfg: await this.dcfg(initial) }, failAt);
+    return { effects: r.effects.map(e => ({ ...e, intent: e.intent as Intent })), error: r.error };
+  }
+  // Request ids named by the ledger lines (tolerant parser; any line that names the id counts).
+  ledgerIds(ledgerName = "ledger.jsonl"): string[] { return ledgerLineIds(this.path(ledgerName)).flat(); }
+  // ---- durable state, read by the PARENT with its own read-only connection
+  raw<X>(dbPath: string, f: (db: DatabaseSync) => X): X { const db = new DatabaseSync(dbPath, { readOnly: true }); try { return f(db); } finally { db.close(); } }
+  outbox(dbPath: string): { request_id: string; intent: Intent }[] {
