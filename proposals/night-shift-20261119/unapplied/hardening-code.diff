diff --git a/tests/refund-finality/regress/kf_old_format_refused.ts b/tests/refund-finality/regress/kf_old_format_refused.ts
new file mode 100644
index 00000000..292f31af
--- /dev/null
+++ b/tests/refund-finality/regress/kf_old_format_refused.ts
@@ -0,0 +1,48 @@
+// Regression for OWNER DECISION D-1 (c), task h-key: a token WITHOUT key_id (the format before D-1: {body, signature},
+// signature over the body bytes alone) is refused. NO MIGRATION tonight: a store that holds old-format rows is refused
+// at start (the start-up audit cannot decode its tokens) and the dispatcher sends nothing from it. That is the stated
+// effect of the format change, checked here, not a defect.
+// (1) pin {A}: an old-format token of A (a valid signature over the old signed bytes) -> rejected, 0 rows.
+// (2) the same old-format token with a keyId field added (signature over the body alone) -> rejected.
+// (3) with <old tree> (third argument): a store written by the OLD sink (rows of A, one of amount 0) -> the new sink
+//     refuses to start; the new dispatcher sends nothing.
+// CONTROL: a new-format token of A commits. SAFE = exit 0. On f67c5c16: the old format is accepted there -> FAIL.
+import { sign } from "node:crypto";
+import { join } from "node:path";
+import { argv, guard, load, memKey, sinkKit, verdict } from "./kf_lib";
+
+guard((() => {
+  const { root, old } = argv();
+  const K = sinkKit(root), A = memKey();
+  const body = (pre: any, rid: string, amount: string) => ({ domain: K.E.DOMAIN, specLockSha256: "1".repeat(64), checkerSha256: "2".repeat(64),
+    preStateSha256: K.E.stateSha256(pre), requestId: rid, post: { ...pre, remaining: (BigInt(pre.remaining) - BigInt(amount)).toString() },
+    intent: { chargeId: pre.chargeId, requestId: rid, amount, reason: "duplicate_charge" } });
+  const oldTok = (b: any) => K.E.canon({ body: b, signature: sign(null, Buffer.from(K.E.canon(b), "utf8"), A.privateKey).toString("base64") });
+  const db = join(K.dir(), "s.sqlite");
+  const s = K.open(db, { publicKeyPem: A.publicKeyPem });
+  if (typeof s === "string") verdict(false, { setup: s });
+  s.init(K.S0);
+  const st = (x: any) => x.status + (x.reason ? ": " + x.reason : "");
+  const b1 = body(K.S0, "rq_old", "100");
+  const r: any = { oldFormat: st(s.commit(oldTok(b1))) };
+  const withId = JSON.parse(oldTok(b1)); withId.keyId = A.keyId;
+  r.oldSignatureWithKeyIdAdded = st(s.commit(K.E.canon(withId)));
+  r.control = st(s.commit(K.tok(K.S0, "rq_new", "100", A)));
+  s.close();
+  r.rows = K.rows(db);
+  let pass = r.oldFormat.startsWith("rejected") && r.oldSignatureWithKeyIdAdded.startsWith("rejected") && r.control === "committed" && r.rows.join() === "rq_new";
+  if (old !== undefined) {
+    const O = load(old);
+    const odb = join(K.dir(), "old.sqlite");
+    const os = new O.SK.Sink(odb, { publicKeyPem: A.publicKeyPem, specLockSha256: "1".repeat(64), checkerSha256: "2".repeat(64), initialState: K.S0 });
+    os.init(K.S0);
+    const w = [os.commit(oldTok(b1)).status, os.commit(oldTok(body({ ...K.S0, remaining: "900" }, "rq_old_zero", "0"))).status];
+    os.close();
+    const ns = K.open(odb, { publicKeyPem: A.publicKeyPem });
+    if (typeof ns !== "string") ns.close();
+    const d = K.flush(odb, join(K.dir(), "l.jsonl"), { publicKeyPem: A.publicKeyPem }, A.publicKeyPem);
+    r.oldStore = { writtenByOldSink: w, newSink: typeof ns === "string" ? ns.slice(0, 140) : "STARTED", newDispatcher: d };
+    pass &&= w.join() === "committed,committed" && typeof ns === "string" && d.emitted.length === 0;
+  } else r.oldStore = "NOT RUN (no <old tree> argument)";
+  verdict(pass, r);
+})());
diff --git a/tests/refund-finality/regress/kf_other_uid_refused.ts b/tests/refund-finality/regress/kf_other_uid_refused.ts
new file mode 100644
index 00000000..a5f2adbe
--- /dev/null
+++ b/tests/refund-finality/regress/kf_other_uid_refused.ts
@@ -0,0 +1,26 @@
+// Regression for OWNER DECISION D-1 (b), task h-key: a key file owned by ANOTHER uid is refused.
+// A test without privileges cannot create a file of another uid (chown needs root). So the fstat result is INJECTED
+// through the test seam keyfile.ts loadSigningKeyWith(path, fstat): a parameter of an exported function that only code
+// which imports the module can pass. No command-line argument and no environment variable reaches it; minter.ts calls
+// only loadSigningKey(path) (checked below on the source text). The seam replaces st_uid by euid + 1 on the REAL stat of
+// the opened descriptor. CONTROL: the same seam with the true stat accepts (the seam alone does not refuse).
+// SAFE = exit 0. On f67c5c16: no keyfile.ts -> FAIL.
+import { fstatSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { argv, guard, load, makeKeyFile, verdict } from "./kf_lib";
+
+guard((() => {
+  const { root } = argv();
+  const { KF } = load(root);
+  if (KF === null || typeof KF.loadSigningKeyWith !== "function") verdict(false, { otherUid: "NOT AVAILABLE (no keyfile.ts)" });
+  const k = makeKeyFile();
+  const as = (uidDelta: number) => (fd: number) => { const s = fstatSync(fd); return { isFile: () => s.isFile(), uid: s.uid + uidDelta, mode: s.mode, size: s.size }; };
+  let other = "", control = "";
+  try { KF.loadSigningKeyWith(k.path, as(1)); other = "ACCEPTED"; } catch (e) { other = String((e as Error).message); }
+  try { control = KF.loadSigningKeyWith(k.path, as(0)).keyId === k.keyId ? "accepted, same key id" : "OTHER KEY"; } catch (e) { control = "REFUSED: " + String((e as Error).message); }
+  const pure = KF.keyFileProblem({ isFile: () => true, uid: 0, mode: 0o100600, size: 100 }, 501);
+  const minterSrc = readFileSync(join(root, "ts/refund-finality/minter.ts"), "utf8");
+  const seamUnreachable = !minterSrc.includes("loadSigningKeyWith") && minterSrc.includes("loadSigningKey(keyPath");
+  const r = { otherUid: other, control, pureCheckUid0vs501: pure, seamUnreachableFromMinter: seamUnreachable };
+  verdict(/not owned by the effective uid/.test(other) && control === "accepted, same key id" && /effective uid/.test(String(pure)) && seamUnreachable, r);
+})());
diff --git a/tests/refund-finality/regress/kf_positive_controls.ts b/tests/refund-finality/regress/kf_positive_controls.ts
new file mode 100644
index 00000000..12ba9e18
--- /dev/null
+++ b/tests/refund-finality/regress/kf_positive_controls.ts
@@ -0,0 +1,41 @@
+// POSITIVE CONTROLS for OWNER DECISION D-1, task h-key: legitimate refunds still commit with the key-file minter and the
+// key-id allowlist. Real minter process (memory rule "on", key FILE mode 0600), real sink, real dispatcher.
+// Charge: original = remaining = 9223372036854775807 (MaxMoney). Sink pin: issuerKeys [the file's key, active], key id
+// computed by the test (kf_lib testKeyIdOf), and it must equal the ready line's keyId.
+// z1 amount 0 -> committed; z2 amount 0 -> committed (two zero-amount refunds); the z2 token again -> replayed;
+// the LARGEST refund (amount = remaining = MaxMoney) -> committed; the dispatcher sends z1, z2, max once each.
+// A second store pinned the OLD way ({publicKeyPem} only): a zero-amount token of the same minter commits there too.
+// PASS = exit 0. On f67c5c16: the minter does not take a key file -> FAIL.
+import { join } from "node:path";
+import { active, argv, guard, makeKeyFile, sinkKit, startMinter, verdict } from "./kf_lib";
+
+guard((async () => {
+  const { root, core } = argv();
+  const MAX = "9223372036854775807";
+  const S0 = { chargeId: "ch_kfp", original: MAX, remaining: MAX, refundEnabled: true };
+  const K = sinkKit(root, S0), key = makeKeyFile();
+  const m = await startMinter(root, core, [key.path]);
+  const r: any = { ready: m.ready !== null, keyIdMatches: m.ready?.keyId === key.keyId };
+  if (m.ready === null) { m.stop(); verdict(false, { ...r, stderr: m.stderr.slice(-200) }); }
+  const ids = { specLockSha256: m.ready.specLockSha256, checkerSha256: m.ready.checkerSha256 };
+  const pin = { issuerKeys: [active(key)] };
+  const mk = (db: string, p: any): any => new K.SK.Sink(db, { ...p, ...ids, initialState: S0 });
+  const db = join(K.dir(), "s.sqlite"), s = mk(db, pin); s.init(S0);
+  const text = (a: any) => a.ok ? K.E.tokenText(a.token) : "MINT REFUSED: " + a.reason;
+  const c = (t: string) => t.startsWith("MINT") ? t : s.commit(t).status;
+  const z1 = text(await m.mint(S0, "rq_z1", "0")); r.z1 = c(z1);
+  const z2 = text(await m.mint(S0, "rq_z2", "0")); r.z2 = c(z2);
+  r.z2Again = c(z2);
+  const big = text(await m.mint(S0, "rq_max", MAX)); r.largest = c(big);
+  r.state = JSON.parse(s.stateBlob()).remaining;
+  s.close();
+  const effects: string[] = [];
+  const dcfg = { ...pin, ...ids, initialStateSha256: K.E.stateSha256(S0), newLedgerH0: K.SK.genesisOf(K.E.canon(S0), ids.specLockSha256, ids.checkerSha256, key.publicKeyPem) };
+  const f = new K.D.Dispatcher(db, join(K.dir(), "l.jsonl"), dcfg, (e: any) => effects.push(e.requestId)).flush();
+  r.dispatched = effects; r.refused = f.refused.length;
+  const db2 = join(K.dir(), "legacy.sqlite"), s2 = mk(db2, { publicKeyPem: m.ready.publicKeyPem }); s2.init(S0);
+  r.legacyPinZero = s2.commit(text(await m.mint(S0, "rq_legacy_zero", "0"))).status; s2.close();
+  m.stop();
+  verdict(r.keyIdMatches && r.z1 === "committed" && r.z2 === "committed" && r.z2Again === "replayed" && r.largest === "committed" && r.state === "0" &&
+    effects.join() === "rq_z1,rq_z2,rq_max" && r.refused === 0 && r.legacyPinZero === "committed", r);
+})());
