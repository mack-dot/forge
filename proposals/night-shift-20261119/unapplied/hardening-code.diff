+  { id: "C4-replay-rejected", kind: "control", title: "a replay is not a second effect",
+    async run(h) { const S0 = h.st("ch_1", "1000", "1000"); const { db, sink } = await h.newStore("c4", S0);
+      const t = h.honest(S0, "rq_1", "100"); const r1 = await h.commit(sink, t); const f1 = await h.flush(db, S0);
