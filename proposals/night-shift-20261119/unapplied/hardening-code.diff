--- /dev/null
+++ b/tests/refund-finality/regress/x5_hostile_writer_store.ts
@@ -0,0 +1,59 @@
+// X5 HOSTILE DATABASE WRITER. Attack class: a writer of the database file (WITHOUT the signing key) changes the
+// store under a running sink.
+// Evidence: unsure U554; results/night-shift-20261119/orch-B/r-repairs/attack_v4.ts (S1, S2) and
+// r-repairs/logs/attack_v4.1.log.
+// Assumption: another process can write the SQLite file (raw SQL from a second connection). Two writer strengths
+// (harness.ts twoWriters): if the database refuses the write of the writer that keeps the schema, that refusal is
+// the safe outcome for it, and the verdict comes from the writer that drops and restores the triggers. The signer is honest:
+// it signs for the state that the sink has stored (it reads the store).
+// X5a balance reset: rq_1 refunds 1000 of 1000; the writer resets `remaining` to 1000; the honest issuer then signs
+//   rq_2 for 1000 on that stored state.
+//   EXPECTED SAFE OUTCOME: the sum of the outbox intent amounts is at most the original 1000, AND the sum of the
+//   emitted amounts is at most 1000. Unsafe on the merged sink: the outbox holds 2000 for a charge of 1000 (the
+//   merged dispatcher's chain check still stops the second effect: the unsafe part is the durable state).
+// X5b outbox rewrite: rq_1 refunds 100; the writer rewrites rq_1's outbox amount to 1; the issuer signs rq_2.
+//   EXPECTED SAFE OUTCOME: every emitted intent equals a signed intent, AND the sink does not settle rq_2 on top of
+//   a store whose outbox row differs from its signed intent (while the rewritten row is present, rq_2 has no outbox
+//   row). Unsafe on the merged sink: rq_2 is settled on the tampered store.
+import { Harness, Regression, WriterMode, fail, pass, sum, twoWriters } from "./harness";
+
+export const regressionA: Regression = {
+  id: "X5a-hostile-balance-reset", kind: "attack", title: "writer resets the balance, second full refund",
+  run: (h: Harness) => twoWriters(h, "X5a", async (h: Harness, mode: WriterMode) => {
+    const S0 = h.st("ch_1", "1000", "1000");
+    const { db, sink } = await h.newStore("x5a", S0);
+    const c1 = await h.commit(sink, h.honest(S0, "rq_1", "1000"));
+    const f1 = await h.flush(db, S0);
+    h.write(db, d => { d.prepare("UPDATE state SET blob = ? WHERE id = 1").run(h.E.canon(S0)); }, mode);
+    const cur = h.stored(db)!;
+    const c2 = await h.commit(sink, h.honest(cur, "rq_2", cur.remaining));
+    const f2 = await h.flush(db, S0);
+    const out = sum(h.outbox(db).map(o => o.intent.amount));
+    const eff = sum([...f1.effects, ...f2.effects].map(e => e.intent.amount));
+    const why = `rq_1=${c1} rq_2=${c2} outboxTotal=${out} emittedTotal=${eff} original=1000`;
+    if (c1 !== "committed") return fail("setup: honest rq_1 refused: " + why);
+    return out > 1000n || eff > 1000n ? fail("OVER-REFUND: " + why) : pass(why);
+  }),
+};
+export const regressionB: Regression = {
+  id: "X5b-hostile-outbox-rewrite", kind: "attack", title: "writer rewrites an outbox amount, sink goes on",
+  run: (h: Harness) => twoWriters(h, "X5b", async (h: Harness, mode: WriterMode) => {
+    const S0 = h.st("ch_1", "1000", "1000");
+    const { db, sink } = await h.newStore("x5b", S0);
+    const t1 = h.honest(S0, "rq_1", "100");
+    const c1 = await h.commit(sink, t1);
+    h.write(db, d => { d.prepare("UPDATE outbox SET intent = ? WHERE request_id = 'rq_1'").run(h.E.canon(h.intent("ch_1", "rq_1", "1"))); }, mode);
+    const cur = h.stored(db)!;
+    const t2 = h.honest(cur, "rq_2", "100");
+    const c2 = await h.commit(sink, t2);
+    const f = await h.flush(db, S0);
+    const signed = new Set([h.intent("ch_1", "rq_1", "100"), h.intent("ch_1", "rq_2", "100")].map(i => h.E.canon(i)));
+    const foreignEff = f.effects.filter(e => !signed.has(h.E.canon(e.intent))).length;
+    const ob = h.outbox(db);
+    const tampered = ob.some(o => o.request_id === "rq_1" && o.intent.amount !== "100");
+    const settledOnTamper = tampered && ob.some(o => o.request_id === "rq_2");
+    const why = `rq_1=${c1} rq_2=${c2} unsignedEffects=${foreignEff} rewrittenRowPresent=${tampered} rq_2SettledOnIt=${settledOnTamper}`;
+    if (c1 !== "committed") return fail("setup: honest rq_1 refused: " + why);
+    return foreignEff > 0 || settledOnTamper ? fail("TAMPERED STORE EXTENDED: " + why) : pass(why);
+  }),
+};
diff --git a/tests/refund-finality/regress/x6_zero_row_and_prefix_rollback.ts b/tests/refund-finality/regress/x6_zero_row_and_prefix_rollback.ts
new file mode 100644
index 00000000..22f2dcaf
--- /dev/null
+++ b/tests/refund-finality/regress/x6_zero_row_and_prefix_rollback.ts
@@ -0,0 +1,73 @@
+// X6 ROW DELETION BY A DATABASE WRITER. Evidence: unsure U565; results/night-shift-20261119/orch-B/r-v5/ts/attack_rv5.ts
+// (Z1-middle-zero-row-deleted, P1-prefix-rollback-last-row).
+// Assumption: a writer of the database file WITHOUT the signing key; the sink is restarted after the change.
+// X6-Z1 zero-amount row deletion, then re-commit. Honest store: rq_1 (100), rq_z1 (0), rq_z2 (0), all dispatched.
+//   The writer deletes rq_z1's settled and outbox rows (a zero row does not move the balance, so the chain of
+//   states stays valid). After a restart the same rq_z1 token is delivered again.
+//   EXPECTED SAFE OUTCOME: rq_z1 is not settled a second time (at the end the outbox holds no rq_z1 row) and the
+//   dispatcher emits rq_z1 at most once in total. Refusing to start or to commit is safe.
+//   Unsafe: merged sink AND the v6 draft (the review's finding F1): rq_z1 is settled again.
+// X6-P1 prefix rollback (a STATED LIMIT, not fixable inside the database). Honest store: rq_1 (100), rq_2 (50),
+//   dispatched. The writer deletes rq_2's rows and restores the state before rq_2: a valid earlier prefix.
+//   THREE OUTCOMES (kind "limit"; red-team finding C-JUDGE-02: a limit test must accept the safe outcome):
+//     without an anchor: the sink refuses to start or refuses to settle rq_2 again = SAFE (PASS); the sink settles
+//       rq_2 again = the stated limit (KNOWN-LIMIT); anything else (a second effect for rq_2, a refused honest
+//       setup, a crash of the judge's child) = FAIL;
+//     with an anchor adapter (runner argument expectedHeadMode): refusing = PASS; settling rq_2 again = FAIL.
+//   In every mode the dispatcher emits rq_2 at most once (its ledger is outside the database).
+// Both cases run with two writer strengths (harness.ts twoWriters): a write that the database refuses is the safe
+// outcome for the writer that keeps the schema; the verdict then comes from the writer that drops the triggers.
+import { AnchorAdapter, Harness, Regression, WriterMode, fail, knownLimit, pass, twoWriters } from "./harness";
+
+export const regressionZ1: Regression = {
+  id: "X6-Z1-zero-row-deleted-recommitted", kind: "attack", title: "deleted zero-amount row committed again",
+  run: (h: Harness) => twoWriters(h, "X6-Z1", async (h: Harness, mode: WriterMode) => {
+    const S0 = h.st("ch_1", "1000", "1000"), S1 = h.dec(S0, "100");
+    const { db, sink } = await h.newStore("z1", S0);
+    const tz1 = h.honest(S1, "rq_z1", "0", "duplicate_charge");
+    const cs = [await h.commit(sink, h.honest(S0, "rq_1", "100")), await h.commit(sink, tz1), await h.commit(sink, h.honest(S1, "rq_z2", "0", "duplicate_charge"))];
+    const f1 = await h.flush(db, S0);
+    await h.close(sink);
+    if (cs.some(c => c !== "committed")) return fail("setup: honest commits refused: " + cs.join(","));
+    h.write(db, d => d.exec("DELETE FROM settled WHERE request_id = 'rq_z1'; DELETE FROM outbox WHERE request_id = 'rq_z1'"), mode);
+    await h.restart();                                   // a process restart of the sink
+    const { sink: s2, error } = await h.openSink(db, h.cfg(S0));
+    let r = "sink refused to start (" + error.slice(0, 60) + ")";
+    if (s2 !== null) { r = await h.commit(s2, tz1); await h.close(s2); }
+    const f2 = await h.flush(db, S0);
+    const again = h.outbox(db).filter(o => o.request_id === "rq_z1").length;
+    const eff = [...f1.effects, ...f2.effects].filter(e => e.intent.requestId === "rq_z1").length;
+    const why = `honest=${cs.join(",")} redelivery=${r} outbox(rq_z1)=${again} effects(rq_z1)=${eff}`;
+    return again > 0 || eff > 1 ? fail("RE-SETTLED AFTER DELETION: " + why) : pass(why);
+  }),
+};
+export const regressionP1: Regression = {
+  id: "X6-P1-prefix-rollback", kind: "limit", title: "rollback to a valid earlier prefix",
+  run: (h: Harness) => twoWriters(h, "X6-P1", async (h: Harness, mode: WriterMode) => {
+    const S0 = h.st("ch_1", "1000", "1000"), S1 = h.dec(S0, "100");
+    const { db, sink } = await h.newStore("p1", S0);
+    const t2 = h.honest(S1, "rq_2", "50");
+    const cs = [await h.commit(sink, h.honest(S0, "rq_1", "100")), await h.commit(sink, t2)];
+    const f1 = await h.flush(db, S0);
+    await h.close(sink);
+    if (cs.some(c => c !== "committed")) return fail("setup: honest commits refused: " + cs.join(","));
+    const adapter: AnchorAdapter | null = h.anchor;
+    const head = adapter ? adapter.capture(h, db) : undefined;
+    h.write(db, d => {
+      d.exec("DELETE FROM settled WHERE request_id = 'rq_2'; DELETE FROM outbox WHERE request_id = 'rq_2'");
+      d.prepare("UPDATE state SET blob = ? WHERE id = 1").run(h.E.canon(S1));
+    }, mode);
+    await h.restart();
+    const cfg = adapter ? adapter.apply(h.cfg(S0), head) : h.cfg(S0);
+    const { sink: s2, error } = await h.openSink(db, cfg);
+    let r = "not delivered";
+    if (s2 !== null) { r = await h.commit(s2, t2); await h.close(s2); }
+    const f2 = await h.flush(db, S0);
+    const resettled = h.outbox(db).some(o => o.request_id === "rq_2");
+    const eff = [...f1.effects, ...f2.effects].filter(e => e.intent.requestId === "rq_2").length;
+    const why = `mode=${adapter ? "anchored" : "no-anchor"} honest=${cs.join(",")} started=${s2 !== null}${s2 ? "" : " (" + error.slice(0, 50) + ")"} redelivery=${r} resettled=${resettled} effects(rq_2)=${eff}`;
+    if (eff > 1) return fail("DUPLICATE EFFECT: " + why);
+    if (!resettled) return pass("SAFE: the rollback is refused or rq_2 is not settled again: " + why);
+    return adapter ? fail("ROLLBACK ACCEPTED WITH AN ANCHOR: " + why) : knownLimit("documented limit holds (no anchor; rq_2 settled again, emitted at most once): " + why);
+  }),
+};
diff --git a/tests/refund-finality/spec-conformance/README.md b/tests/refund-finality/spec-conformance/README.md
new file mode 100644
index 00000000..57acda45
--- /dev/null
+++ b/tests/refund-finality/spec-conformance/README.md
@@ -0,0 +1,72 @@
+# Spec conformance of refund sinks
+
+These files test a REAL sink against an oracle built only from the APPROVED refund specification
+(`spec/refund/RefundSpec.dfy`, `spec/refund/protocol.md`) and the compiled approved `Refund.Assess`.
+They do not compare one model with another model. The property list with its sources is `SPEC_ORACLE.md`.
+Status: TESTED-UNPROVED. Nothing here is a proof.
+
+| Id | Property (short) | Source | Responsible |
+|----|------------------|--------|-------------|
+| P1 | every effect is the one intent that Assess authorizes on the persisted charge | RS 33-36, 48-58; PR 22-24, 68-70 | sink |
+| P2 | at most one effect per (charge id, request id) | PR 61, 63-65 | sink |
+| P3 | state evolves by POST-RULE (unratified); 0 <= remaining <= original <= MaxMoney | RS 27-31; PR 18; evolution SILENT | sink |
+| P4 | sum of effects of a charge <= its original | derived (R1 + POST-RULE); PR 89-92; sum rule SILENT | sink |
+| P5 | no extra rejection of a valid, fresh, current, authorized token (zero included) | PR 22-27, 79; RS 50-52; token checks SILENT | sink |
+| P6 | a rejected or replayed delivery changes no durable state | PR 28-30, 63-64 | sink |
+| P7 | effects carry the persisted charge id | RS 53, 59-63; PR 15-17 | sink |
+| P6R | an identical repeat of a committed token answers `replayed`; another token for a settled id answers `rejected` | PR 63-65 | sink |
+| P8 | AUTHENTICITY OF COMMITS: a commit is the canonical text of a token that verifies under the PINNED key with the pinned ids over the TRUSTED signed bytes, with the current pre-state hash; the store records its signed request id, intent and post | Slice 1 finality design (sink.ts checks 1-4); the approved protocol.md is SILENT on tokens | sink |
+| P9 | a restart of the sink changes no durable state | Slice 1 design (durable store); PR 89-90 "durable" | sink |
+| P1/P2/P4 on emissions | every emitted effect is an outbox intent; at most one per (charge id, request id); emitted sum <= original | as P1, P2, P4 | dispatcher (with `--dispatcher`) |
+
+Unratified choices that the oracle uses: OPEN-IS-UNSETTLED, POST-RULE.
+
+## Files
+- `oracle.ts`: replays a history (initial charge, deliveries with outcomes, restarts, snapshot after each, and
+  optionally the dispatcher's emitted effects) and checks P1-P9. Imports only the TRUSTED
+  `ts/refund-finality/encoding.ts` of its own tree and the compiled approved module (by path).
+- `run.ts`: seeded generator and driver. The sink (and with `--dispatcher` the dispatcher) runs in ONE CHILD
+  process (`../regress/worker.ts`) for the whole run; the driver never loads it. The driver delivers sequences
+  over IPC, reads the durable state through its own read-only SQLite connection, calls the oracle, prints one
+  JSON line. A child that exits or stops answering ends the run with exit 1 (field `childGone`).
+  With `--dispatcher`, the EFFECT RECEIVER is held by the driver (task h-judges2; `../regress/remote.ts`): each emit
+  call of the dispatcher under test is a record on a pipe that the driver created, ACKed by the driver before the call
+  returns; the emitted effects that the oracle checks are the records that the driver got, never a child report. A
+  channel fault (a record outside a flush, a line that is not a record, a pipe held open after the child died) makes
+  the run NOT OK (field `effectChannelProblems`). Remaining trust: OUT-OF-BAND-EFFECT, IN-PROCESS-TAMPER (see
+  `../regress/README.md`).
+- `selftest.ts`: hand-made histories with a known violation of P1-P9 and of the emission checks, a start
+  refusal, and clean histories (21 cases).
+- `heavy_spec.sh`: the heavy run (5,000 sequences per mode per sink). It refuses while hol.lock exists or a
+  HOL process runs. It does not take heavy.lock.
+
+## Build the compiled approved module
+As in `scripts/exit_slice1.py` (`sink_controls`):
+`dafny build impl/RefundFinality.dfy --target js --output <dir>/model <gate options>`, then
+`<dir>/model.cjs` = `<dir>/model.js` + `\nmodule.exports = { RefundFinality, Refund, runtime: _dafny };\n`.
+The oracle uses only `Refund` (`Refund.__default.Assess`, `Refund.Context`, `Refund.ModelResponse`).
+
+## Run (pinned Node 24.3.0 first in PATH; from the repository root)
+- `node --import tsx tests/refund-finality/spec-conformance/selftest.ts <model.cjs>` (exit 0 = all cases pass)
+- `node --import tsx tests/refund-finality/spec-conformance/run.ts <sink.ts> <seq|fault|interleave> <count> <seed> <model.cjs> [workDir] [--dispatcher <dispatcher.ts>] [--expect-violations P1,P2,...]`
+  - EXIT CODE: 0 only when all sequences ran, the child stayed alive, and the set of violated properties
+    (P5-SILENT excluded: a question for the owner, not a verdict) is empty, or equals `--expect-violations`.
+    1 otherwise. 2 on a usage error.
+  - Baseline for the merged sink (branch head): `--expect-violations P1,P2,P3,P4,P7` (seq 200 1 with the merged
+    dispatcher: exit 0). The v6 draft and the hardened sink: no flag (seq 200 1: exit 0).
+  - Also generated: restarts of the sink (6 % of steps), stores with 21-35 deliveries (10 %), request ids with
+    40 extra units, non-ASCII BMP, non-BMP and combining characters, and non-canonical token texts (kind noncanon).
+  - A sink that refuses to start on a valid initial charge (an approved ValidContext) is a P5 violation; a refusal
+    of a charge with refundEnabled false is not (no token for it can be authorized; RS 27-31).
+  - delivery kinds: honest (random, zero, amount = remaining), replay, stale, wrong signature, wrong pinned
+    spec lock, reused request id, and FAULTY-SIGNER tokens signed by the trusted test key: request-id mismatch,
+    foreign charge in the intent, foreign post-state, amount above remaining (post remaining 0, or post
+    unchanged), unapproved reason, refund while refundEnabled is false, post original above MaxMoney; probes:
+    request id of 300+ units, request id with U+0000.
+  - fault: a storage write throws inside the sink's transaction (30 % of deliveries). P5 is not demanded there.
+  - interleave: two sink instances on one database file in one process (alternation, not concurrency).
+  - Output fields: `sequencesWithViolation` (per property), `violated`, `verdict`, `childGone`, `sequencesDone`,
+    `violationsByKind`, `smallest` (shortest prefix that shows each property), `kindOutcome`, input SHA-256 values
+    (sink, dispatcher, trusted encoding, core).
+- `bash tests/refund-finality/spec-conformance/heavy_spec.sh <model.cjs> <outDir> <sink>...` (a nonzero status now
+  means: some property is violated or a run did not complete; read results.jsonl).
