index 00000000..e27a4ac3
--- /dev/null
+++ b/tests/refund-finality/regress/d_att18_throwing_emit.ts
@@ -0,0 +1,35 @@
+// Regression C-ATT-18 (a lost effect looked like a sent one). The payment adapter (emit) throws for r1 BEFORE it sends
+// anything. SAFE, part 1: no later run counts r1 as dispatched; every later run reports r1 under its own id (refused or
+// in doubt) until a person decides. FAILS on the unfixed dispatcher (the retry counts r1 in alreadyDispatched, silently).
+// Part 2 (the recovery, only when part 1 holds): the person asks the receiver (it has nothing) and calls
+// resolveInDoubt("r1", "retry"); the next run emits r1 exactly once; a further run emits nothing. Total <= 1000.
+// Usage and exit codes: d_lib.ts.
+import { argv, dups, guard, total, verdict, world } from "./d_lib";
+guard((async () => {
+  const { root, core } = argv();
+  const S0 = { chargeId: "ch_d18", original: "1000", remaining: "1000", refundEnabled: true };
+  const w = await world(root, core, S0);
+  const t1 = await w.mint(S0, "r1", "400"); w.commit(t1.text);
+  const t2 = await w.mint(t1.post, "r2", "100"); w.commit(t2.text);
+  let run1 = "";
+  try { run1 = JSON.stringify(w.flush(e => { if (e.requestId === "r1") throw new Error("adapter: connection refused (nothing sent)"); w.effects.push(e); })); }
+  catch (err) { run1 = "threw: " + (err as Error).message; }
+  const r2 = w.flush(), r3 = w.flush();
+  const reported = (r: any) => r.refused.some((x: any) => x.requestId === "r1");
+  const part1 = !w.effects.some(e => e.requestId === "r1") && reported(r2) && reported(r3) && r3.alreadyDispatched === 1;
+  let part2 = false, recovery = "not tried (part 1 failed)";
+  if (part1) {
+    const d = w.dispatcher();
+    if (typeof d.resolveInDoubt !== "function") recovery = "no resolveInDoubt";
+    else {
+      d.resolveInDoubt("r1", "retry", "receiver has no r1 (test)");
+      const r4 = w.flush(), r5 = w.flush();
+      const ids = w.effects.map(e => e.requestId);
+      part2 = dups(ids).length === 0 && ids.includes("r1") && r5.emitted.length === 0 && r5.refused.length === 0 && r5.alreadyDispatched === 2 && total(w.effects) <= 1000;
+      recovery = JSON.stringify({ r4: r4.emitted.map((e: any) => e.requestId), r5: { emitted: r5.emitted.length, refused: r5.refused.length, already: r5.alreadyDispatched }, ids });
+    }
+  }
+  w.stop();
+  verdict(part1 && part2, { run1: run1.slice(0, 200), run2: { refused: r2.refused.map((x: any) => x.requestId), already: r2.alreadyDispatched },
+    run3: { refused: r3.refused.map((x: any) => x.requestId), already: r3.alreadyDispatched }, part1, recovery });
+})());
diff --git a/tests/refund-finality/regress/d_att19_ledger_restore.ts b/tests/refund-finality/regress/d_att19_ledger_restore.ts
new file mode 100644
index 00000000..4044cc46
--- /dev/null
+++ b/tests/refund-finality/regress/d_att19_ledger_restore.ts
@@ -0,0 +1,45 @@
+// Regression C-ATT-19 (an OLDER ledger re-emits; the rollback class). r1 is dispatched; a backup of the folder is
+// taken; r2, r3 commit and are dispatched. Then:
+//   case L: only the ledger file is restored from the backup (database current).
+//   case F: the whole folder is restored (database, ledger, every other file in it), the host retries r2 and r3 with the
+//           SAME tokens (the sink commits them again: no sink anchor), and the dispatcher config carries the outside
+//           anchor cfg.ledgerFloor = the ledgerHead of the run that sent r2, r3 (kept on another medium).
+// SAFE: in both cases no request id is emitted twice and the total is at most 1000. FAILS on the unfixed dispatcher
+// (both cases emit r2, r3 again: 1400 of 1000). NOT covered (stated limit): case F WITHOUT an outside anchor.
+// Usage and exit codes: d_lib.ts.
+import { copyFileSync, existsSync, mkdirSync, readdirSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { argv, dups, guard, total, verdict, world } from "./d_lib";
+const S0 = { chargeId: "ch_d19", original: "1000", remaining: "1000", refundEnabled: true };
+async function one(root: string, core: string, kase: "L" | "F") {
+  const w = await world(root, core, S0);
+  const t1 = await w.mint(S0, "r1", "400"); w.commit(t1.text); w.flush();
+  w.closeSink();
+  const bk = join(w.dir, "backup"); mkdirSync(bk);
+  const files = () => readdirSync(w.dir).filter(f => f !== "backup" && f !== "ctl" && !/-(wal|shm|journal)$/.test(f) && !f.endsWith(".lock"));
+  for (const f of files()) copyFileSync(join(w.dir, f), join(bk, f));
+  w.reopen();
+  const t2 = await w.mint(t1.post, "r2", "400"); w.commit(t2.text);
+  const t3 = await w.mint(t2.post, "r3", "100"); w.commit(t3.text);
+  const r = w.flush();
+  const anchor = r.ledgerHead;                       // kept outside (undefined on the unfixed dispatcher)
+  w.closeSink();
+  if (kase === "L") copyFileSync(join(bk, "ledger.jsonl"), w.ledger);
+  else {
+    for (const f of files()) if (!existsSync(join(bk, f))) rmSync(join(w.dir, f));
+    for (const f of readdirSync(bk)) copyFileSync(join(bk, f), join(w.dir, f));
+    for (const x of ["-wal", "-shm", "-journal"]) if (existsSync(w.db + x)) rmSync(w.db + x);
+  }
+  w.reopen();
+  if (kase === "F") { w.commit(t2.text); w.commit(t3.text); }
+  let last = "";
+  try { last = JSON.stringify(w.flush(undefined, w.ledger, kase === "F" ? { ...w.dcfg, ledgerFloor: anchor } : w.dcfg)); } catch (e) { last = "stopped: " + (e as Error).message; }
+  w.stop();
+  const ids = w.effects.map(e => e.requestId);
+  return { ok: dups(ids).length === 0 && total(w.effects) <= 1000, ids, total: total(w.effects), last: last.slice(0, 200) };
+}
+guard((async () => {
+  const { root, core } = argv();
+  const L = await one(root, core, "L"), F = await one(root, core, "F");
+  verdict(L.ok && F.ok, { caseL: L, caseF: F });
+})());
diff --git a/tests/refund-finality/regress/d_att20_blob_request_id.ts b/tests/refund-finality/regress/d_att20_blob_request_id.ts
new file mode 100644
index 00000000..c1486a62
--- /dev/null
+++ b/tests/refund-finality/regress/d_att20_blob_request_id.ts
@@ -0,0 +1,31 @@
+// Regression C-ATT-20 (a BLOB-typed outbox request_id was skipped silently). A file writer WITHOUT the key, who can
+// bypass the store's safeguards (drop the append-only trigger, ignore CHECK constraints, put the trigger back with the
+// same text), turns the committed r2's outbox request_id into a BLOB with the same bytes. Nothing is dispatched yet.
+// SAFE: the run either stops with an error (alarm), or reports every committed id (r1, r2) EXACTLY (emitted, or refused
+// under its own id); nothing is counted as already dispatched; nothing is emitted twice. FAILS on the unfixed
+// dispatcher (r2 is refused under the text "114,50", i.e. under no committed id). Usage and exit codes: d_lib.ts.
+import { DatabaseSync } from "node:sqlite";
+import { argv, dups, guard, verdict, world } from "./d_lib";
+guard((async () => {
+  const { root, core } = argv();
+  const S0 = { chargeId: "ch_d20", original: "1000", remaining: "1000", refundEnabled: true };
+  const w = await world(root, core, S0);
+  const t1 = await w.mint(S0, "r1", "400"); w.commit(t1.text);
+  const t2 = await w.mint(t1.post, "r2", "100"); w.commit(t2.text);
+  w.closeSink();
+  const db = new DatabaseSync(w.db);
+  const trig = (db.prepare("SELECT sql FROM sqlite_master WHERE type = 'trigger' AND name = 'h_outbox_bu'").get() as { sql?: string } | undefined)?.sql;
+  db.exec("PRAGMA ignore_check_constraints = ON");
+  if (trig) db.exec("DROP TRIGGER h_outbox_bu");
+  db.exec("UPDATE outbox SET request_id = CAST(request_id AS BLOB) WHERE request_id = 'r2'");
+  if (trig) db.exec(trig);
+  const rows = db.prepare("SELECT seq, typeof(request_id) AS t, hex(request_id) AS h FROM outbox").all();
+  db.close();
+  let r: any = null, stopped = "";
+  try { r = w.flush(); } catch (e) { stopped = (e as Error).message; }
+  w.stop();
+  const ids = w.effects.map(e => e.requestId);
+  const exact = (id: string) => ids.includes(id) || (r !== null && r.refused.some((x: any) => x.requestId === id));
+  const pass = dups(ids).length === 0 && (stopped !== "" || (exact("r1") && exact("r2") && r.alreadyDispatched === 0));
+  verdict(pass, { outbox: rows, emitted: ids, refused: r?.refused?.map((x: any) => x.requestId + ": " + String(x.reason).slice(0, 90)), already: r?.alreadyDispatched, stopped: stopped.slice(0, 200) });
+})());
diff --git a/tests/refund-finality/regress/d_att22_short_write.ts b/tests/refund-finality/regress/d_att22_short_write.ts
new file mode 100644
index 00000000..36e20068
--- /dev/null
+++ b/tests/refund-finality/regress/d_att22_short_write.ts
@@ -0,0 +1,40 @@
+// Regression C-ATT-22 (a short ledger write; attacker: none: disk full, quota, file-size limit). The file system takes
+// only half of the first ledger line for r1 and then refuses further bytes (ENOSPC), as a real RLIMIT_FSIZE or
+// full-disk run did (322 of 351 bytes, no error). Simulated in process: node:fs writeSync is wrapped (CommonJS export,
+// as tsx loads the dispatcher); the first ledger line of r1 is cut in half; from then on every write fails.
+// SAFE: run 1 emits nothing for r1 (its record is incomplete); after space returns, run 2 needs no manual edit: it
+// emits r1 and r2 exactly once; run 3 emits nothing and refuses nothing. FAILS on the unfixed dispatcher (r1 leaves
+// with a torn ledger line; every later run stops). Usage and exit codes: d_lib.ts.
+import { argv, dups, guard, total, verdict, world } from "./d_lib";
+// eslint-disable-next-line @typescript-eslint/no-require-imports
+const fs = require("node:fs");
+guard((async () => {
+  const { root, core } = argv();
+  const S0 = { chargeId: "ch_d22", original: "1000", remaining: "1000", refundEnabled: true };
+  const w = await world(root, core, S0);
+  const t1 = await w.mint(S0, "r1", "300"); w.commit(t1.text);
+  const t2 = await w.mint(t1.post, "r2", "200"); w.commit(t2.text);
+  const original = fs.writeSync;
+  let full = false, cut = 0;
+  fs.writeSync = function (fd: number, data: any, a?: any, b?: any, ...rest: any[]) {
+    const bytes: Buffer = typeof data === "string" ? Buffer.from(data, "utf8")
+      : Buffer.from(data.buffer, data.byteOffset + (typeof a === "number" ? a : 0), typeof b === "number" ? b : data.length - (typeof a === "number" ? a : 0));
+    if (full) { const e: any = new Error("ENOSPC: no space left on device, write"); e.code = "ENOSPC"; throw e; }   // the disk is full: every write
+    if ((bytes.includes("preStateSha256") || bytes.includes("\"kind\"")) && bytes.includes("\"r1\"")) {
+      full = true; cut = Math.floor(bytes.length / 2); return original.call(fs, fd, bytes, 0, cut);   // the first r1 ledger line: half
+    }
+    return original.call(fs, fd, data, a, b, ...rest);
+  };
+  let run1 = "";
+  try { run1 = JSON.stringify(w.flush()); } catch (e) { run1 = "stopped: " + (e as Error).message; }
+  const afterRun1 = w.effects.map(e => e.requestId);
+  fs.writeSync = original; full = false;
+  let run2: any = null, run3: any = null, err = "";
+  try { run2 = w.flush(); run3 = w.flush(); } catch (e) { err = (e as Error).message; }
+  w.stop();
+  const ids = w.effects.map(e => e.requestId);
+  const pass = cut > 0 && !afterRun1.includes("r1") && run2 !== null && run3 !== null && dups(ids).length === 0 &&
+    ids.includes("r1") && ids.includes("r2") && run3.emitted.length === 0 && run3.refused.length === 0 && total(w.effects) <= 1000;
+  verdict(pass, { cut, run1: run1.slice(0, 160), afterRun1, effects: ids, run2: run2 && { emitted: run2.emitted.map((e: any) => e.requestId), refused: run2.refused.length, torn: run2.tornTailCut ?? null },
+    run3: run3 && { emitted: run3.emitted.length, refused: run3.refused.length, already: run3.alreadyDispatched }, err: err.slice(0, 160) });
+})());
diff --git a/tests/refund-finality/regress/d_child.ts b/tests/refund-finality/regress/d_child.ts
