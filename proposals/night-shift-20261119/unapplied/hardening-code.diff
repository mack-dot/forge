+  { id: "C5-largest-refund", kind: "control", title: "amount == remaining commits",
+    async run(h) { const S0 = h.st("ch_1", "1000", "1000"); const { db, sink } = await h.newStore("c5", S0);
+      const r1 = await h.commit(sink, h.honest(S0, "rq_1", "250")); const S1 = h.stored(db)!;
+      const r2 = await h.commit(sink, h.honest(S1, "rq_all", S1.remaining, "service_not_delivered")); const f = await h.flush(db, S0);
