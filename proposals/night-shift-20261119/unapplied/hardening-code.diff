index 00000000..91f3d5d0
--- /dev/null
+++ b/tests/refund-finality/regress/p3_in_progress.ts
@@ -0,0 +1,35 @@
+// h-provider3 regression for the worker report "in progress" (red team summary item 5b; attacker: none).
+// Phase 1: r1 300; the provider moves the money and answers in_progress (twice); the adapter has no retry (retries 0).
+//   Required: the journal never says "refused" for r1 (money moved); the dispatcher reports r1 in doubt; no "paid" line.
+// Phase 2: r2 200; the provider moves the money and answers in_progress once; the adapter retries once with the same key
+//   and gets the replayed result: "replayed" (paid before), r2 emitted.
+// Phase 3: a person reconciles r1 later (calls the adapter with the outbox row; the key is no longer in progress):
+//   the provider replays the first result: "replayed"; no second movement.
+// Old adapter: in_progress is not in its retry list -> "refused:in_progress" while money moved (T5): exit 1.
+// New adapter: exit 0. Usage and exit codes: p3_lib.ts.
+import { journalOf, root, truth, verdict } from "./p3_lib";
+import { guard, world } from "./p_lib";
+guard(() => {
+  const tree = root();
+  const w = world(tree, "b", "none", { chargeId: "ch_ip", original: "1000", remaining: "1000", refundEnabled: true }, { retries: 0 });
+  const c1 = w.refund("r1", "300"); w.provider.inject(w.keyOf("r1", "300"), "in_progress_after_money", 2);
+  const f1 = w.flush();
+  const c2 = w.refund("r2", "200"); w.provider.inject(w.keyOf("r2", "200"), "in_progress_after_money", 1); w.setRetries(1);
+  const f2 = w.flush();
+  if (c1.status !== "committed" || c2.status !== "committed") { console.error("SETUP FAILED"); process.exit(3); }
+  const problems: string[] = [];
+  const j1 = journalOf(w).filter(j => j.requestId === "r1").map(j => String(j.outcome));
+  if (j1.some(o => o.startsWith("refused") || o === "paid" || o === "replayed")) problems.push("r1 journal before reconcile: " + j1.join(","));
+  if (!f2.refused.some(x => x.startsWith("r1: in doubt"))) problems.push("dispatcher does not report r1 in doubt: " + JSON.stringify(f2.refused));
+  if (!f2.emitted.includes("r2")) problems.push("r2 not emitted after its retry: " + JSON.stringify(f2));
+  // Phase 3: reconcile r1 (w.provider still answers in_progress once more for r1 -> the adapter has 1 retry).
+  const row = w.outboxIntents().find(r => r.requestId === "r1")!;
+  let rec = "returned"; try { w.emit({ requestId: "r1", intent: w.E.canon(row.intent) }, row.intent); } catch (e) { rec = "threw: " + (e as Error).message; }
+  const mv = w.provider.movements();
+  const em = f2.emitted.includes("r2") ? [{ chargeId: "ch_ip", requestId: "r2", amount: "200", key: w.keyOf("r2", "200") }] : [];
+  problems.push(...truth(mv, em, { ch_ip: "1000" }, [{ w, lines: journalOf(w) }]));
+  const jr1 = journalOf(w).filter(j => j.requestId === "r1").map(j => String(j.outcome));
+  if (rec !== "returned" || jr1[jr1.length - 1] !== "replayed") problems.push("r1 reconcile: " + rec.slice(0, 120) + " journal " + jr1.join(","));
+  w.stop();
+  verdict("p3_in_progress", problems, { f1, f2, reconcile: rec, journal: journalOf(w).map(j => j.requestId + ":" + j.outcome), movements: mv.map(m => m.key.slice(0, 12) + ":" + m.amount) });
+});
diff --git a/tests/refund-finality/regress/p3_key_squat.ts b/tests/refund-finality/regress/p3_key_squat.ts
new file mode 100644
index 00000000..fabd4c17
--- /dev/null
+++ b/tests/refund-finality/regress/p3_key_squat.ts
@@ -0,0 +1,26 @@
+// h-provider3 regression for red team C-ATT-44 (another party on the same provider account sends a key first).
+// usage: p3_key_squat.ts <tree> [literal|derived] [first|error]
+// literal: the other party sends key "r1" (the bare request id; ids are not secret), amount 1, on ch_A, before the honest
+//          r1 600 is dispatched. derived: the other party knows h_0 and sends the NEW adapter's key for (ch_A, r1, 600)
+//          with amount 1 (worst case: the key is not secret either).
+// Old adapter, literal: r1 600 reported paid, the customer got 1: exit 1. New adapter, literal: the key differs, r1 600 is
+// paid: exit 0. New adapter, derived: the replayed answer (amount 1) differs from the call: ALARM, r1 not reported paid,
+// IN DOUBT (liveness loss, printed): exit 0. Usage and exit codes: p3_lib.ts.
+import { emittedOf, journalOf, root, truth, verdict } from "./p3_lib";
+import { guard, world } from "./p_lib";
+guard(() => {
+  const tree = root(), kase = process.argv[3] ?? "literal", replay = (process.argv[4] ?? "first") as "first" | "error";
+  if (!["literal", "derived"].includes(kase) || !["first", "error"].includes(replay)) { console.error("usage: <tree> [literal|derived] [first|error]"); process.exit(4); }
+  const A = world(tree, "b", "none", { chargeId: "ch_A", original: "1000", remaining: "1000", refundEnabled: true }, { providerOptions: { replay } });
+  const ra = A.refund("r1", "600");
+  const squatKey = kase === "literal" ? "r1" : A.keyOf("r1", "600");
+  let squat = "moved 1";
+  try { A.provider.refund({ key: squatKey, chargeId: "ch_A", amount: "1", reason: "x" }); } catch (e) { squat = (e as Error).message; }
+  const fa = A.flush(), fa2 = A.flush();
+  const em = emittedOf(A, fa), mv = A.provider.movements();
+  const problems = truth(mv, em, { ch_A: "1000" }, [{ w: A, lines: journalOf(A) }]);
+  if (ra.status !== "committed") { console.error("SETUP FAILED"); process.exit(3); }
+  if (!fa.emitted.includes("r1")) console.log("LIVENESS: ch_A/r1 600 committed, not paid, in doubt: " + JSON.stringify(fa2.refused) + "; journal: " + JSON.stringify(journalOf(A).map(j => j.outcome)));
+  A.stop();
+  verdict("p3_key_squat " + kase + " " + replay, problems, { squat, fa, emitted: em.map(e => e.requestId + ":" + e.amount), movements: mv.map(m => m.key.slice(0, 12) + ":" + m.amount) });
+});
diff --git a/tests/refund-finality/regress/p3_keytext.ts b/tests/refund-finality/regress/p3_keytext.ts
new file mode 100644
index 00000000..8774fc8f
--- /dev/null
+++ b/tests/refund-finality/regress/p3_keytext.ts
@@ -0,0 +1,23 @@
+// h-provider3 regression for the worker report "key text" (red team summary item 5a; attacker: none). A request id that
+// encoding.ts accepts (<= 256 UTF-16 units, no U+0000, no lone surrogate) but that is not a valid idempotency key at many
+// providers (printable ASCII, at most 255). The fake provider checks key text (keyText {max 255, asciiOnly}).
+// usage: p3_keytext.ts <tree> [long|nonascii]   long: 256 x "x"; nonascii: "remboursé-1"; then r_next 100.
+// Old adapter: the provider refuses the key; the committed refund is never paid (FALSE REJECTION, T6): exit 1.
+// New adapter: the key is 64 hex characters; both refunds paid once: exit 0. Usage and exit codes: p3_lib.ts.
+import { emittedOf, journalOf, root, truth, verdict } from "./p3_lib";
+import { guard, world } from "./p_lib";
+guard(() => {
+  const tree = root(), kase = process.argv[3] ?? "long";
+  const ids: Record<string, string> = { long: "x".repeat(256), nonascii: "remboursé-1" };
+  if (ids[kase] === undefined) { console.error("usage: <tree> [long|nonascii]"); process.exit(4); }
+  const w = world(tree, "b", "none", { chargeId: "ch_kt", original: "1000", remaining: "1000", refundEnabled: true }, { providerOptions: { keyText: { max: 255, asciiOnly: true } } });
