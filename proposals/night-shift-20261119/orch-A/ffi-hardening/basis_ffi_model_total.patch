+/* MODEL-TOTAL PATCH (research artifact, not applied to the toolchain).
+   Model: cakeml/basis/fsFFIScript.sml (sha256 ed0e73e7...fe18), oracle wrapper
+   basis_ffiScript.sml:19-49 (oracle NONE => Oracle_final FFI_failed: the program halts).
+   Rule: where the model RETURNS an error byte, write exactly that byte and return;
+   where the model's oracle FAILS (NONE), halt (mt_final); success paths unchanged.
+   Lengths are compared as UNSIGNED, like w2n of the length registers in the model. */
+
+/* Model oracle NONE (basis_ffiScript.sml:25,29,45): the run halts. No return. */
+static void mt_final(void) {
+  abort();
+}
+
+/* LENGTH conf = 8 and w82n conf (fsFFIScript.sml:313,315,339,341,355,357):
+   full 64-bit big-endian value. Returns 1 and sets *fd only when clen = 8 and the
+   value is at most INT_MAX (a value the OS can name as a descriptor). Otherwise 0:
+   the caller then returns the model's error result (an fd above INT_MAX is not open:
+   NATIVE assumption that the model's infds holds no such fd). */
+static int mt_conf_fd(const unsigned char *c, long clen, int *fd) {
+  if ((unsigned long) clen != 8) return 0;
+  unsigned long long v = 0;
+  for (int i = 0; i < 8; i++) v = (v << 8) | c[i];
+  if (v > (unsigned long long) INT_MAX) return 0;
+  *fd = (int) v;
+  return 1;
+}
