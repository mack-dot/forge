MARK D3
D3_SOURCE imported forge_refundRouteA2.ffi_calls_ok_def
DEFINITION ⊢ (∀P mc ffi ms. ffi_calls_ok P mc ffi 0 ms ⇔ T) ∧
  ∀P mc ffi k ms.
    ffi_calls_ok P mc ffi (SUC k) ms ⇔
    if mc.target.get_pc ms ∈ mc.prog_addresses DIFF set mc.ffi_entry_pcs then
      if
        encoded_bytes_in_mem mc.target.config (mc.target.get_pc ms)
          (mc.target.get_byte ms) mc.prog_addresses
      then
        (let
           ms1 = mc.target.next ms;
           (ms2,new_oracle) = apply_oracle mc.next_interfer ms1;
           mc = mc with next_interfer := new_oracle
         in
           if
             EVERY mc.target.state_ok [ms; ms1; ms2] ∧
             ∀x. x ∉ mc.prog_addresses ⇒
                 mc.target.get_byte ms1 x = mc.target.get_byte ms x
           then
             ffi_calls_ok P mc ffi k ms2
           else T)
      else T
    else if mc.target.get_pc ms = mc.halt_pc then T
    else if mc.target.get_pc ms = mc.install_pc then
      case read_ffi_bytearray mc mc.ptr_reg mc.len_reg ms of
        NONE => T
      | SOME bytes =>
        (let
           (ms1,new_oracle) = apply_oracle mc.install_interfer (bytes,ms);
           mc = mc with install_interfer := new_oracle
         in
           ffi_calls_ok P mc ffi k ms1)
    else
      case find_index (mc.target.get_pc ms) mc.ffi_entry_pcs 0 of
        NONE => T
      | SOME ffi_index =>
        case mc.ffi_names❲ffi_index❳ of
          ExtCall v1 =>
            (case ALOOKUP mc.mmio_info ffi_index of
               NONE =>
                 (case read_ffi_bytearrays mc ms of
                    (NONE,v3) => T
                  | (SOME bytes,NONE) => T
                  | (SOME bytes,SOME bytes2) =>
                    case call_FFI ffi mc.ffi_names❲ffi_index❳ bytes bytes2 of
                      FFI_return new_ffi new_bytes =>
                        P ffi_index new_bytes ms ∧
                        (let
                           (ms1,new_oracle) =
                             apply_oracle mc.ffi_interfer
                               (ffi_index,new_bytes,ms);
                           mc = mc with ffi_interfer := new_oracle
                         in
                           ffi_calls_ok P mc new_ffi k ms1)
                    | FFI_final outcome => T)
             | SOME v => T)
        | SharedMem op => F
MARK H
