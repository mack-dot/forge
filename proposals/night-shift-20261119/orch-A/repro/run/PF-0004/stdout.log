Saved definition ____ "refund_strict_parse_def"
DEFINITION refund_strict_parse
⊢ ∀s. refund_strict_parse s =
      case parse s of
        INL v1 => NONE
      | INR (se,rest) =>
        if rest ≠ "" then NONE
        else
          case refund_response_fields se of
            INL v => NONE
          | INR f =>
            if explode (refund_render_fields f) = s then SOME f else NONE
