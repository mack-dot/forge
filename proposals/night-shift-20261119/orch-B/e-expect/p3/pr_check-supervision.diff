 from pathlib import Path
 import re
 import shlex
+import signal
 import subprocess
 import sys
 
 from common import ROOT, canonical, digest, read_json
 
+# Wall-clock bound of one checker or replay process. Expiry kills its process group and gives no verdict (exit 2).
+CHECKER_SECONDS = 7200
+
+
+def bounded(command, **options):
+    child = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             start_new_session=True, **options)
+    try:
+        stdout, stderr = child.communicate(timeout=CHECKER_SECONDS)
+    except subprocess.TimeoutExpired:
+        stdout = stderr = None
+    finally:
+        try:
+            os.killpg(child.pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+        child.wait()
+    if stdout is None:
+        raise RuntimeError('CHECKER_TIMEOUT: ' + ' '.join(str(c) for c in command[:3]) + ' reached the wall-clock '
+                           'bound of ' + str(CHECKER_SECONDS) + ' s; process group killed; no verdict')
+    return subprocess.CompletedProcess(command, child.returncode, stdout, stderr)
+
 
