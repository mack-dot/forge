+    return Rejected('RESOURCE_LIMIT: ' + Path(str(command[0])).name + ' ' + ' '.join(str(c) for c in command[1:2])
+                    + ' reached the wall-clock bound of ' + str(STEP_SECONDS) + ' s; process group killed; no verdict')
+
