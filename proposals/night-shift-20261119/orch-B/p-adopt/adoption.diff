+  // A settled request id never commits again (any other input).
+  lemma SettledNeverCommits(charge: F.Charge, t: V3.ShellToken, sigOk: bool, preOk: bool)
+    ensures !StepQ(charge, t, sigOk, preOk, true).Commit?
+  {
+  }
+
