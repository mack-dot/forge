+    var r := [ARow(R.Intent("ch_1", "rq_1", 100, "returned_item"), true), ARow(R.Intent("ch_1", "rq_2", 0, "returned_item"), true)];
+    FoldClosed("ch_1", true, 0, r);
+  }
