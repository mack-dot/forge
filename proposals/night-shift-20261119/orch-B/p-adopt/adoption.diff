+  {
+  }
+
+  lemma RejectedChangesNothing(core: Core, tok: SinkToken, sigOk: bool)
+    ensures !Step(core, tok, sigOk).out.Committed? ==> Step(core, tok, sigOk).core == core
+  {
+  }
