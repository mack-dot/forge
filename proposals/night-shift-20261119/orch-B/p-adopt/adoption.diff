+    s.settled == EncSet(core.settled) &&
+    s.outbox == core.outbox &&
+    |toks| == |s.log| &&
+    (forall i | 0 <= i < |toks| :: s.log[i] == ClaimOf(toks[i]) && VerifyTag(s.log[i], toks[i].sig))
+  }
