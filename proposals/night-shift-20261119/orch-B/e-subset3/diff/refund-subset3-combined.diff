+def subset3_close(texts, k):
+    """Index of the bracket that closes texts[k]."""
+    pairs, depth = {'(': ')', '[': ']', '{': '}'}, 0
+    opener, closer = texts[k], pairs[texts[k]]
+    for j in range(k, len(texts)):
+        depth += (texts[j] == opener) - (texts[j] == closer)
+        if depth == 0:
+            return j
+    subset3_refuse('SHAPE', 'unbalanced ' + opener)
