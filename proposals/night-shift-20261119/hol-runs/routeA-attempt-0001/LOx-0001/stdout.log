BEGIN ffi_write_cases
Saved theorem _______ "ffi_write_cases"
CHECKED ffi_write_cases
⊢ ∀conf bs fs fs1.
    ffi_write conf (MAP FST bs) fs = SOME (FFIreturn (MAP SND bs) fs1) ⇒
    (∃x0 x1 x2 x3 xs nw.
       bs = x0::x1::x2::x3::xs ∧ LENGTH conf = 8 ∧
       write (w82n conf) (w22n [FST x0; FST x1])
         (MAP (CHR ∘ w2n) (DROP (w22n [FST x2; FST x3]) (MAP FST xs))) fs =
       SOME (nw,fs1) ∧ SND x0 = 0w ∧ SND x1 = n2w (nw DIV 256) ∧
       SND x2 = n2w nw) ∨ fs1 = fs ∧ ∃x0 xs. bs = x0::xs ∧ SND x0 = 1w
END ffi_write_cases 0.163 s
