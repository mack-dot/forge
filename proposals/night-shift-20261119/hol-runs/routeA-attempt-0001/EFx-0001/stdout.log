       | Data (BitfieldMove@32 v23) => dfn'BitfieldMove v23 state
       | Data (BitfieldMove@64 v24) => dfn'BitfieldMove v24 state
       | Data (ConditionalCompareImmediate@32 v25) =>
         dfn'ConditionalCompareImmediate v25 state
