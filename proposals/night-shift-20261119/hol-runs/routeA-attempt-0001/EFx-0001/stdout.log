       | Data (ConditionalCompareRegister@64 v28) =>
         dfn'ConditionalCompareRegister v28 state
       | Data (ConditionalSelect@32 v29) => dfn'ConditionalSelect v29 state
       | Data (ConditionalSelect@64 v30) => dfn'ConditionalSelect v30 state
       | Data (CountLeading@32 v31) => dfn'CountLeading v31 state
       | Data (CountLeading@64 v32) => dfn'CountLeading v32 state
       | Data (Division@32 v33) => dfn'Division v33 state
       | Data (Division@64 v34) => dfn'Division v34 state
       | Data (ExtractRegister@32 v35) => dfn' ...
