       | CRCExt (CRC@64 v12) => dfn'CRC v12 state
       | CRCExt (CRC@8 v13) => dfn'CRC v13 state
       | ClearExclusive v82 => dfn'ClearExclusive v82 state
       | Data (AddSubCarry@32 v15) => dfn'AddSubCarry v15 state
       | Data (AddSubCarry@64 v16) => dfn'AddSubCarry v16 state
       | Data (AddSubExtendRegister@32 v17) =>
