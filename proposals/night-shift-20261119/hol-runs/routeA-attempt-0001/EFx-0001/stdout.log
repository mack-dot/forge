ARB_IN_DEF write'SP true
LITERAL_CASE_IN_DEF write'SP true
DEF_TEXT write'SP
⊢ ∀value.
    write'SP value =
    (λstate.
       (let
          v = w2w value
        in
          if ¬state.PSTATE.SPS then state with SP_EL0 := v
          else
            case state.PSTATE.EL of
              0w => state with SP_EL0 := v
            | 1w => state with SP_EL1 := v
            | 2w => state with SP_EL2 := v
            | 3w => state with SP_EL3 := v
            | v1 => ARB))
ARB_IN_DEF BranchTo true
LITERAL_CASE_IN_DEF BranchTo true
DEF_TEXT BranchTo
⊢ ∀target0 branch_type.
    BranchTo (target0,branch_type) =
    (λstate.
       (let
          s1 = Hint_Branch branch_type state;
          s =
            case s1.PSTATE.EL of
              0w =>
                (let
                   s0 =
                     if word_bit 55 target0 ∧ s1.TCR_EL1.TBI1 then
                       bit_field_insert 63 56 255w target0
                     else target0
                 in
                   (if ¬word_bit 55 s0 ∧ s1.TCR_EL1.TBI0 then
                      bit_field_insert 63 56 0w s0
                    else s0,s1))
            | 1w =>
              (let
                 s0 =
                   if word_bit 55 target0 ∧ s1.TCR_EL1.TBI1 then
                     bit_field_insert 63 56 255w target0
                   else target0
               in
                 (if ¬word_bit 55 s0 ∧ s1.TCR_EL1.TBI0 then
                    bit_field_insert 63 56 0w s0
                  else s0,s1))
            | 2w =>
              (if s1.TCR_EL2.TBI then bit_field_insert 63 56 0w target0
               else target0,s1)
            | 3w =>
              (if s1.TCR_EL3.TBI then bit_field_insert 63 56 0w target0
               else target0,s1)
            | v => ARB
        in
          SND s with PC := FST s))
ARB_IN_DEF LoadStoreSingle true
LITERAL_CASE_IN_DEF LoadStoreSingle false
DEF_TEXT LoadStoreSingle
⊢ ∀size regsize_word memop acctype signed wb_unknown rt_unknown wback
      postindex offset n t.
    LoadStoreSingle
      (size,regsize_word,memop,acctype,signed,wb_unknown,rt_unknown,wback,
       postindex,offset,n,t) =
    (λstate.
       (let
          s =
            if n = 31w ∧ memop ≠ MemOp_PREFETCH then CheckSPAlignment state
            else state;
          v = if n = 31w then SP s else X n s;
          address = if postindex then v else v + offset;
          s =
            case memop of
              MemOp_LOAD =>
                (let
                   (v,s) = Mem (address,word_len 0w DIV 8,acctype) s
                 in
                   if regsize_word then write'X (ExtendWord (v,signed),t) s
                   else write'X (ExtendWord (v,signed),t) s)
            | MemOp_STORE =>
              write'Mem
                (if rt_unknown then ARB else X t s,address,word_len 0w DIV 8,
                 acctype) s
            | MemOp_PREFETCH => s
        in
          if wback then
            (let
               address =
                 if wb_unknown then ARB
                 else if postindex then address + offset
                 else address
             in
               if n = 31w then write'SP address s else write'X (address,n) s)
          else s))
ARB_IN_DEF dfn'LoadStorePair true
LITERAL_CASE_IN_DEF dfn'LoadStorePair false
DEF_TEXT dfn'LoadStorePair
⊢ ∀size memop acctype signed wb_unknown rt_unknown wback postindex offset n t
      t2.
    dfn'LoadStorePair
      (size,memop,acctype,signed,wb_unknown,rt_unknown,wback,postindex,
       offset,n,t,t2) =
    (λstate.
       (let
          dbytes = word_len 0w DIV 8;
          s = if n = 31w then CheckSPAlignment state else state;
          v = if n = 31w then SP s else X n s;
          address = if postindex then v else v + offset;
          s =
            case memop of
              MemOp_LOAD =>
                (let
                   (v,s) =
                     if rt_unknown then (ARB,s)
                     else
                       (let
                          (v,s) = Mem (address,dbytes,acctype) s;
                          (v0,s) =
                            Mem (address + n2w dbytes,dbytes,acctype) s
                        in
                          ((v,v0),s));
                   (data1,data2) = v
                 in
                   if signed then
                     write'X (ExtendWord (data2,signed),t2)
                       (write'X (ExtendWord (data1,signed),t) s)
                   else write'X (data2,t2) (write'X (data1,t) s))
            | MemOp_STORE =>
              write'Mem
                (if rt_unknown ∧ t2 = n then ARB else X t2 s,
                 address + n2w dbytes,dbytes,acctype)
                (write'Mem
                   (if rt_unknown ∧ t = n then ARB else X t s,address,dbytes,
                    acctype) s)
            | MemOp_PREFETCH => s
        in
          if wback then
            (let
               address =
                 if wb_unknown then ARB
                 else if postindex then address + offset
                 else address
             in
               if n = 31w then write'SP address s else write'X (address,n) s)
          else s))
ARB_IN_DEF Run false
LITERAL_CASE_IN_DEF Run false
DEF_TEXT Run
⊢ ∀v0.
    Run v0 =
    (λstate.
       case v0 of
         Address v81 => dfn'Address v81 state
       | Branch (BranchConditional v2) => dfn'BranchConditional v2 state
       | Branch (BranchImmediate v3) => dfn'BranchImmediate v3 state
       | Branch (BranchRegister v4) => dfn'BranchRegister v4 state
