TIMEOUT_HELPER Timeout.apply loaded
<<HOL message: Created theory "forge_refundRouteA2dExplore">>
MARK INPUTS
INPUT ffi_calls_ok_of_returning_calls
⊢ ∀P k mc ffi ms.
    (∀i. i < LENGTH mc.ffi_entry_pcs ⇒ ∃nm. mc.ffi_names❲i❳ = ExtCall nm) ∧
    (∀ffi1 ms1 i c ab ffi2 nb.
       ffi1.oracle = ffi.oracle ∧ i < LENGTH mc.ffi_entry_pcs ∧
       read_ffi_bytearrays mc ms1 = (SOME c,SOME ab) ∧
       call_FFI ffi1 mc.ffi_names❲i❳ c ab = FFI_return ffi2 nb ⇒
       P i nb ms1) ⇒
    ffi_calls_ok P mc ffi k ms
INPUT basis_close_return_lengths
⊢ ∀ext st c ab st' nb.
    st.oracle = basis_ffi_oracle ext ∧
    call_FFI st (ExtCall «close») c ab = FFI_return st' nb ⇒
    LENGTH c = 8 ∧ 1 ≤ LENGTH ab
INPUT refund_mc_close_fields
⊢ ∀b envmc.
    (refund_mc b envmc).target = arm8_target ∧
    (refund_mc b envmc).len_reg = 1 ∧ (refund_mc b envmc).len2_reg = 3 ∧
    (refund_mc b envmc).ffi_names =
    [ExtCall «read»; ExtCall «write»; ExtCall «close»; ExtCall «open_in»] ∧
    LENGTH (refund_mc b envmc).ffi_entry_pcs = 4
INPUT refund_names_are_ExtCall
⊢ ∀i. i < 4 ⇒
      ∃nm.
        [ExtCall «read»; ExtCall «write»; ExtCall «close»; ExtCall «open_in»]❲
          i
        ❳ = ExtCall nm
INPUT refund_ffi_contract_on_def
⊢ ∀b dm Vok ffi_i.
    refund_ffi_contract_on b dm Vok ffi_i ⇔
    ∀k index new_bytes ms2 t1 bytes bytes2.
      index < 4 ∧ t1.mem_domain = dm ∧
      read_bytearray (ms2.REG 0w) (w2n (ms2.REG 1w))
        (λa. if a ∈ dm then SOME (ms2.MEM a) else NONE) = SOME bytes ∧
      read_bytearray (ms2.REG 2w) (w2n (ms2.REG 3w))
        (λa. if a ∈ dm then SOME (ms2.MEM a) else NONE) = SOME bytes2 ∧
      LENGTH new_bytes = LENGTH bytes2 ∧
      target_state_rel arm8_target (t1 with pc := b − n2w ((3 + index) * 16))
        ms2 ∧ aligned 2 (t1.regs 30) ∧ Vok index new_bytes ms2 ⇒
      arm8_ok (ffi_i k (index,new_bytes,ms2)) ∧
      (ffi_i k (index,new_bytes,ms2)).PC = t1.regs 30 ∧
      (∀a. a ∈ dm ⇒
           (ffi_i k (index,new_bytes,ms2)).MEM a =
           asm_write_bytearray (t1.regs 2) new_bytes t1.mem a) ∧
      ∀r. MEM r [19; 20; 21; 22; 23; 24; 25; 27; 28] ⇒
          (ffi_i k (index,new_bytes,ms2)).REG (n2w r) = t1.regs r
MARK VOK
VOK_SHAPE λi nb s.
  (i = 0 ∨ i = 1 ⇒ 4 ≤ w2n (s.REG 3w)) ∧
  (i = 2 ⇒ s.REG 1w = 8w ∧ s.REG 3w ≠ 0w) ∧ (i = 3 ⇒ s.REG 3w ≠ 0w)
