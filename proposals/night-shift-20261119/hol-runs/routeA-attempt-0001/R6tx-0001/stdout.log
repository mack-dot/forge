STATEMENT parts_ok_basis_ffi
∀st ext cl fs.
  st.ffi = basis_ffi ext cl fs ⇒ parts_ok st.ffi (basis_proj1,basis_proj2)
STATEMENT init_fs_part_IN
∀st ext cl fs.
  st.ffi = basis_ffi ext cl fs ⇒
  FFI_part (encode fs) (mk_ffi_next fs_ffi_part)
    (MAP FST (SND (SND fs_ffi_part))) [] ∈
  st2heap (basis_proj1,basis_proj2) st
STATEMENT init_cl_part_IN
∀st ext cl fs.
  st.ffi = basis_ffi ext cl fs ⇒
  FFI_part (encode cl) (mk_ffi_next cl_ffi_part)
    (MAP FST (SND (SND cl_ffi_part))) [] ∈
  st2heap (basis_proj1,basis_proj2) st
STATEMENT init_rt_part_IN
∀st ext cl fs.
  st.ffi = basis_ffi ext cl fs ⇒
  FFI_part (encode ()) (mk_ffi_next runtime_ffi_part)
    (MAP FST (SND (SND runtime_ffi_part))) [] ∈
  st2heap (basis_proj1,basis_proj2) st
STATEMENT init_iobuff_IN
∀st bs1 bs2 rest.
  st.refs = W8array bs1::W8array bs2::rest ⇒
  Mem 1 (W8array bs2) ∈ st2heap (basis_proj1,basis_proj2) st
STATEMENT IOFS_V_init
∀Inv fs v events.
  wfFS fs ∧ LENGTH v = 2052 ∧ EVERY Inv events ⇒
  IOFS_V Inv fs
    ({FFI_part (encode fs) (mk_ffi_next fs_ffi_part)
        (MAP FST (SND (SND fs_ffi_part))) events} ∪ {Mem 1 (W8array v)})
STATEMENT STDIO_V_of_IOFS_V
∀Inv fs h. STD_streams fs ∧ IOFS_V Inv fs h ⇒ STDIO_V Inv fs h
STATEMENT init_heap_V
∀Inv st ext cl fs bs1 bs2 rest.
  st.ffi = basis_ffi ext cl fs ∧ st.refs = W8array bs1::W8array bs2::rest ∧
  LENGTH bs2 = 2052 ∧ wfFS fs ∧ STD_streams fs ⇒
  ∃h1 h2.
    SPLIT (st2heap (basis_proj1,basis_proj2) st) (h1,h2) ∧
    STDIO_V Inv fs h1 ∧
    FFI_part (encode cl) (mk_ffi_next cl_ffi_part)
      (MAP FST (SND (SND cl_ffi_part))) [] ∈ h2 ∧
    FFI_part (encode ()) (mk_ffi_next runtime_ffi_part)
      (MAP FST (SND (SND runtime_ffi_part))) [] ∈ h2
STATEMENT FFI_part_IN_st2heap_FILTER
∀p st s u ns events.
  FFI_part s u ns events ∈ st2heap p st ⇒
  parts_ok st.ffi p ∧ FILTER (ffi_has_index_in ns) st.ffi.io_events = events
STATEMENT basis_proj2_names
FLAT (MAP FST basis_proj2) =
MAP FST (SND (SND cl_ffi_part)) ++ MAP FST (SND (SND fs_ffi_part)) ++
MAP FST (SND (SND runtime_ffi_part))
STATEMENT every_basis_events
∀Inv f.
  parts_ok f (basis_proj1,basis_proj2) ∧
  FILTER (ffi_has_index_in (MAP FST (SND (SND cl_ffi_part)))) f.io_events =
  [] ∧
  FILTER (ffi_has_index_in (MAP FST (SND (SND runtime_ffi_part))))
    f.io_events = [] ∧
  EVERY Inv
    (FILTER (ffi_has_index_in (MAP FST (SND (SND fs_ffi_part)))) f.io_events) ⇒
  EVERY Inv f.io_events
STATEMENT sem_satisfies_imp_V
∀s P Q. sem_satisfies s P ⇒ (∀b. P b ⇒ Q b) ⇒ sem_satisfies s Q
STATEMENT STDIO_V_FFI_part_hprop
∀Inv fs. FFI_part_hprop (STDIO_V Inv fs)
STATEMENT IOxV_events_IN
∀Inv fs H h.
  (IOxV Inv fs * H) h ⇒
  ∃ev.
    FFI_part (encode fs) (mk_ffi_next fs_ffi_part)
      (MAP FST (SND (SND fs_ffi_part))) ev ∈ h ∧ EVERY Inv ev
STATEMENT STDIO_V_events
∀Inv fs h.
  STDIO_V Inv fs h ⇒
  ∃s u ev.
    FFI_part s u (MAP FST (SND (SND fs_ffi_part))) ev ∈ h ∧ EVERY Inv ev
STATEMENT final_heap_events
∀Inv fs' st3 h2 h3 h4 s1 u1 s3 u3.
  SPLIT3 (st2heap (basis_proj1,basis_proj2) st3) (h3,h2,h4) ∧
  STDIO_V Inv fs' h3 ∧
  FFI_part s1 u1 (MAP FST (SND (SND cl_ffi_part))) [] ∈ h2 ∧
  FFI_part s3 u3 (MAP FST (SND (SND runtime_ffi_part))) [] ∈ h2 ⇒
  EVERY Inv st3.ffi.io_events
STATEMENT whole_prog_spec_V_events
T
STATEMENT whole_prog_spec_V_init
