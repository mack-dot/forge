      ALOOKUP fs.inode_tbl (UStream «stderr») = SOME err ∧
      ALOOKUP fs.infds 0 = SOME (UStream «stdin»,ReadMode,inp) ∧
      ALOOKUP fs.infds 1 = SOME (UStream «stdout»,WriteMode,STRLEN out) ∧
      ALOOKUP fs.infds 2 = SOME (UStream «stderr»,WriteMode,STRLEN err) ∧
      ∀fd md off.
        ALOOKUP fs.infds fd = SOME (UStream «stdout»,md,off) ⇒ fd = 1
