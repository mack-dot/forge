STATEMENT trace_st_upd
∀tr mc st ms f f'.
  trace_st (mc with next_interfer := f) st ms tr = trace_st mc st ms tr ∧
  trace_st (mc with ffi_interfer := f') st ms tr = trace_st mc st ms tr
STATEMENT evaluate_cong
∀mc1 mc2 st1 st2 ms1 ms2 k.
  mc1 = mc2 ∧ st1 = st2 ∧ ms1 = ms2 ⇒
  evaluate mc1 st1 k ms1 = evaluate mc2 st2 k ms2
STATEMENT evaluate_zero
∀mc st ms. evaluate mc st 0 ms = (TimeOut,ms,st)
STATEMENT evaluate_one_step_event
∀mc st ms s k.
  step_event_ok mc ms s ∧ mc.next_interfer 0 (mc.target.next ms) = s ⇒
  evaluate mc st (SUC k) ms =
  evaluate (mc with next_interfer := shift_seq 1 mc.next_interfer) st k s
STATEMENT evaluate_one_ffi_event
∀mc st ms i nb s k.
  ffi_event_ok mc st ms i nb ∧ mc.ffi_interfer 0 (i,nb,ms) = s ⇒
  evaluate mc st (SUC k) ms =
  evaluate (mc with ffi_interfer := shift_seq 1 mc.ffi_interfer)
    (ffi_post_st mc st ms i) k s
STATEMENT trace_gen
∀P G tr mc st ms g k.
  trace_ok P G mc st ms tr ∧ mc.next_interfer = trace_next_interfer P tr ∧
  mc.ffi_interfer = trace_ffi_interfer G g ms tr ⇒
  evaluate mc st (LENGTH tr + k) ms =
  evaluate
    (mc with
     <|next_interfer := trace_next_interfer P [];
       ffi_interfer := shift_seq (nffis tr) g|>) (trace_st mc st ms tr) k
    (trace_last ms tr)
STATEMENT evaluate_follows_trace
∀P G g tr mc st ms k.
  trace_ok P G mc st ms tr ⇒
  evaluate
    (mc with
     <|next_interfer := trace_next_interfer P tr;
       ffi_interfer := trace_ffi_interfer G g ms tr|>) st (LENGTH tr + k) ms =
  evaluate
    (mc with
     <|next_interfer := trace_next_interfer P [];
       ffi_interfer := shift_seq (nffis tr) g|>) (trace_st mc st ms tr) k
    (trace_last ms tr)
STATEMENT call_FFI_return_io
∀st n b1 b2 st1 nb.
  call_FFI st n b1 b2 = FFI_return st1 nb ⇒
  st1.io_events =
  st.io_events ++
  if n = ExtCall «» then [] else [IO_event n b1 (ZIP (b2,nb))]
STATEMENT ffi_post_st_io
∀mc st ms i nb.
  ffi_event_ok mc st ms i nb ⇒
  (ffi_post_st mc st ms i).io_events =
  st.io_events ++ ffi_call_event mc ms i nb
STATEMENT trace_io
∀P G tr mc st ms.
  trace_ok P G mc st ms tr ⇒
  (trace_st mc st ms tr).io_events = st.io_events ++ trace_events mc ms tr
STATEMENT add_clock_swap
∀mc st k ms r a b.
  evaluate mc st k ms = (r,a,b) ⇒
  r ≠ TimeOut ⇒
  ∀k1. evaluate mc st (k1 + k) ms = (r,a,b)
STATEMENT prefix_of_halt
∀mc st k ms t a b.
  evaluate mc st k ms = (Halt t,a,b) ⇒ st.io_events ≼ b.io_events
STATEMENT fst_error
∀x. FST x = Error ⇒ ∃a b. x = (Error,a,b)
STATEMENT term_after
∀mc st ms mc2 st2 ms2 n t io.
  (∀k. evaluate mc st (n + k) ms = evaluate mc2 st2 k ms2) ∧
  machine_sem mc st ms (Terminate t io) ⇒
  machine_sem mc2 st2 ms2 (Terminate t io) ∧ st2.io_events ≼ io
STATEMENT fail_after
∀mc st ms mc2 st2 ms2 n.
  (∀k. evaluate mc st (n + k) ms = evaluate mc2 st2 k ms2) ∧
  machine_sem mc st ms Fail ⇒
  machine_sem mc2 st2 ms2 Fail
STATEMENT trace_terminate
∀P G g tr mc st ms t io.
  trace_ok P G mc st ms tr ∧
  machine_sem
    (mc with
     <|next_interfer := trace_next_interfer P tr;
       ffi_interfer := trace_ffi_interfer G g ms tr|>) st ms (Terminate t io) ⇒
  machine_sem
    (mc with
     <|next_interfer := trace_next_interfer P [];
       ffi_interfer := shift_seq (nffis tr) g|>) (trace_st mc st ms tr)
    (trace_last ms tr) (Terminate t io) ∧
  st.io_events ++ trace_events mc ms tr ≼ io
STATEMENT trace_fail
∀P G g tr mc st ms.
  trace_ok P G mc st ms tr ∧
  machine_sem
    (mc with
     <|next_interfer := trace_next_interfer P tr;
       ffi_interfer := trace_ffi_interfer G g ms tr|>) st ms Fail ⇒
  machine_sem
    (mc with
     <|next_interfer := trace_next_interfer P [];
       ffi_interfer := shift_seq (nffis tr) g|>) (trace_st mc st ms tr)
    (trace_last ms tr) Fail
STATEMENT div_after
∀mc st ms mc2 st2 ms2 n l.
  (∀k. evaluate mc st (n + k) ms = evaluate mc2 st2 k ms2) ∧
  machine_sem mc st ms (Diverge l) ⇒
  LPREFIX (fromList st2.io_events) l
STATEMENT trace_diverge
∀P G g tr mc st ms l.
  trace_ok P G mc st ms tr ∧
  machine_sem
    (mc with
     <|next_interfer := trace_next_interfer P tr;
       ffi_interfer := trace_ffi_interfer G g ms tr|>) st ms (Diverge l) ⇒
  LPREFIX (fromList (st.io_events ++ trace_events mc ms tr)) l
