STATEMENT writei_spec_W
wfFS fs ⇒
0 < n ⇒
MAX (i + n) 2048 ≤ LENGTH rest ⇒
i + n < 256² ⇒
get_fd_content fs fd = SOME (content,pos) ⇒
get_mode fs fd = SOME WriteMode ⇒
FD fd fdv ⇒
NUM n nv ⇒
NUM i iv ⇒
bc = h1::h2::h3::h4::rest ⇒
LENGTH rest = 2048 ⇒
write_event_ok Inv fd ⇒
app p TextIO_writei_v [fdv; nv; iv] (IOxV Inv fs * W8ARRAY iobuff_loc bc)
  (POSTve
     (λnwv.
        SEP_EXISTS nw.
          &NUM nw nwv * &(nw > 0) * &(nw ≤ n) *
          W8ARRAY iobuff_loc (0w::n2w2 nw ++ n2w i::rest) *
          IOxV Inv
            (fsupdate fs fd (1 + Lnext_pos fs.numchars) (pos + nw)
               (insert_atI (TAKE nw (MAP (CHR ∘ w2n) (DROP i rest))) pos
                  content)))
     (λe.
        &InvalidFD_exn e * W8ARRAY iobuff_loc (1w::n2w n::n2w2 i ++ rest) *
        &F *
        IOFS
          (fs with
           numchars := THE (LDROP (1 + Lnext_pos fs.numchars) fs.numchars))))
STATEMENT write_spec_V
∀n fs fd i pos h1 h2 h3 h4 rest bc fdv nv iv content.
  wfFS fs ⇒
  MAX (i + n) 2048 ≤ LENGTH rest ⇒
  i + n < 256² ⇒
  get_fd_content fs fd = SOME (content,pos) ⇒
  get_mode fs fd = SOME WriteMode ⇒
  FD fd fdv ⇒
  NUM n nv ⇒
  NUM i iv ⇒
  bc = h1::h2::h3::h4::rest ⇒
  LENGTH rest = 2048 ⇒
  write_event_ok Inv fd ⇒
  app p TextIO_write_v [fdv; nv; iv] (IOxV Inv fs * W8ARRAY iobuff_loc bc)
    (POSTv nwv. SEP_EXISTS k.
       IOFS_V Inv
         (fsupdate fs fd k (pos + n)
            (insert_atI (TAKE n (MAP (CHR ∘ w2n) (DROP i rest))) pos content)))
STATEMENT output_aux_spec_V
∀fd fdv s sv i iv z zv fs content pos.
  OUTSTREAM fd fdv ∧ STRING_TYPE s sv ∧ NUM i iv ∧ NUM z zv ∧ i ≤ z ∧
  z ≤ strlen s ∧ get_fd_content fs fd = SOME (content,pos) ∧
  get_mode fs fd = SOME WriteMode ∧ write_event_ok Inv fd ⇒
  app p TextIO_output_aux_v [fdv; sv; iv; zv] (IOFS_V Inv fs)
    (POSTv uv.
       &UNIT_TYPE () uv *
       SEP_EXISTS k.
         IOFS_V Inv
           (fsupdate fs fd k (pos + (z − i))
              (insert_atI (explode (substring s i (z − i))) pos content)))
STATEMENT output_spec_V
∀s fd fdv sv fs content pos.
