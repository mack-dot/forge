STATEMENT SEG_APPEND3_W
∀len off z l.
  len + off ≤ z ∧ z ≤ LENGTH l ⇒
  SEG len off l ++ SEG (z − (off + len)) (off + len) l = SEG (z − off) off l
STATEMENT IOxV_FFI_part_IN
∀Inv fs H h.
  (IOxV Inv fs * H) h ⇒
  ∃ev.
    FFI_part (encode fs) (mk_ffi_next fs_ffi_part)
      (MAP FST (SND (SND fs_ffi_part))) ev ∈ h
STATEMENT UNIQUE_IOFS_V
∀s. VALID_HEAP s ⇒
    ∀Inv1 Inv2 fs1 fs2 H1 H2.
      (IOFS_V Inv1 fs1 * H1) s ∧ (IOFS_V Inv2 fs2 * H2) s ⇒ fs1 = fs2
STATEMENT IOFS_V_HPROP_INJ
∀Inv fs1 fs2. HPROP_INJ (IOFS_V Inv fs1) (IOFS_V Inv fs2) (fs2 = fs1)
STATEMENT STDIO_V_numchars
∀Inv fs x. STDIO_V Inv (fs with numchars := x) = STDIO_V Inv fs
STATEMENT UNIQUE_STDIO_V
∀s. VALID_HEAP s ⇒
    ∀fs1 fs2 Inv H1 H2.
      (STDIO_V Inv fs1 * H1) s ∧ (STDIO_V Inv fs2 * H2) s ⇒
      fs1.infds = fs2.infds ∧ fs1.files = fs2.files ∧ fs1.maxFD = fs2.maxFD ∧
      fs1.inode_tbl = fs2.inode_tbl
STATEMENT STDIO_V_HPROP_INJ
∀Inv fs1 fs2.
  HPROP_INJ (STDIO_V Inv fs1) (STDIO_V Inv fs2)
    (fs1.infds = fs2.infds ∧ fs1.files = fs2.files ∧ fs1.maxFD = fs2.maxFD ∧
     fs1.inode_tbl = fs2.inode_tbl)
