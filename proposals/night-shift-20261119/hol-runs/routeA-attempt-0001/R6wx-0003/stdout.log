STATEMENT output_STDIO_spec_V
∀fd fdv fs content pos s.
  OUTSTREAM fd fdv ∧ get_fd_content fs fd = SOME (content,pos) ∧
  get_mode fs fd = SOME WriteMode ∧ STRING_TYPE s sv ∧ write_event_ok Inv fd ⇒
