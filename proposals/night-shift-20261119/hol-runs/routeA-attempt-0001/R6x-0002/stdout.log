STATEMENT writei_spec_V
wfFS fs ⇒
0 < n ⇒
MAX (i + n) 2048 ≤ LENGTH rest ⇒
i + n < 256² ⇒
get_fd_content fs fd = SOME (content,pos) ⇒
get_mode fs fd = SOME WriteMode ⇒
FD fd fdv ⇒
NUM n nv ⇒
NUM i iv ⇒
bc = h1::h2::h3::h4::rest ⇒
(∀nb.
   LENGTH nb = 4 + LENGTH rest ∧ HD nb = 0w ⇒
   Inv
     (IO_event (ExtCall «write») (n2w8 fd)
        (ZIP (n2w2 n ++ n2w2 i ++ rest,nb)))) ⇒
app p TextIO_writei_v [fdv; nv; iv] (IOxV Inv fs * W8ARRAY iobuff_loc bc)
  (POSTve
     (λnwv.
        SEP_EXISTS nw.
          &NUM nw nwv * &(nw > 0) * &(nw ≤ n) *
          W8ARRAY iobuff_loc (0w::n2w2 nw ++ n2w i::rest) *
          IOxV Inv
            (fsupdate fs fd (1 + Lnext_pos fs.numchars) (pos + nw)
               (insert_atI (TAKE nw (MAP (CHR ∘ w2n) (DROP i rest))) pos
                  content)))
     (λe.
        &InvalidFD_exn e * W8ARRAY iobuff_loc (1w::n2w n::n2w2 i ++ rest) *
        &F *
        IOFS
          (fs with
           numchars := THE (LDROP (1 + Lnext_pos fs.numchars) fs.numchars))))
