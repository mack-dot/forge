       (λnrv.
          SEP_EXISTS nr.
            &NUM nr nrv *
            SEP_EXISTS content pos.
              &(get_fd_content fs fd = SOME (content,pos) ∧
               get_mode fs fd = SOME ReadMode ∧
               (nr ≤ MIN n (STRLEN content − pos) ∧
                nr ≤ STRLEN content − pos) ∧
               (nr = 0 ⇔ eof fd fs = SOME T ∨ n = 0)) *
              IOxV Inv (bumpFD fd fs nr) *
              W8ARRAY buf
                (0w::n2w (nr DIV 256)::n2w nr::h4::
                   MAP (n2w ∘ ORD) (TAKE nr (DROP pos content)) ++
                 DROP nr rest))
       (λe.
          &InvalidFD_exn e *
          &(get_fd_content fs fd = NONE ∨ get_mode fs fd ≠ SOME ReadMode) *
          IOFS_WO_iobuff fs))
