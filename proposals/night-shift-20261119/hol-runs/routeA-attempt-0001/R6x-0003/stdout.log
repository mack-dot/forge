DEFINITION ⊢ ∀Inv fs.
    IOxV Inv fs =
    SEP_EXISTS events.
      one
        (FFI_part (encode fs) (mk_ffi_next fs_ffi_part)
           (MAP FST (SND (SND fs_ffi_part))) events) * &EVERY Inv events *
      &¬MEM «» (MAP FST (SND (SND fs_ffi_part)))
DEFINITION ⊢ ∀Inv fs.
    IOFS_V Inv fs =
    IOxV Inv fs * (SEP_EXISTS v. W8ARRAY iobuff_loc v * &(LENGTH v = 2052)) *
    &wfFS fs
DEFINITION ⊢ ∀Inv fs.
    STDIO_V Inv fs =
    (SEP_EXISTS ll. IOFS_V Inv (fs with numchars := ll)) * &STD_streams fs
