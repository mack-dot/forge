Saved definition ____ "write_chunk_def"
DEFINITION write_chunk
⊢ ∀conf bs.
    write_chunk conf bs =
    if
      LENGTH conf = 8 ∧ w82n conf = 1 ∧ 4 ≤ LENGTH bs ∧ SND (HD bs) = 0w
    then
      TAKE (w22n [SND bs❲1❳; SND bs❲2❳])
        (DROP (w22n [FST bs❲2❳; FST bs❲3❳])
           (MAP (λb. CHR (w2n (FST b))) (DROP 4 bs)))
    else ""
