STATEMENT shift_seq_shift_seq
∀m n f. shift_seq m (shift_seq n f) = shift_seq (m + n) f
STATEMENT shift_seq_0
∀f. shift_seq 0 f = f
STATEMENT shift_seq_1_pred
∀g k. k ≠ 0 ⇒ shift_seq 1 g (k − 1) = g k
STATEMENT trace_next_interfer_ffi
