Saved definition ____ "ffi_post_st_def"
DEFINITION ffi_post_st_def
⊢ ∀mc st ms i.
    ffi_post_st mc st ms i =
    case read_ffi_bytearrays mc ms of
      (NONE,v3) => st
    | (SOME b1,NONE) => st
    | (SOME b1,SOME b2) =>
      case call_FFI st mc.ffi_names❲i❳ b1 b2 of
        FFI_return st1 nb => st1
      | FFI_final e => st
