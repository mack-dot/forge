DEFINITION ⊢ ∀Inv fd.
    read_event_ok Inv fd ⇔
    ∀n h3 h4 rest nb.
      n = 4096 ∧ LENGTH rest = 4096 ∧ LENGTH nb = 4 + LENGTH rest ∧
      HD nb = 0w ⇒
      Inv
        (IO_event (ExtCall «read») (n2w8 fd)
           (ZIP (n2w2 n ++ h3::h4::rest,nb)))
DEFINITION ⊢ ∀bactive fd is.
    INSTREAM_BUFFERED_FD_V bactive fd is =
    SEP_EXISTS bcontent.
      INSTREAM_BUFFERED_BL_FD bcontent bactive fd is *
      &(LENGTH bcontent = 4100)
DEFINITION ⊢ ∀fd is s fs.
    INSTREAM_STR_V fd is s fs =
    SEP_EXISTS read active left.
      INSTREAM_BUFFERED_FD_V (MAP (n2w ∘ ORD) active) fd is *
      &(s = STRCAT active left ∧
       get_fd_content fs fd =
       SOME (STRCAT read s,STRLEN read + STRLEN active) ∧
       get_mode fs fd = SOME ReadMode)
DEFINITION ⊢ ∀fd is s fs non_empty is_empty.
    INSTREAM_STRP_V fd is s fs non_empty is_empty =
    SEP_EXISTS read active left.
      INSTREAM_BUFFERED_FD_V (MAP (n2w ∘ ORD) active) fd is *
      &(s = STRCAT active left ∧ (non_empty ⇒ active ≠ "") ∧
       (is_empty ⇒ active = "") ∧
       get_fd_content fs fd =
       SOME (STRCAT read s,STRLEN read + STRLEN active) ∧
       get_mode fs fd = SOME ReadMode)
