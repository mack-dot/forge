STATEMENT read_event_ok_read_into
∀Inv fd n h3 h4 rest.
  read_event_ok Inv fd ∧ n = LENGTH rest ∧ LENGTH rest = 4096 ⇒
  ∀nb.
    LENGTH nb = 4 + LENGTH rest ∧ HD nb = 0w ⇒
    Inv
      (IO_event (ExtCall «read») (n2w8 fd) (ZIP (n2w2 n ++ h3::h4::rest,nb)))
STATEMENT read_event_ok_refund
read_event_ok refund_valid_event 0
STATEMENT STD_streams_fd0
∀fs.
  wfFS fs ∧ STD_streams fs ⇒
  get_fd_content fs 0 ≠ NONE ∧ get_mode fs 0 = SOME ReadMode
STATEMENT INSTREAM_STRP_V_F_F
∀fd is s fs. INSTREAM_STRP_V fd is s fs F F = INSTREAM_STR_V fd is s fs
STATEMENT INSTREAM_BUFFERED_FD_V_IMP
∀bactive fd is.
  INSTREAM_BUFFERED_FD_V bactive fd is ==>>
  INSTREAM_BUFFERED_FD bactive fd is
STATEMENT INSTREAM_STR_V_IMP
∀fd is s fs. INSTREAM_STR_V fd is s fs ==>> INSTREAM_STR fd is s fs
STATEMENT read_into_spec_R
∀fs fd fdv n nv buf.
  wfFS fs ⇒
  FD fd fdv ⇒
  NUM n nv ⇒
  n < 256² ⇒
  MAX n 1024 ≤ LENGTH rest ⇒
  get_fd_content fs fd ≠ NONE ⇒
  get_mode fs fd = SOME ReadMode ⇒
  n = LENGTH rest ⇒
  LENGTH rest = 4096 ⇒
  read_event_ok Inv fd ⇒
  app p TextIO_read_into_v [fdv; buf; nv]
    (W8ARRAY buf (h1::h2::h3::h4::rest) * IOxV Inv fs)
    (POSTve
       (λnrv.
          SEP_EXISTS nr.
            &NUM nr nrv *
            SEP_EXISTS content pos.
              &(get_fd_content fs fd = SOME (content,pos) ∧
               get_mode fs fd = SOME ReadMode ∧
               (nr ≤ MIN n (STRLEN content − pos) ∧
                nr ≤ STRLEN content − pos) ∧
               (nr = 0 ⇔ eof fd fs = SOME T ∨ n = 0)) *
              IOxV Inv (bumpFD fd fs nr) *
              W8ARRAY buf
                (0w::n2w (nr DIV 256)::n2w nr::h4::
                   MAP (n2w ∘ ORD) (TAKE nr (DROP pos content)) ++
                 DROP nr rest))
       (λe.
          &InvalidFD_exn e *
          &(get_fd_content fs fd = NONE ∨ get_mode fs fd ≠ SOME ReadMode) *
          IOFS_WO_iobuff fs))
STATEMENT refillBuffer_with_read_spec_V
∀fd fdv fs content pos.
  is = Conv instreambuffered_con_stamp [fdv; rr; wr; isbuff] ∧
  get_fd_content fs fd = SOME (content,pos) ⇒
  get_mode fs fd = SOME ReadMode ⇒
  LENGTH bcontent = 4100 ⇒
  read_event_ok Inv fd ⇒
  app p TextIO_refillBuffer_with_read_v [is]
    (IOFS_V Inv fs * INSTREAM_BUFFERED_BL_FD bcontent bactive fd is)
    (POSTv wv. SEP_EXISTS nr h4 rest.
       &(NUM nr wv ∧
        LENGTH bcontent = LENGTH (0w::n2w (nr DIV 256)::n2w nr::h4::rest) ∧
        (nr = 0 ⇔ eof fd fs = SOME T) ∧ (nr = 0 ⇔ ¬(pos < STRLEN content)) ∧
        nr = LENGTH (explode_fromI nr content pos) ∧
        nr ≤ STRLEN content − pos) *
       INSTREAM_BUFFERED_BL_FD (0w::n2w (nr DIV 256)::n2w nr::h4::rest)
         (explode_fromI nr content pos) fd is * IOFS_V Inv (bumpFD fd fs nr))
STATEMENT refillBuffer_with_read_spec_STR_V
read_event_ok Inv fd ⇒
app p TextIO_refillBuffer_with_read_v [is]
  (STDIO_V Inv fs * INSTREAM_STRP_V fd is input fs F T)
  (POSTv retv. SEP_EXISTS nr.
     STDIO_V Inv (forwardFD fs fd nr) *
     INSTREAM_STRP_V fd is input (forwardFD fs fd nr) (¬NULL input)
       (NULL input))
