∀dafny_env dafny_heap.
    ∃charge request original remaining enabled opened candidate amount reason
    sl s h stk e envmc fs cl.
  (refund_entry_pre_sl sl s h stk e ∧ aligned 3 e ∧ h ≤₊ e ∧ 8192w ≤₊ e − h ∧
   refund_heap_clear_sl sl h e ∧
   envmc.prog_addresses = refund_mem_dm_sl sl h e ∧
   interference_ok envmc.next_interfer
     (arm8_target.proj envmc.prog_addresses) ∧
   refund_ffi_contract_on (sl + 0x1000040D0w) envmc.prog_addresses
     (λi nb s.
        (i = 0 ∨ i = 1 ⇒ 4 ≤ w2n (s.REG 3w)) ∧
        (i = 2 ⇒ s.REG 1w = 8w ∧ s.REG 3w ≠ 0w) ∧ (i = 3 ⇒ s.REG 3w ≠ 0w))
     envmc.ffi_interfer ∧
   stdin_content fs =
   SOME
     (explode
        (sexp_to_string
           (refund_request charge request original remaining enabled opened
              candidate amount reason))) ∧ wfcl cl ∧ wfFS fs ∧
   STD_streams fs) ∧
  ∃ms.
    (arm8_run 27 s = SOME ms ∧ ms.PC = sl + 0x1000040D0w) ∧
    (∃b. machine_sem (refund_mc (sl + 0x1000040D0w) envmc)
           (basis_ffi no_ext cl fs) ms b) ∧
    ∀b. machine_sem (refund_mc (sl + 0x1000040D0w) envmc)
          (basis_ffi no_ext cl fs) ms b ⇒
        ∃t io.
          b = Terminate t io ∧
          ∀g. refund_strict_parse (fd1_written io) = SOME g ⇒
              g =
              refund_fields charge request original remaining enabled opened
                candidate amount reason ∧
              fd1_written io =
              explode
                (refund_render_fields
                   (refund_fields charge request original remaining enabled
                      opened candidate amount reason)) ∧
              ∀ok a r c q n.
                g = (ok,a,r,c,q,n) ⇒
                evaluate_exps
                  (exported_contract_state dafny_heap charge request original
                     remaining enabled opened candidate amount reason ok a r
                     c q n) dafny_env exported_ensures =
                (exported_contract_state dafny_heap charge request original
