#!/usr/bin/env python3
"""forge-airlock: the thin dispatcher of Goal 20 (Python stdlib only). end_to_end=false.

It decides nothing. It finds paths, starts the engine (build/airlock/airlock-engine) or a helper with the right
options, and passes the exit code through unchanged. Every write decision is the engine's (NATIVE CHECK), the
CakeML refund binary's (PROVED CORE, canonical-refund profile only) or the Dafny-compiled booking checker's
(PROVED CORE source; Dafny compiler and Node trusted).

  forge-airlock build [--checker]            two rustc builds + a private 0700 copy of the pinned refund binary;
                                             --checker ALSO runs src/airlock/node/build_checker.py (starts Dafny)
  forge-airlock init <dir> [--store-id ID] [--policy FILE]... [--cosign-pubkey HEX64]
  forge-airlock serve <dir> [--node P]       one answer line per request line (src/airlock/PROTOCOL.md)
  (serve, init, state, replay, get, leases, cosign-message also take --engine-dir DIR: DIR/airlock-engine and
   DIR/checker/model.cjs instead of build/airlock; the refund binary copy is always build/airlock/refund-binary)
  forge-airlock state|replay <dir>
  forge-airlock get <dir> <tenant> <key>
  forge-airlock leases <dir> [--sweep [--now MS]]
  forge-airlock cosign-message <dir> <action>
  forge-airlock cosign-keygen <new-key-file> [--node P]     the HUMAN's tool (src/airlock/node/cosign.cjs)
  forge-airlock cosign-sign <key-file> [--node P]           the HUMAN's tool; message on stdin
  forge-airlock diff-policy <old.json> <new.json> [diff_policy.py options]
  forge-airlock fuzz [fuzz.py options]
  forge-airlock demo [run_demo.py options]

Node: --node P, else $FORGE_AIRLOCK_NODE, else `node` on PATH. It must be Node 24.x (the repository pins 24.3.0);
another version is refused with exit 2 and a message. Exit 2 is also used for a usage error of the dispatcher.
"""

import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
BUILD = ROOT / 'build' / 'airlock'
ENGINE = BUILD / 'airlock-engine'
REFUND_SRC = ROOT / 'proposals' / 'forge2-m1-conformance' / 'artifacts' / 'refund-arm64-macho'
REFUND_COPY = BUILD / 'refund-binary'
REFUND_SHA256 = 'b8ed5ec2e34f4124af8368e4e8503e7b18c5476af9195765c55f85ca39007bb8'
HELPERS = ROOT / 'src' / 'airlock' / 'node'
MODEL = BUILD / 'checker' / 'model.cjs'  # build-time note only; serve uses <engine-dir>/checker/model.cjs
RUSTC = [['rustc', '--edition', '2021', '-D', 'unsafe_code', '-C', 'opt-level=3', 'src/airlock/main.rs',
          '-o', 'build/airlock/airlock-engine'],
         ['rustc', '--edition', '2021', '-D', 'unsafe_code', '-C', 'opt-level=3', '--cfg', 'kill_points',
          'src/airlock/main.rs', '-o', 'build/airlock/airlock-engine-kill']]
USAGE = 2


def say(msg):
    sys.stderr.write('forge-airlock: %s\n' % msg)


def take_option(args, name):
    """Remove `name VALUE` from args; return VALUE or None."""
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            raise SystemExit(usage('%s needs a value' % name))
        value = args[i + 1]
        del args[i:i + 2]
        return value
    return None


def usage(msg):
    say(msg)
    say('usage: see the docstring of bin/forge-airlock or docs/quickstart-5min.md')
    return USAGE


def find_node(explicit):
    """Absolute path of a Node 24.x binary, or None (a message is printed)."""
    cand = explicit or os.environ.get('FORGE_AIRLOCK_NODE') or shutil.which('node')
    if not cand:
        say('no node found: give --node /path/to/node (Node 24.3.0)')
        return None
    path = Path(cand)
    if not path.is_absolute():
        found = shutil.which(cand)
        path = Path(found) if found else path.resolve()
    try:
        out = subprocess.run([str(path), '--version'], capture_output=True, timeout=30).stdout.decode('ascii', 'replace').strip()
    except (OSError, subprocess.SubprocessError) as e:
        say('node %s cannot start: %s' % (path, e))
        return None
    if not out.startswith('v24.'):
        say('node %s is version %r, not 24.x; give --node /path/to/node (the repository pins Node 24.3.0)' % (path, out))
        return None
    if out != 'v24.3.0':
        say('note: node %s is %s; the repository pins v24.3.0' % (path, out))
    return str(path)


def engine_in(engine_dir):
    """The engine binary: <engine-dir>/airlock-engine (default build/airlock). Exit 2 if missing."""
    engine = Path(engine_dir).resolve() / 'airlock-engine' if engine_dir else ENGINE
    if not engine.is_file():
        say('%s is missing: run `forge-airlock build` first' % engine)
        raise SystemExit(USAGE)
    return engine


def refund_copy():
    """The private 0700 copy of the pinned CakeML refund binary, re-checked at every start. None if missing."""
    if not REFUND_COPY.is_file():
        return None
    if hashlib.sha256(REFUND_COPY.read_bytes()).hexdigest() != REFUND_SHA256:
        say('%s is not the pinned refund binary (SHA-256 %s); run `forge-airlock build`' % (REFUND_COPY.relative_to(ROOT), REFUND_SHA256))
        raise SystemExit(USAGE)
    return str(REFUND_COPY)


def run(argv, cwd=None):
    """Run a child and return its exit code unchanged (a signal gives 128 + signal number)."""
    try:
        p = subprocess.run(argv, cwd=cwd)
    except OSError as e:
        say('%s cannot start: %s (is it on PATH?)' % (argv[0], e.strerror))
        return 127
    return p.returncode if p.returncode >= 0 else 128 - p.returncode


def exec_(argv):
    """Replace this process: the child keeps our pipes and its exit code is ours."""
    sys.stdout.flush()
    sys.stderr.flush()
    os.execv(argv[0], argv)


def cmd_build(args):
    checker = '--checker' in args
    args = [a for a in args if a != '--checker']
    if args:
        return usage('build takes only --checker')
    BUILD.mkdir(parents=True, exist_ok=True)
    for argv in RUSTC:
        print('$ ' + ' '.join(argv), flush=True)
        code = run(argv, cwd=ROOT)
        if code != 0:
            return code
    data = REFUND_SRC.read_bytes()
    if hashlib.sha256(data).hexdigest() != REFUND_SHA256:
        say('the tracked refund binary is not the pinned one')
        return 1
    tmp = REFUND_COPY.with_name('refund-binary.tmp')
    tmp.write_bytes(data)
    os.chmod(tmp, 0o700)
    os.replace(tmp, REFUND_COPY)
    print('refund binary: private 0700 copy at build/airlock/refund-binary, SHA-256 %s' % REFUND_SHA256, flush=True)
    if checker:
        print('$ python3 src/airlock/node/build_checker.py   (starts the pinned Dafny; one Dafny job at a time)', flush=True)
        return run([sys.executable, str(ROOT / 'src/airlock/node/build_checker.py')], cwd=ROOT)
    if not MODEL.is_file():
        print('note: build/airlock/checker/model.cjs is missing; BOOK answers HELPER_FAILED until `forge-airlock build --checker`', flush=True)
    return 0


def cmd_serve(args):
    node_opt = take_option(args, '--node')
    engine_dir = take_option(args, '--engine-dir')
    if len(args) != 1:
        return usage('serve <dir> [--node P] [--engine-dir DIR]')
    engine = engine_in(engine_dir)
    node = find_node(node_opt)
    if node is None:
        return USAGE
    argv = [str(engine), 'serve', args[0], '--node', node, '--helpers', str(HELPERS)]
    binary = refund_copy()
    if binary:
        argv += ['--refund-binary', binary]
    model = engine.parent / 'checker' / 'model.cjs'
    if model.is_file():
        argv += ['--checker', str(model)]
    exec_(argv)


def cmd_engine(sub, args):
    engine_dir = take_option(args, '--engine-dir')
    exec_([str(engine_in(engine_dir)), sub] + args)


def cmd_cosign(sub, args):
    node_opt = take_option(args, '--node')
    if len(args) != 1:
        return usage('cosign-%s <file> [--node P]' % sub)
    node = find_node(node_opt)
    if node is None:
        return USAGE
    exec_([node, str(HELPERS / 'cosign.cjs'), sub, args[0]])


def cmd_python(script, args, extra=()):
    exec_([sys.executable, str(ROOT / script)] + list(extra) + args)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help'):
        print(__doc__)
        return 0 if args else USAGE
    sub, rest = args[0], args[1:]
    if sub == 'build':
        return cmd_build(rest)
    if sub == 'serve':
        return cmd_serve(rest)
    if sub == 'leases':
        engine_dir = take_option(rest, '--engine-dir')
        if '--sweep' not in rest and len(rest) != 1:
            return usage('leases <dir> [--sweep [--now MS]]')
        return cmd_engine('leases', rest + (['--engine-dir', engine_dir] if engine_dir else []))
    if sub in ('init', 'state', 'replay', 'get', 'cosign-message'):
        return cmd_engine(sub, rest)
    if sub in ('cosign-keygen', 'cosign-sign'):
        return cmd_cosign(sub.split('-', 1)[1], rest)
    if sub == 'diff-policy':
        return cmd_python('src/airlock/py/diff_policy.py', rest)  # its default engine is build/airlock/airlock-engine
    if sub in ('fuzz', 'demo'):
        script = 'src/airlock/py/fuzz.py' if sub == 'fuzz' else 'examples/unbreakable_store/run_demo.py'
        extra = [] if '--engine-dir' in rest else ['--engine-dir', str(BUILD)]
        if '--node' not in rest:
            node = find_node(None)
            if node is None:
                return USAGE
            extra += ['--node', node]
        return cmd_python(script, rest, extra)
    return usage('unknown subcommand %r' % sub)


if __name__ == '__main__':
    sys.exit(main())
